---
interface Props {
  isHome: boolean;
}
const { isHome } = Astro.props;
---

<div class="cst-menu" id="cstMenu">
  <nav class="cst-submenu" id="cstSubmenu">
    <a href="/#cstudios" data-key="cstudios">C-STUDIOS</a>
    <a href="/#services" data-key="services">SERVICES</a>
    <a href="/#clients"  data-key="clients">CLIENTS</a>
    <a href="/#projects" data-key="projects">PROJECTS</a>
    <a href="/#info"     data-key="info">INFO</a>
    <a href="/library/"  data-key="library">LIBRARY</a>
  </nav>
</div>

<style is:global>
html {
  scroll-behavior: smooth;
  /* Stop iOS Safari from auto-inflating font sizes in narrow containers
     (this was what made certain library info-list entries render big). */
  -webkit-text-size-adjust: 100%;
          text-size-adjust: 100%;
}

/* Shared anchor: where the nav menu ends. Sticky section bars (projects/services
   tabs on mobile) pin to this so there's no transparent gap below the nav. */
:root {
  --cst-nav-bottom: 50px;
}

#cstudios, #services, #clients, #projects, #info {
  scroll-margin-top: 80px;
}

  .cst-menu {
    position: fixed;
    left: 20px;
    top: 20px;
    z-index: 9999;
    display: flex;
    align-items: center;
    user-select: none;
    pointer-events: auto;
  }
  .cst-submenu {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .cst-submenu a {
    text-decoration: none;
    font-size: 0.7rem;
    padding: 6px 8px;
    color: lightgrey;
    white-space: nowrap;
    cursor: pointer;
    transition: color .25s ease;
    letter-spacing: 0.05em;
  }
  /* Site-wide interactive state palette — keep these in sync wherever an
     element has inactive / hover / active states (tabs, library buttons,
     footer links, etc.) so the page reads consistently. */
  .cst-submenu a:hover { color: grey; }
  .cst-submenu a.active { color: #0a0a0a; }

  /* mix-blend-mode removed everywhere — it was de-pinning the fixed nav
     on iOS Safari. Visual contrast on dark backgrounds is handled with
     explicit colours instead. */
  body.bg-dark .cst-submenu a { color: lightgrey; }
  body.bg-dark .cst-submenu a:hover { color: grey; }
  body.bg-dark .cst-submenu a.active { color: #fff; }
  body[data-is-home="false"].bg-dark .cst-submenu a { color: lightgrey; }
  body[data-is-home="false"].bg-dark .cst-submenu a:hover { color: grey; }
  body[data-is-home="false"].bg-dark .cst-submenu a.active { color: #0a0a0a; }

  /* Non-home pages on desktop: full-width white strip at the top — same
     treatment as the footer (strip on library, transparent on the home
     hero so the full-bleed image isn't interrupted). Mobile already gets
     a white nav strip via the mobile media query below. Padding-top
     matches the home nav's top: 20px so the content baseline doesn't
     shift between pages. */
  @media (min-width: 769px) {
    body[data-is-home="false"] .cst-menu {
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      padding: 20px 20px 12px;
      background: white;
      box-sizing: border-box;
    }
  }

  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a {
    opacity: 0;
    animation: cst-fade-in 0.5s ease both;
  }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(1) { animation-delay: 4s; }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(2) { animation-delay: 4.3s; }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(3) { animation-delay: 4.6s; }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(4) { animation-delay: 4.9s; }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(5) { animation-delay: 5.2s; }
  body[data-is-home="true"]:not(.skip-intro) .cst-submenu a:nth-child(6) { animation-delay: 5.5s; }
  @keyframes cst-fade-in { to { opacity: 1; } }

/* Soft snap — sections snap into place once the user releases a scroll
   gesture near a boundary, but anchor navigation (e.g. clicking SERVICES
   from /library/) is not forced to land at a snap point. Mandatory snap
   was fighting the cross-page anchor jump and landing at the wrong y. */
html {
  scroll-snap-type: y proximity;
  scroll-padding-top: 0;
}
body > main > section,
body > main > footer,
body > section,
body > footer {
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

@media (max-width: 768px) {
  /* iOS Safari mis-renders `position: fixed` while scroll-snap is active —
     the nav drifts down mid-snap. Turn snap off on mobile; the sections
     are still tall enough to read naturally. */
  html { scroll-snap-type: none; }
  body > main > section,
  body > main > footer,
  body > section,
  body > footer {
    scroll-snap-align: none;
    scroll-snap-stop: normal;
  }

  /* Inset moves into padding so a solid bg can extend to the very top of the
     viewport — no transparent strip above the menu text. */
  :root {
    --cst-nav-bottom: calc(env(safe-area-inset-top, 0px) + 42px);
  }
  /* Both sections snap to viewport top (y=0). Their internal padding-top
     handles nav clearance + the +28 gap so tabs land at cst-nav-bottom + 28,
     matching the library page content. Using padding (not scroll-margin)
     also keeps the 100vh sections from overflowing the viewport. */
  #services, #projects { scroll-margin-top: 0; }
  .cst-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: calc(env(safe-area-inset-top, 0px) + 12px) 12px 12px;
    box-sizing: border-box;
  }
  /* Mobile: no mix-blend at all (iOS Safari mis-positions fixed elements
     that have mix-blend-mode set). Hero gets a transparent nav with
     white text + subtle shadow so it reads over the full-bleed photo;
     every other context gets a solid-white strip with dark text. */
  .cst-menu { mix-blend-mode: normal !important; }
  body[data-is-home="true"].bg-dark .cst-menu {
    background: transparent;
  }
  body[data-is-home="true"].bg-dark .cst-submenu a {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  body[data-is-home="true"].bg-dark .cst-submenu a.active {
    color: #fff;
  }
  /* Everywhere else on mobile (services/clients/projects/info on home,
     library, all other pages): white nav strip with grey-on-light text. */
  body:not([data-is-home="true"].bg-dark) .cst-menu {
    background: white;
  }
  body[data-is-home="false"] .cst-submenu a { color: lightgrey; }
  body[data-is-home="false"] .cst-submenu a.active { color: #0a0a0a; }
  .cst-submenu {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: nowrap;
    width: 100%;
    gap: 0;
  }
  .cst-submenu a {
    font-size: 0.6rem;
    padding: 4px 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  /* Cynthia is desktop-only — hide its nav link on mobile so users
     don't end up on the "view on desktop" stub page. */
  .cst-submenu a[data-key="cynthia"] { display: none; }
}
</style>

<script>
  const IS_HOME = (document.body as HTMLBodyElement).dataset.isHome === 'true';
  // Sections with dark backgrounds (used to flip menu palette for visibility)
  const DARK_SECTIONS = new Set(['cstudios']);

  const submenu = document.getElementById('cstSubmenu')!;
  const links = submenu.querySelectorAll<HTMLAnchorElement>('a');

  // Library page (not homepage) — always dark, and the LIBRARY link is
  // the active one so the other nav links read as the dim/grey default.
  if (!IS_HOME) {
    document.body.classList.add('bg-dark');
    // Highlight whichever non-home page we're on (library or cynthia) so
    // the other nav links read as the dim/grey default.
    const path = location.pathname;
    let activeKey: string | null = null;
    if (path.startsWith('/library')) activeKey = 'library';
    else if (path.startsWith('/cynthia')) activeKey = 'cynthia';
    if (activeKey) {
      submenu.querySelector<HTMLAnchorElement>(`a[data-key="${activeKey}"]`)?.classList.add('active');
    }
  }

  if (IS_HOME) {
    function setActive(idx: number) {
      links.forEach((l, i) => l.classList.toggle('active', i === idx));
      // Toggle dark-bg class based on which section is centered in viewport
      const key = links[idx]?.dataset.key;
      if (key && DARK_SECTIONS.has(key)) {
        document.body.classList.add('bg-dark');
      } else {
        document.body.classList.remove('bg-dark');
      }
    }

    const sections = Array.from(links).map(link => {
      const key = link.dataset.key;
      if (!key || key === 'library') return null;
      return document.getElementById(key);
    });

    let ticking = false;
    function updateActive() {
      const centerY = window.innerHeight / 2;
      let bestIdx = -1, minDist = Infinity;
      sections.forEach((sec, i) => {
        if (!sec) return;
        const r = sec.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - centerY);
        if (d < minDist) { minDist = d; bestIdx = i; }
      });
      if (bestIdx !== -1) setActive(bestIdx);
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(updateActive); }
    }, { passive: true });
    window.addEventListener('resize', updateActive);
    updateActive();
  }

  // Cross-page hash navigation (e.g. clicking SERVICES from /library/) can
  // land at the wrong y because browsers don't reliably apply
  // scroll-margin-top combined with scroll-snap. Force the scroll to the
  // section top in absolute coordinates, then retry after window load so
  // late layout shifts (images, fonts) don't strand the section off-screen.
  if (IS_HOME && location.hash.length > 1) {
    const targetId = location.hash.slice(1);
    function scrollToTarget() {
      const el = document.getElementById(targetId);
      if (!el) return;
      const margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
      const top = Math.max(0, el.getBoundingClientRect().top + window.pageYOffset - margin);
      window.scrollTo({ top, behavior: 'auto' });
    }
    requestAnimationFrame(() => requestAnimationFrame(scrollToTarget));
    window.addEventListener('load', () => {
      scrollToTarget();
      // One more after images settle in case the layout shifted
      setTimeout(scrollToTarget, 100);
    });
  }
</script>