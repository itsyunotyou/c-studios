  /* ════════════════════════════════════════════════════════════ */
  /* INFO — dots animate into letters                               */
  /* ═════════════════/* ════════════════════════════════════════════════════════════ */
/* INFO — Venn layout                                            */
/* ════════════════════════════════════════════════════════════ */
/* ════════════════════════════════════════════════════════════ */
/* INFO — Venn diagram with split-from-one animation             */
/* ════════════════════════════════════════════════════════════ */
.info-section {
  height: 100vh;
  width: 100%;
  background: white;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  box-sizing: border-box;
  overflow: hidden;
}

.info-wrap {
  width: 100%;
  max-width: 1200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

.info-venn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16px;
  width: 100%;
}

/* Side captions are now a 2-column block beneath the venn (not on either
   side of the circles). Keeping the small caption font size for design
   continuity. */
.venn-captions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  width: 100%;
  max-width: 540px;
  margin: 0 auto;
}

.venn-text {
  font-size: 0.5rem;
  line-height: 1.7;
  color: #0a0a0a;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0;
}
.venn-text-left,
.venn-text-right { text-align: left; }

.venn-stage {
  position: relative;
  flex: 0 1 540px;
  width: 100%;
  max-width: min(540px, calc((100vh - 360px) * 1.357));
  aspect-ratio: 456 / 336;
}

.venn-svg {
  width: 100%;
  height: 100%;
  display: block;
}

.venn-circle {
  fill: none;
  stroke: rgba(10, 10, 10, 0.55);
  stroke-width: 1;
}

.venn-label {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #0a0a0a;
  font-weight: 400;
  white-space: nowrap;
  pointer-events: none;
}
.venn-label-left  { left: 3.5%;  }
.venn-label-right { right: 3.5%; }

.venn-c-logo {
  /* SVG <image> respects PNG transparency; no fill needed */
}

.info-body {
  max-width: 700px;
  margin: 0 auto;
  text-align: left;
  position: relative;          /* anchor for the dots overlay */
}

/* Each character is wrapped in <span class="letter"> at run-time; the
   dot animation reveals them one-by-one (typewriter). */
.info-section .letter {
  opacity: 0;
  transition: opacity 1.1s ease;
}
.info-section .letter.reveal { opacity: 1; }

.info-dots-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.info-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 3px;
  height: 3px;
  background: #0a0a0a;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.25s ease, transform 0.3s ease;
}

.info-paragraph {
  font-size: 0.7rem;
  line-height: 1.8;
  color: #0a0a0a;
  font-weight: 400;
  margin: 0 0 1.5em;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-align: left;
}
.info-paragraph:last-child { margin-bottom: 0; }


/* ─── INITIAL STATES (before scroll-in) ─── */

/* Both circles start at the center — overlapping perfectly so they read
   as ONE circle. The single circle fades in AFTER the paragraphs morph
   (delay 2.0s), then splits outward at 2.7s so the user perceives a
   moment of "one circle appears, then divides". */
.venn-circle-left  { transform: translateX(60px);  }   /* shifts cx 340 → visual 400 */
.venn-circle-right { transform: translateX(-60px); }   /* shifts cx 460 → visual 400 */
.venn-circle {
  opacity: 0;
  transition:
    opacity 1.1s ease 1.4s,
    transform 1.2s cubic-bezier(0.76, 0, 0.24, 1) 2.6s;
}

/* Labels start tucked behind each circle's outer rim and slide inward.
   Both fire together (same delay) so STRATEGY and CURATION appear in sync. */
.venn-label-left {
  opacity: 0;
  transform: translateY(-50%) translateX(-32px);
  transition:
    opacity 0.8s ease 4.0s,
    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 4.0s;
}
.venn-label-right {
  opacity: 0;
  transform: translateY(-50%) translateX(32px);
  transition:
    opacity 0.8s ease 4.0s,
    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 4.0s;
}

/* 2-column subtexts beneath the venn — both fade in together. */
.venn-text {
  opacity: 0;
  transform: translateY(8px);
  transition:
    opacity 0.9s ease,
    transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}

/* C logo: last beat, after subtexts land. */
.venn-c-logo {
  opacity: 0;
  transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1) 5.9s;
}


/* ─── IN-VIEW STATES (animated) ─── */

.info-section.in-view .venn-circle-left,
.info-section.in-view .venn-circle-right {
  opacity: 1;
  transform: translateX(0);
}

.info-section.in-view .venn-label-left,
.info-section.in-view .venn-label-right {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

.info-section.in-view .venn-c-logo {
  opacity: 1;
}

.info-section.in-view .venn-text {
  opacity: 1;
  transform: translateY(0);
}
.info-section.in-view .venn-text-left,
.info-section.in-view .venn-text-right { transition-delay: 4.9s; }

/* paragraph-level reveal is handled by per-letter dot animation now */


/* ─── Mobile ─── */
@media (max-width: 768px) {
  .info-section {
    height: 100dvh;
    padding: 48px 20px;
    justify-content: center;
  }
  /* Tighter gap between paragraphs / venn / captions so all three blocks
     fit inside one viewport on mobile without the paragraphs pushing the
     venn off-screen. Mobile collapses the desktop 2-col grid back to a
     single stacked column. */
  .info-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 480px;
  }
  .info-venn {
    flex-direction: column;
    gap: 0;
  }
  /* Mobile subtexts: keep the 2-column block below the venn, same font
     scale as desktop (already small enough to read). */
  .venn-captions {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 100%;
  }
  .venn-stage {
    flex: 0 0 auto;
    width: 100%;
    max-width: 100%;
    align-self: center;
  }
  .venn-label {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }
  .venn-label-left  { left: 6%;  }
  .venn-label-right { right: 6%; }
  .info-paragraph {
    font-size: 0.55rem;
    line-height: 1.6;
    margin-bottom: 0.8em;
  }
}
  /* PROJECTS — tabs + expandable rows                             */
  /* ════════════════════════════════════════════════════════════ */
  .projects-section {
    min-height: 100vh;
    padding: 80px 0 40px;
    background: white;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .projects-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 12px;
    padding: 0 28px;
  }
  .projects-tab {
    background: none;
    border: none;
    padding: 0;
    color: lightgrey;
    cursor: pointer;
    font: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .projects-tab:hover { color: grey; }
  .projects-tab.active { color: #0a0a0a; }

  .projects-panel {
    display: none;
  }
  .projects-panel.active {
    display: block;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .projects-panel.active::-webkit-scrollbar {
    width: 6px;
  }
  .projects-panel.active::-webkit-scrollbar-thumb {
    background: lightgrey;
    border-radius: 3px;
  }

  .projects-empty {
    padding: 0 20px;
    font-size: 0.7rem;
    color: lightgrey;
    font-style: italic;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    /* One full viewport of headroom so EVERY row — including the bottom
       few — has enough room below it for the panel to scroll the row up
       to the panel's content top. 30vh was too small: the last few rows
       hit maxScroll before reaching the top edge. */
    padding-bottom: 100vh;
  }

  .project-row {
    /* Every row carries its own top border so when any row scrolls to
       the panel's content top, the divider is visible above it
       (otherwise the line came from the previous row's bottom border,
       which gets clipped above panel.top when you scroll). */
    border-top: 1px solid #eee;
  }
  .project-row:last-child { border-bottom: 1px solid #eee; }

.project-summary {
  display: grid;
  grid-template-columns: 2fr 0.5fr 3fr;
  gap: 30px;
  width: 100%;
  padding: 18px 28px;
  min-height: 56px;
  align-items: start;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  font: inherit;
  font-size: 0.7rem;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: #0a0a0a;
  transition: background 0.2s ease;
}
  .project-summary:hover { background: #fafafa; }
  .project-title {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .project-year { color: #0a0a0a; }
.project-description {
  color: #0a0a0a;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.project-row.expanded .project-description {
  -webkit-line-clamp: unset;
  display: block;
  overflow: visible;
}
  /* Expandable image strip — full viewport width, slides down on expand */
.project-images {
  display: flex;
  width: 100vw;
  max-height: 0;
  overflow-x: auto;
  overflow-y: hidden;
  gap: 0;
  /* No transition on base — collapse is instant so the auto-close of
     a previously expanded row doesn't keep its height during the new
     row's scroll-into-view measurement. The .expanded rule adds the
     transition for the smooth expand. */
}
.project-row.expanded .project-images {
  transition: max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}

.project-images img {
  height: 50vh;
  width: auto;
  flex-shrink: 0;
  object-fit: cover;
  display: block;
  pointer-events: none;
  user-select: none;

}
@media (max-width: 768px) {
  /* Lock the section to one viewport: tabs sit at the top right under the nav,
     the active panel scrolls internally. Body scroll can't reveal the next
     section while the projects view is in frame. */
  .projects-section {
    height: 100vh;
    min-height: 0;
    overflow: hidden;
    padding: calc(var(--cst-nav-bottom) + 28px) 0 0;
    box-sizing: border-box;
  }
  /* Tabs no longer need sticky — they're naturally pinned by the section's
     padding-top, and the section is fixed-height so they don't drift. */
.projects-tabs {
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
  justify-content: flex-start;
  gap: 0;
