// Align services tabs with SERVICES menu link + compute L branch position
function alignServicesTabs() {
  const link = document.querySelector('[data-key="services"]');
  const tabsEl = document.querySelector('.services-tabs');
  if (!link || !tabsEl) return;
  const rect = link.getBoundingClientRect();
  const styles = getComputedStyle(link);
  const padLeft = parseFloat(styles.paddingLeft) || 0;
  const padRight = parseFloat(styles.paddingRight) || 0;
  const textLeft = rect.left + padLeft;
  const textRight = rect.right - padRight;
  const textCenter = (textLeft + textRight) / 2;
  document.documentElement.style.setProperty('--services-tabs-x', textLeft + 'px');
  document.documentElement.style.setProperty('--services-link-center-x', textCenter + 'px');
}
window.addEventListener('load', alignServicesTabs);
window.addEventListener('resize', alignServicesTabs);
setTimeout(alignServicesTabs, 200);



function initServicesSlideshows() {
  if (window.innerWidth > 768) return;
  document.querySelectorAll('.services-images').forEach(container => {
    if (container.dataset.slideshowInit) return;
    container.dataset.slideshowInit = '1';
    const imgs = container.querySelectorAll('img');
    if (!imgs.length) return;
    if (imgs.length === 1) { imgs[0].classList.add('active'); return; }
    let current = 0;
    imgs[current].classList.add('active');
    setInterval(() => {
      const prev = current;
      current = (current + 1) % imgs.length;
      imgs[current].classList.add('active');
      setTimeout(() => imgs[prev].classList.remove('active'), 600);
    }, 2500);
  });
}

if (document.readyState === 'complete' || document.readyState === 'interactive') {
  initServicesSlideshows();
} else {
  document.addEventListener('DOMContentLoaded', initServicesSlideshows);
}

// ═══════════════════════════ INFO: dots → letters ═══════════════════════════
// Triggers when #info enters the viewport: adds .in-view (drives venn
// animation) AND wraps every glyph in the two info paragraphs in <span
// class="letter">, then floats dots in from random points across the
// section, settles each on its letter's position, and morphs each dot
// into its letter on a staggered timeline.
function setupInfoReveal() {
  const section = document.getElementById('info');
  if (!section) return;
  const infoBody = section.querySelector('.info-body');

  // Pre-wrap each non-space character so target rects are stable before
  // the animation runs. Idempotent via the data-split flag.
  if (infoBody) {
    infoBody.querySelectorAll('p').forEach((p) => {
      if (p.dataset.split === 'true') return;
      const text = p.textContent || '';
      p.textContent = '';
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (ch === ' ' || ch === '\n') {
          p.appendChild(document.createTextNode(ch));
        } else {
          const span = document.createElement('span');
          span.className = 'letter';
          span.textContent = ch;
          p.appendChild(span);
        }
      }
      p.dataset.split = 'true';
    });
  }

  let triggered = false;

  function runDotAnimation() {
    if (triggered || !infoBody) return;
    triggered = true;

    // Pre-create the dots layer now so the later DOM mutation doesn't
    // shift the venn diagram during the animation.
    const dotsLayer = document.createElement('div');
    dotsLayer.className = 'info-dots-layer';
    infoBody.appendChild(dotsLayer);

    requestAnimationFrame(() => requestAnimationFrame(() => {
      const letters = Array.from(infoBody.querySelectorAll('.letter'));
      if (!letters.length) return;
      const bodyRect = infoBody.getBoundingClientRect();

      // Phase 1 — GATHER: dots are placed at random positions scattered
      // across the viewport, fully visible, then transition into their
      // target letter positions in unison (one beat of motion).
      // Phase 2 — MORPH (t = GATHER_MS): every dot fades out at once and
      // every letter reveals at once. This phase fires simultaneously
      // with the venn circle split (CSS delay matches GATHER_MS).
      const GATHER_MS = 1400;   // duration of the gather motion
      const MORPH_MS  = 1100;   // duration of the dot→letter cross-fade
                                // (matches the .letter opacity transition
                                // below for a soft, drawn-out hand-off)

      const dots = letters.map((letter) => {
        const lr = letter.getBoundingClientRect();
        const targetX = (lr.left + lr.width / 2) - bodyRect.left - 1.5;
        const targetY = (lr.top + lr.height * 0.55) - bodyRect.top - 1.5;
        // Scatter start: any point across the viewport, translated into
        // info-body's local coordinate space.
        const startX = Math.random() * window.innerWidth  - bodyRect.left;
        const startY = Math.random() * window.innerHeight - bodyRect.top;
        const dot = document.createElement('div');
        dot.className = 'info-dot';
        dot.style.transition = 'none';
        dot.style.transform = `translate(${startX}px, ${startY}px)`;
        dot.style.opacity = '1';
        dotsLayer.appendChild(dot);
        return { letter, dot, targetX, targetY };
      });

      void dotsLayer.offsetWidth; // commit scatter start state

      // Phase 1 — kick off the gather. All dots move to their target
      // letter positions in parallel.
      requestAnimationFrame(() => {
        dots.forEach((d) => {
          d.dot.style.transition = `transform ${GATHER_MS}ms cubic-bezier(0.22, 1, 0.36, 1)`;
          d.dot.style.transform = `translate(${d.targetX}px, ${d.targetY}px)`;
        });

        // Phase 2 — morph: fade every dot and reveal every letter at
        // the same instant.
        setTimeout(() => {
          dots.forEach((d) => {
            d.dot.style.transition = `opacity ${MORPH_MS}ms ease`;
            d.dot.style.opacity = '0';
            d.letter.classList.add('reveal');
          });
        }, GATHER_MS);
      });
    }));
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        section.classList.add('in-view');
        runDotAnimation();
        io.disconnect();
      }
    });
  }, { root: null, threshold: 0.2 });
  io.observe(section);
}

// Refresh the --tab-i CSS var on every non-active tab in a strip so the
// open mobile dropdown stacks them at consecutive 100% offsets below the
// active one. Call after any active-class swap.
function refreshTabIndices(tabsEl) {
  if (!tabsEl) return;
  let n = 0;
  tabsEl.querySelectorAll(':scope > button').forEach((t) => {
    if (t.classList.contains('active')) {
      t.style.removeProperty('--tab-i');
    } else {
      n += 1;
      t.style.setProperty('--tab-i', n);
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  setupInfoReveal();
  alignServicesTabs();
  // Initial pass so the dropdown stack positions are correct on load.
  document.querySelectorAll('.services-tabs, .projects-tabs').forEach(refreshTabIndices);
  // Close mobile tab dropdowns when tapping outside them
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.services-tabs.open, .projects-tabs.open').forEach((el) => {
      if (!el.contains(e.target)) el.classList.remove('open');
    });
  });
  const sTabs = document.querySelectorAll('.services-tab');
  const sPanels = document.querySelectorAll('.services-panel');
  sTabs.forEach((tab) => {
    tab.onclick = () => {
      const tabsEl = tab.parentElement;
      // Mobile dropdown: first tap opens menu without switching.
      if (window.innerWidth <= 768) {
        if (!tabsEl.classList.contains('open')) {
          tabsEl.classList.add('open');
          return;
        }
        tabsEl.classList.remove('open');
      }
      const target = tab.getAttribute('data-target');
      const currentPanel = document.querySelector('.services-panel.active');
      const newPanel = document.querySelector(`.services-panel[data-tab="${target}"]`);

      if (!newPanel || currentPanel === newPanel) return;

      // Determine direction based on tab order: new to the RIGHT → slide everything LEFT
      const allPanels = Array.from(sPanels);
      const newIdx = allPanels.indexOf(newPanel);
      const currentIdx = currentPanel ? allPanels.indexOf(currentPanel) : -1;
      const movingRight = newIdx > currentIdx;   // clicking a tab to the right

      // Tab button highlights
      sTabs.forEach((t) => t.classList.toggle('active', t === tab));
      refreshTabIndices(tabsEl);

      // Clean up any lingering states on unrelated panels
      allPanels.forEach((p) => {
        if (p !== currentPanel && p !== newPanel) {
          p.classList.remove('active', 'exit-left', 'exit-right', 'enter-from-left', 'enter-from-right');
        }
      });

      if (currentPanel) {
        currentPanel.classList.remove('active');
        // Old panel exits in the direction matching the navigation
        currentPanel.classList.add(movingRight ? 'exit-left' : 'exit-right');

        // After the slide completes, park it (invisibly) back to default off-screen-right
        setTimeout(() => {
          const panel = currentPanel;
          panel.classList.add('no-transition');
          panel.classList.remove('exit-left', 'exit-right');
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              panel.classList.remove('no-transition');
            });
          });
        }, 1050);
      }

      // Position the new panel on the correct side BEFORE animating it to center
      newPanel.classList.remove('exit-left', 'exit-right');
      newPanel.classList.add('no-transition');
      newPanel.classList.add(movingRight ? 'enter-from-right' : 'enter-from-left');
      void newPanel.offsetWidth;   // force the browser to apply the starting position

      // Trigger the entrance animation
      newPanel.classList.remove('no-transition', 'enter-from-right', 'enter-from-left');
      newPanel.classList.add('active');
    };
  });

  // L-branch animation: trigger when SERVICES section comes into view
  const servicesSection = document.getElementById('services');
  const tabsEl = document.querySelector('.services-tabs');
  if (servicesSection && tabsEl) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
          // Force restart by removing then re-adding the class
          tabsEl.classList.remove('l-drawn');
          void tabsEl.offsetWidth;
          tabsEl.classList.add('l-drawn');
        } else if (!entry.isIntersecting) {
          tabsEl.classList.remove('l-drawn');
        }
      });
    }, { threshold: [0, 0.5, 1] });
    obs.observe(servicesSection);
  }
});

// ════════════════════════════════════════════════════════════
// Reusable custom scrubber
// Usage: <div data-scrubber>...</div>  (defaults to horizontal)
//        <div data-scrubber="vertical">...</div>
// ════════════════════════════════════════════════════════════
function initScrubber(el) {
  if (el.dataset.scrubberInit) return;
  el.dataset.scrubberInit = '1';

  const vertical = el.dataset.scrubber === 'vertical';

  // Create scrubber DOM and inject right after the element
  const scrubber = document.createElement('div');
  scrubber.className = 'scrubber' + (vertical ? ' scrubber-v' : ' scrubber-h');
  scrubber.innerHTML = '<div class="scrubber-track"><div class="scrubber-dot"></div></div>';
  el.parentNode.insertBefore(scrubber, el.nextSibling);

  const track = scrubber.querySelector('.scrubber-track');
  const dot = scrubber.querySelector('.scrubber-dot');

  function update() {
    if (vertical) {
      const max = el.scrollHeight - el.clientHeight;
      if (max <= 0) { scrubber.classList.add('scrubber-hidden'); return; }
      scrubber.classList.remove('scrubber-hidden');
      dot.style.top = ((el.scrollTop / max) * 100) + '%';
    } else {
      const max = el.scrollWidth - el.clientWidth;
      if (max <= 0) { scrubber.classList.add('scrubber-hidden'); return; }
      scrubber.classList.remove('scrubber-hidden');
      dot.style.left = ((el.scrollLeft / max) * 100) + '%';
    }
  }

  el.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update, { passive: true });
  // Re-check after CSS animations
  setTimeout(update, 100);
  setTimeout(update, 700);

  // Drag the dot to scroll
  let dragging = false;
  function setFromPointer(x, y) {
    const r = track.getBoundingClientRect();
    if (vertical) {
      const pct = Math.max(0, Math.min(1, (y - r.top) / r.height));
      el.scrollTop = pct * (el.scrollHeight - el.clientHeight);
    } else {
      const pct = Math.max(0, Math.min(1, (x - r.left) / r.width));
      el.scrollLeft = pct * (el.scrollWidth - el.clientWidth);
    }
  }
  track.addEventListener('mousedown', (e) => {
    dragging = true;
    setFromPointer(e.clientX, e.clientY);
    e.preventDefault();
  });
  window.addEventListener('mousemove', (e) => {
    if (dragging) setFromPointer(e.clientX, e.clientY);
  });
  window.addEventListener('mouseup', () => { dragging = false; });
}

function initAllScrubbers() {
  document.querySelectorAll('[data-scrubber]').forEach(initScrubber);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initAllScrubbers);
} else {
  initAllScrubbers();
}
</script>