---

import Layout from '../layouts/Layout.astro';
import libraryText from '../data/library-text.json';
import libraryImage from '../data/library-image.json';
import librarySound from '../data/library-sound.json';

const allEntries = [
  ...libraryText,
  ...libraryImage,
  ...librarySound,
];

// Dedupe by normalized title+author+year (strips punctuation, case, whitespace)
const norm = (v) => String(v ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const seen = new Set();
const deduped = allEntries.filter((entry) => {
  const key = norm(entry.title) + '|' + norm(entry.author) + '|' + norm(entry.year);
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});

console.log(`[Library] ${allEntries.length} entries → ${deduped.length} unique (${allEntries.length - deduped.length} duplicates removed)`);

// Transform entries into the shape the cylinder code expects.
const references = deduped.map((entry) => ({
  title: entry.title,
  artist: entry.author || '',
  year: entry.year || '',
  cat: entry.category || 'text',
  addedBy: entry.by || '',
  color: entry.color || [128, 128, 128], // default grey; run compute-colors.mjs later for proper colors
  img: entry.image ? entry.image.replace(/\.[^.]+$/, '-thumb.webp') : '',
  imgLarge: entry.image ? entry.image.replace(/\.[^.]+$/, '-large.webp') : '',
  imgFull: entry.image || '',
  images: [],
  imagesFull: [],
  imageTitles: [],
}));

const referencesJSON = JSON.stringify(references);

---

<Layout title="C-STUDIOS — Library">
  <div class="library-root">

<div id="header">
  <!-- Left: info panel always visible -->
  <div id="header-left">
    <div id="info-panel"></div>
  </div>
  <!-- Right: filter dropdown + size toggle -->
  <div id="header-right">
    <!-- Cylinder nav (hidden in row view) -->
    <div id="cyl-nav" style="display:flex;flex-direction:row;gap:14px;align-items:center;">
      <div class="hdr-dropdown" id="sort-drop">
        <button class="hdr-btn" id="sort-btn">
          <span id="sort-label">Colour</span>
        </button>
        <div class="hdr-menu" id="sort-menu">
          <button class="active" data-sort="color">Colour</button>
          <button data-sort="addedBy">Added by</button>
          <button data-sort="year">Year</button>
        </div>
      </div>
      <div class="hdr-dropdown" id="filter-drop">
        <button class="hdr-btn" id="filter-btn">
          <span id="filter-label">All</span>
        </button>
        <div class="hdr-menu" id="filter-menu">
          <button class="active" data-filter="all">All</button>
          <button data-filter="Image">Image</button>
          <button data-filter="Sound">Sound</button>
          <button data-filter="Text">Text</button>
        </div>
      </div>
    </div>
    <!-- Back button (shown in row view) -->
    <button id="back-btn" title="Return to grid">
      <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
        <rect x="1" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="9" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="1" y="9" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="9" y="9" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </button>
  </div>
  <!-- keep these for JS compatibility -->
  <div id="header-info" style="display:none"></div>
  <div id="threads" style="display:none">
    <button class="thread-btn active" data-filter="all">All</button>
    <button class="thread-btn" data-filter="Image">Image</button>
    <button class="thread-btn" data-filter="Sound">Sound</button>
    <button class="thread-btn" data-filter="Text">Text</button>
  </div>
</div>

<div id="scrubber-wrap">
  <div id="scrubber"><div id="scrubber-track"><div id="scrubber-dot"></div></div></div>
</div>

<canvas id="bg-canvas"></canvas>
<canvas id="grid-canvas"></canvas>

<div id="thumb-strip"></div>
<div id="card-stack"></div>

<div id="detail">
  <div id="detail-img-wrap">
    <img id="detail-img" src="" alt="">
  </div>
</div>

<!-- Pile overlay for multi-image refs -->
<div id="pile-overlay" hidden>
  <div id="pile-close">✕ close</div>
  <div id="pile-counter"></div>
  <div id="pile-stack"></div>
</div>



  </div>
</Layout>

<style is:global>
  /* Library page only — these styles are scoped via .library-root */
  body[data-is-home="false"]:has(.library-root) {
    overflow: hidden;
    cursor: crosshair;
  }
  
  * { margin:0;padding:0;box-sizing:border-box; }
  :root { --red:#C8001A;--black:#0a0a0a;--white:#ffffff;--grey:#555;--gap:3px; }
  html,body { width:100%;height:100%;background:var(--white);overflow:hidden;cursor:crosshair;color:var(--black); }

  /* ── HEADER ── */
  #header {
    position:fixed;top:0;left:0;right:0;z-index:200;
    display:flex;align-items:baseline;justify-content:space-between;
    padding:18px 28px;pointer-events:none;
  }
  #header-left { display:flex;align-items:baseline;pointer-events:all; }
  #header-right { display:flex;flex-direction:row;gap:14px;align-items:baseline;pointer-events:all; }

  /* Info panel — top left, always visible, labels always shown.
     Row rhythm = font * line-height. No row gap so it matches the
     dropdown items below (no extra `gap` margin between rows). */
  #info-panel {
    pointer-events:none;
    display:grid;grid-template-columns:auto auto;gap:0 12px;
    line-height:1.7;
  }
  .info-row { display:contents; }
  .info-label {
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;text-transform:uppercase;
    line-height:1.7;
    color:#bbb;white-space:nowrap;
  }
  .info-value {
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;
    line-height:1.7;
    color:var(--black);white-space:nowrap;
  }
  #info-panel.show { opacity:1; } /* kept for JS compat */

  /* Filter dropdown — right side; follows the services/projects design
     system (label + `+` indicator that rotates 45deg into × when open). */
  .hdr-dropdown { position:relative;display:inline-block; }
  .hdr-btn {
    font-family:inherit;
    font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;
    line-height:1.7;
    color:var(--black);
    background:none;border:none;cursor:crosshair;padding:0;
    display:inline-flex;align-items:center;gap:10px;
  }
  .hdr-btn::before {
    content:'';
    display:inline-block;
    width:12px;
    height:12px;
    flex-shrink:0;
    background-color:currentColor;
    -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
            mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
    transition:transform 0.2s ease;
  }
  .hdr-dropdown:hover .hdr-btn::before,
  .hdr-dropdown.open .hdr-btn::before { transform:rotate(45deg); }
  .hdr-btn:hover { color:grey; }
  .hdr-menu {
    display:none;position:absolute;top:100%;right:0;margin-top:0;
    background:var(--white);min-width:70px;z-index:500;padding:0;
  }
  .hdr-menu::before {
    content:'';position:absolute;top:-6px;left:0;right:0;height:6px;
  }
  .hdr-dropdown:hover .hdr-menu,
  .hdr-dropdown.open .hdr-menu { display:block; }
  .hdr-menu button {
    display:block;width:100%;text-align:right;padding:0;
    font-family:inherit;
    font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;
    line-height:1.7;
    color:lightgrey;background:none;border:none;cursor:crosshair;
  }
  .hdr-menu button:hover { color:grey; }
  .hdr-menu button.active { display:none; }
  #header-info { display:none; }
  #threads { display:none; }

  /* ── ROW-VIEW SEARCH ──
     A small magnifier sits on the TITLE and CREATOR rows of the info panel,
     rendered only in the expanded row view. Clicking one lines the whole row
     up A–Z on that field and opens a minimal underbar; typing walks you to
     the first match. Nothing is ever removed from the row.
     The panel is built once and only its text is updated on each step, so the
     open input keeps its focus and caret while typing walks the row. */
  .info-search-icon {
    background:none;border:none;padding:0;margin-left:6px;
    cursor:crosshair;color:#ddd;pointer-events:auto;
    display:inline-flex;align-items:center;justify-content:center;
    width:11px;height:11px;flex:0 0 auto;vertical-align:middle;
    transition:color .15s;
  }
  .info-search-icon:hover { color:var(--black); }
  .info-search-icon.active { color:var(--black); }
  .info-search-icon svg { width:10px;height:10px;display:block; }

  /* Icons only exist in the row view. */
  #info-panel:not(.row-view) .info-search-icon { display:none; }

  /* Underbar — lives INSIDE the value cell of the row being searched, so the
     typed text sits exactly where that row's value text sits. `font:inherit`
     pulls the value's own size/leading, which is what keeps them aligned. */
  /* The input is transparent and sits ON TOP of a grey "ghost" showing the
     centred card's value. The ghost's leading span holds the characters you've
     typed but is hidden — it only reserves the exact advance width, so the
     black text in the input lands precisely over it and the untyped remainder
     trails off in grey. Same font on both, so they can't drift apart. */
  /* The ghost and the input MUST render with identical glyph advances, or the
     grey remainder starts at the wrong x. Three things break that on mobile:
       1. iOS text-size-adjust / Android font-boosting inflate text inside block
          containers (.iv-field) but never inside form controls (.iv-input).
       2. iOS gives inputs an intrinsic inner inset that padding:0 can't clear;
          only appearance:none removes it.
       3. Ligatures/kerning may be applied to a span but not to an input.
     Pinning all three keeps the two layers locked together. */
  #info-panel { -webkit-text-size-adjust:100%;text-size-adjust:100%; }
  .iv-ghost, .iv-input {
    font-variant-ligatures:none;font-kerning:none;
  }

  .iv-field { position:relative;display:none;width:100%;max-width:220px; }
  .info-row.searching .iv-text { display:none; }
  .info-row.searching .iv-field { display:block; }

  .iv-ghost {
    position:absolute;left:0;top:0;right:0;
    font:inherit;letter-spacing:inherit;line-height:inherit;
    white-space:pre;overflow:hidden;
    pointer-events:none;user-select:none;
  }
  .iv-ghost-typed { visibility:hidden; }   /* spacer only */
  .iv-ghost-rest  { color:#ddd; }

  .iv-input {
    position:relative;z-index:1;display:block;
    -webkit-appearance:none;appearance:none;      /* removes iOS inner inset */
    font:inherit;
    font-family:inherit;font-size:inherit;font-weight:inherit;font-style:inherit;
    letter-spacing:inherit;line-height:inherit;
    color:var(--black);background:transparent;
    border:none;border-bottom:1px solid var(--black);
    border-radius:0;box-shadow:none;text-indent:0;
    padding:0;margin:0;
    width:100%;min-width:0;box-sizing:border-box;
    outline:none;pointer-events:auto;
    transition:border-bottom-color .18s ease;
  }
  /* Committing: the underline fades out alongside the icon, which already
     transitions its colour. Both settle together rather than one snapping. */
  .info-row.settling .iv-input { border-bottom-color:transparent; }
  .info-row.no-match .iv-input { border-bottom-color:var(--red);color:var(--red); }

  /* Layout hardening: the info panel is a grid whose value column is 1fr, so
     it will otherwise eat the whole flex row. */
  #header-left { min-width:0; flex-wrap:wrap; }
  #info-panel { flex:0 1 auto; min-width:0; }

  /* ── CANVASES ── */
  #bg-canvas,#grid-canvas {
    position:fixed;top:0;left:0;width:100%;height:100%;
  }
  #bg-canvas { z-index:0; }
  #grid-canvas { z-index:2; }

  /* ── DETAIL ── */
  #detail { position:fixed;top:0;left:0;right:0;bottom:0;z-index:200;pointer-events:none; }
  #detail-img-wrap { position:absolute;opacity:0;overflow:hidden;will-change:width,height,left,top; }
  #detail-img { display:block;width:100%;height:100%;object-fit:cover; }

  #back-btn {
    background:none;border:none;cursor:crosshair;
    color:var(--grey);padding:0;
    display:none;align-items:center;justify-content:center;
    transition:color .15s;
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;text-transform:uppercase;
    gap:6px;
  }
  #back-btn.show { display:flex; }
  #back-btn:hover { color:var(--black); }
  #back-btn svg { width:14px;height:14px; }

  #scrubber-wrap {
    position:fixed;bottom:48px;left:0;right:0;z-index:400;
    display:none;pointer-events:all;cursor:crosshair;
    height:20px;padding:0;
  }
  /* Web: lift scrubber clear of the white footer strip that sits at the
     viewport bottom on non-home pages. */
  @media (min-width: 769px) {
    #scrubber-wrap { bottom: 88px; }
  }
  #scrubber-wrap.show { display:block; }
  #scrubber {
    width:100%;height:100%;
    display:flex;align-items:center;padding:0;
    transform:scaleX(0);transform-origin:left;
  }
  #scrubber.show { display:flex; }
  #scrubber-track { position:relative;width:100%;height:1px;background:var(--grey); }
  #scrubber-dot {
    position:absolute;top:50%;transform:translate(-50%,-50%);
    width:8px;height:8px;border-radius:0;background:#0a0a0a;cursor:crosshair;
  }

  /* ── THUMBNAIL STRIP ── */
  #thumb-strip {
    position:fixed;z-index:250;
    display:none;gap:6px;
    align-items:center;justify-content:center;
    pointer-events:all;
  }
  #thumb-strip.show { display:flex; }
  .thumb-item {
    width:44px;height:44px;cursor:crosshair;
    overflow:hidden;opacity:0.45;transition:opacity .15s;flex-shrink:0;
  }
  .thumb-item.active { opacity:1;outline:1px solid rgba(0,0,0,0.25); }
  .thumb-item:hover { opacity:0.8; }
  .thumb-item img,.thumb-item div { width:100%;height:100%;object-fit:cover;display:block; }
  #card-stack {
    position:fixed;top:0;left:0;right:0;bottom:0;z-index:3;
    pointer-events:none;display:none;
  }
  #card-stack.active { display:block;pointer-events:all; }
  .stack-card { position:absolute;background:transparent;cursor:crosshair; }


  /* ── GRID SIZE TOGGLE ── */
  #grid-sizer { display:none; }
  .gs-btn {
    background:none;border:none;cursor:crosshair;padding:0;
    color:var(--grey);opacity:0.45;transition:opacity .15s;
    display:flex;align-items:center;justify-content:center;
  }
  .gs-btn:hover { opacity:0.8; }
  .gs-btn.active { opacity:1; }

  /* ── WORDPRESS NAV SPACING ──
     The library is full-screen fixed-position. When embedded in an Elementor
     HTML widget on a WordPress page, this CSS leaves space at the top so the
     site's main nav appears above the library instead of being overlaid.
     Adjust --nav-h to match your actual nav height (inspect in DevTools first).
  */
  :root { --nav-h: 60px; }
  #header, #bg-canvas, #grid-canvas, #thumb-strip {
    top: var(--nav-h) !important;
  }
  #bg-canvas, #grid-canvas {
    height: calc(100% - var(--nav-h)) !important;
  }


.hdr-btn, .hdr-menu button{
  font-size: 0.7rem;
    letter-spacing: 0.05em;
}

@media (max-width: 767px) {
  #header {
    padding: 0;
    pointer-events: none;
  }

  /* Info panel — same vertical level as the filter button on the right.
     Reserve room on the right so the values never run into the ALL+ button. */
  #header-left {
    position: fixed;
    top: calc(var(--cst-nav-bottom) + 28px);
    left: 12px;
    right: 100px;
    z-index: 100;
    pointer-events: auto;
    justify-content: flex-start;
  }

  #info-panel {
    display: grid;
    grid-template-columns: auto 1fr;
    /* Always reserve 2 lines per row whether the value wraps or not,
       so CREATOR / YEAR / ADDED BY don't shift down when a long TITLE
       wraps onto two lines. Cells are vertically centred so a 1-line
       value still baselines with the matching dropdown item.
       Rem-based so the row height computes the same as the dropdown
       items (em on the panel resolves to its inherited 16px, not the
       0.6rem cell font, which used to be the mismatch). */
    grid-auto-rows: 1.8rem;
    gap: 0 12px;
    padding: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-radius: 0;
    width: auto;
    max-width: 100%;
  }

  #info-panel .info-row:last-child {
    display: none;
  }

  /* Match the .hdr-btn / .hdr-menu button size + line-height so each
     info row baselines with the corresponding dropdown row. */
  #info-panel .info-label,
  #info-panel .info-value {
    font-size: 0.6rem;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* Long values wrap onto multiple lines within the row rather than
     overlapping the ALL+ button. Both label and value are vertically
     centred in the 3.4em cell so 1-line values sit on the same y as
     the dropdown item next to them. */
  #info-panel .info-value {
    white-space: normal;
    overflow-wrap: anywhere;
    min-width: 0;
    align-self: start;
  }
  #info-panel .info-label { align-self: start; }

  /* Dropdown menu items and the ALL button render as 1.8rem slots so
     each one baselines with one info-panel row (TITLE / CREATOR /
     YEAR / ADDED BY). Content is top-aligned so the dropdown text
     starts at the same y as the info-panel labels (which use
     align-self: start in their grid cells). */
  .hdr-btn,
  .hdr-menu button {
    line-height: 1.2;
    padding: 0;
    min-height: 1.8rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  .hdr-btn { gap: 10px; }

  /* Filter dropdown — same vertical anchor as #header-left so the ALL+
     button baselines with TITLE, and the dropdown items (when open)
     fall on the same y as the rest of the info rows. */
  #header-right {
    position: fixed;
    top: calc(var(--cst-nav-bottom) + 28px);
    right: 12px;
    z-index: 100;
    min-height: 6.8em;
  }

  .hdr-btn,
  .hdr-menu button {
    font-size: 0.6rem;
    letter-spacing: 0;
  }

  #bg-canvas,
  #grid-canvas {
    height: calc(100vh - 100px) !important;
  }
}

#info-panel .info-row:last-child {
  display: none;
}
  @media (min-width: 768px) {
    .info-label,
    .info-value {
      font-size: 0.7rem;
      letter-spacing: 0.05em;
    }
  }


  /* Pile overlay for multi-image refs */
  #pile-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    pointer-events: all;
    cursor: crosshair;
  }
  #pile-overlay[hidden] { display: none; }
  #pile-overlay.open {
    background: rgba(255, 255, 255, 0.92);
  }
  #pile-close {
    position: absolute;
    top: 20px;
    left: 28px;
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--grey);
    cursor: crosshair;
    z-index: 2;
  }
  #pile-counter {
    position: absolute;
    top: 20px;
    right: 28px;
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--grey);
  }
  #pile-stack {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Stacked cards inside the pile use CSS custom props set from JS */
  .pile-card {
    position: absolute;
    width: min(55vw, 420px);
    aspect-ratio: 1;
    cursor: crosshair;
    transform: rotate(var(--rot, 0deg)) scale(var(--scale, 1)) translateY(var(--ty, 0px));
    transition: transform 0.3s ease;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    background: #eee;
    overflow: hidden;
    z-index: var(--z, 1);
  }
  .pile-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script is:inline define:vars={{ referencesJSON }}>
  // Inject references data
  const REFS = JSON.parse(referencesJSON);
// ── CANVAS ────────────────────────────────────────────────────────────────────
const bgCvs = document.getElementById('bg-canvas');
const bgCtx = bgCvs.getContext('2d');
const cvs   = document.getElementById('grid-canvas');
const ctx   = cvs.getContext('2d');

let W, H;
let tiles=[], particles=[], floaters=[];
let state='grid';
let gridScrollY=0, gridScrollMax=0;
let animFrame, phase=0, revealPhase=0;
let activeFilter='all', activeSort='color';
let sortedRefs=[], currentRefIdx=0, selectedRef=null;

const imgCache=new Map();
// Single reusable offscreen canvas for pixel dissolve
const _oc=document.createElement('canvas');
const _oc2=_oc.getContext('2d');
// ── Multi-image support ───────────────────────────────────────────────────────
const imgCacheExtra=new Map();
function getImgAt(ref, idx){
  if(idx===0) return getImg(ref); // main image
  const imgs=ref.images;
  if(!imgs||!imgs[idx-1]) return getImg(ref); // fallback
  const key=ref.title+':'+idx;
  if(imgCacheExtra.has(key)) return imgCacheExtra.get(key);
  const im=new window.Image(); im.src=imgs[idx-1];
  imgCacheExtra.set(key,im); return im;
}
function imgCount(ref){ return 1+(ref.images?ref.images.length:0); }

// LRU-evicting image cache — caps memory at 1000-entry scale.
const IMG_CACHE_MAX=200;
function getImg(ref){
  if(!ref||!ref.img)return null;
  if(imgCache.has(ref)){
    const im=imgCache.get(ref);
    // refresh LRU position
    imgCache.delete(ref); imgCache.set(ref,im);
    return im;
  }
  // evict oldest entry if at cap
  if(imgCache.size>=IMG_CACHE_MAX){
    imgCache.delete(imgCache.keys().next().value);
  }
  const im=new window.Image(); im.src=ref.img;
  imgCache.set(ref,im); return im;
}

// Larger variant used only by the coverflow / row view. Lazy-loaded per ref —
// the cylinder never touches this, so its preload stays small.
const largeCache=new Map();
function getLargeImg(ref){
  if(!ref||!ref.imgLarge) return getImg(ref);
  if(largeCache.has(ref)) return largeCache.get(ref);
  const im=new window.Image(); im.src=ref.imgLarge;
  largeCache.set(ref,im); return im;
}
function preloadImages(){ REFS.forEach(r=>{ getImg(r); if(r.images) r.images.forEach((_,i)=>getImgAt(r,i)); }); }

// Flicker state per tile: which image index showing
const flickerIdx=new Map();
let flickerT=0;
const FLICKER_INTERVAL=90; // frames between flicks

function getFlickerImg(ref){
  const n=imgCount(ref);
  if(n<=1) return getImg(ref);
  let idx=flickerIdx.get(ref)||0;
  return getImgAt(ref,idx);
}

// Larger version for the row/coverflow view. Single-image refs get the
// 800w -large.webp; multi-image refs stay on the cycling thumbs since
// they swap too fast for the larger load to be worth it.
function getFlickerImgLarge(ref){
  const n=imgCount(ref);
  if(n<=1) return getLargeImg(ref);
  let idx=flickerIdx.get(ref)||0;
  return getImgAt(ref,idx);
}

function tickFlicker(){
  flickerT++;
  if(flickerT%FLICKER_INTERVAL===0){
    for(const t of tiles){
      const n=imgCount(t.ref);
      if(n>1){
        const cur=flickerIdx.get(t.ref)||0;
        flickerIdx.set(t.ref,(cur+1)%n);
      }
    }
  }
}

function drawRef(ref,x,y,w,h,alpha,imgOverride){
  if(alpha<=0)return;
  const im=imgOverride||getImg(ref);
  ctx.save(); ctx.globalAlpha=alpha;
  if(im&&im.complete&&im.naturalWidth>0){
    // Crop to fill — centre crop, no squash
    const iw=im.naturalWidth, ih=im.naturalHeight;
    const scale=Math.max(w/iw, h/ih);
    const sw=w/scale, sh=h/scale;
    const sx=(iw-sw)/2, sy=(ih-sh)/2;
    ctx.drawImage(im, sx, sy, sw, sh, x, y, w, h);
  } else {
    ctx.fillStyle=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
    ctx.fillRect(x,y,w,h);
  }
  ctx.restore();
}

let cfScrollX=0, cfScrollVel=0;
let cfDragging=false, cfDragX=0;
function getCF(){ const sz=Math.min(220,W*0.24,H*0.34); return{sz,spread:sz*0.78,cx:W/2,cy:H/2}; }
function cfPos(off){ const{sz,spread,cx,cy}=getCF(); return{x:cx-sz/2+off*spread+cfScrollX,y:cy-sz/2,sz}; }

function hue(r,g,b){
  r/=255;g/=255;b/=255;
  const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;
  if(!d)return 0;
  let h;
  if(mx===r)h=((g-b)/d+6)%6; else if(mx===g)h=(b-r)/d+2; else h=(r-g)/d+4;
  return h/6;
}
// Pull the leading year out of messy values: "1970–80" → 1970, "c. 1970" → 1970.
// Blank / undated entries return Infinity so they fall to the end of a year sort.
function yearVal(y){
  const m=String(y??'').match(/\d+/);
  return m?parseInt(m[0],10):Infinity;
}
function sortRefs(src){
  const s=[...src];
  if(activeSort==='color')  return s.sort((a,b)=>hue(...a.color)-hue(...b.color));
  if(activeSort==='year')   return s.sort((a,b)=>yearVal(a.year)-yearVal(b.year)||a.title.localeCompare(b.title));
  if(activeSort==='addedBy') return s.sort((a,b)=>{
    const aa=(a.addedBy||'').trim(), bb=(b.addedBy||'').trim();
    if(!aa&&!bb) return a.title.localeCompare(b.title);
    if(!aa) return 1;            // blank "added by" sorts last
    if(!bb) return -1;
    return aa.localeCompare(bb,undefined,{sensitivity:'base'})||a.title.localeCompare(b.title);
  });
  return s.sort((a,b)=>a.title.localeCompare(b.title));
}

const GAP=3;
const HEADER_H = window.innerWidth <= 767 ? 150 : 72;
const FOOTER_H = window.innerWidth <= 767 ? 160 : 110;
const GRID_H=()=>H-HEADER_H-FOOTER_H; // usable height for cylinder
let popInStart=null;
const POP_DURATION=600; // ms per tile fade in
const POP_STAGGER=40;  // ms between tiles

let gridSize='large';
function getGridRows(){
  return window.innerWidth <= 767 ? 4 : 6;
}

function buildGrid(){
  const src=activeFilter==='all'?REFS:REFS.filter(r=>(r.cat||'').toLowerCase()===activeFilter.toLowerCase());
  sortedRefs=sortRefs(src);
  const N=sortedRefs.length;
  const ROWS=getGridRows();
  const TILE=Math.floor(GRID_H()/ROWS);
  const totalW=Math.ceil(N/ROWS)*TILE;
  tiles=sortedRefs.map((ref,i)=>({ref,
    x:Math.floor(i/ROWS)*TILE+GAP/2, y:HEADER_H+(i%ROWS)*TILE+GAP/2,
       sz:TILE-GAP, tw:TILE-GAP, th:TILE-GAP, color:ref.color,
    popDelay:Math.random()*2500})); // random stagger up to 2.5s — wider for clear sequential reveal
  gridScrollMax=Math.max(0, totalW-W);
  gridScrollY=0;
  popInStart=performance.now();
  cylPopStart=performance.now();   // trigger cylinder pop-in animation (incl. initial load)
}

// ── 3D Cylinder state ──────────────────────────────────────────────────────
let cylAngle=0, cylVel=0, cylDragging=false, cylDragX=0;
let autoRotate = true;
let cylHoverIdx=-1, cylHoverX=0, cylHoverY=0, cylHoverRotT=0;
let cylPopStart=null;

function drawCylinder(){
  const now=performance.now();
  const ROWS=getGridRows();
  // Tile height fills viewport exactly
  const TILE=Math.floor(GRID_H()/ROWS);

  // Radius: front face fills viewport width
  // At front (z3=R), scale = FOCAL/(FOCAL+R-R) = 1, so tileW = TILE
  // We want ~(W/TILE) tiles visible across front half of cylinder
  // Circumference = 2*PI*R, front half arc = PI*R
  // Tiles in front half = PI*R/TILE = W/TILE => R = W/PI
  const R=W/Math.PI*2.2;
  const FOCAL=R*0.55; // focal length relative to radius feels good

  const CY=HEADER_H+GRID_H()/2;
  const CX=W/2;

  const N=sortedRefs.length;
  const colsFor360=Math.ceil(2*Math.PI*R/TILE);
  // Expand the column count to fill 360° even if it means cards repeat —
  // the cylinder looks fuller this way and the visible duplicates were
  // intentional in the original design.
  const COLS=Math.max(Math.ceil(N/ROWS), colsFor360);
  const anglePerCol=(2*Math.PI)/COLS;

  const drawn=[];
  for(let col=0;col<COLS;col++){
    const tileAngle=col*anglePerCol + cylAngle;
    const x3=Math.sin(tileAngle)*R;
    const z3=Math.cos(tileAngle)*R;
    if(z3<0) continue; // back-facing
    const scale=FOCAL/(FOCAL+R-z3);
    const screenX=CX + x3*scale;

    for(let row=0;row<ROWS;row++){
      const i=col*ROWS+row;
      if(N===0) continue;
      const ref=sortedRefs[i%N];
      const tile=tiles[i%N];
      if(!ref) continue;
      const screenY=CY + (row-(ROWS-1)/2)*TILE*scale;
      const tileW=TILE*scale;
      const tileH=TILE*scale;
      const delay=tile?tile.popDelay:Math.random()*1200;
      const elapsed=cylPopStart?(performance.now()-cylPopStart)-delay:Infinity;
      const growT=Math.max(0,Math.min(1,elapsed/450));
      const alpha=growT>0?1:0;
      const popScale=cylPopStart?(0.01+0.99*growT):1;
      drawn.push({ref,screenX,screenY,tileW,tileH,z3,alpha,i:i%N,scale,popScale});
    }
  }

  drawn.sort((a,b)=>a.z3-b.z3);

  for(const d of drawn){
    const{ref,screenX,screenY,tileW,tileH,alpha,scale,popScale=1}=d;
    const g=GAP*scale;
    const ps=popScale; // scale from dot to full
    const isHovered=cylHoverIdx===d.i;

    if(isHovered) cylHoverRotT=Math.min(1, cylHoverRotT+0.08);

    const x=screenX-tileW*ps/2+g*ps/2;
    const y=screenY-tileH*ps/2+g*ps/2;
    const w=(tileW-g)*ps, h=(tileH-g)*ps;

    // Depth-based alpha — front tiles full opacity, sides fade to ~15%
    const depthAlpha=alpha*(0.1+0.9*Math.pow(d.z3/R, 2.5));

    if(isHovered && cylHoverRotT>0){
      const sc=1+cylHoverRotT*0.1;
      const hw=(tileW-g)*sc, hh=(tileH-g)*sc;
      const hx=screenX-hw/2, hy=screenY-hh/2;
      ctx.save();
      ctx.globalAlpha=depthAlpha;
      const im=getImg(ref)||getFlickerImg(ref);
      if(im&&im.complete&&im.naturalWidth>0){
        const iw=im.naturalWidth,ih=im.naturalHeight;
        const s2=Math.max(hw/iw,hh/ih);
        const sw=hw/s2,sh=hh/s2,sx=(iw-sw)/2,sy=(ih-sh)/2;
        ctx.drawImage(im,sx,sy,sw,sh,hx,hy,hw,hh);
      } else {
        ctx.fillStyle=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
        ctx.fillRect(hx,hy,hw,hh);
      }
      ctx.restore();
      d.sx=hx; d.sy=hy; d.sw=hw; d.sh=hh;
    } else {
      drawRef(ref,x,y,w,h,depthAlpha,getFlickerImg(ref));
      d.sx=x; d.sy=y; d.sw=w; d.sh=h;
    }
  }

  // Decay hover when nothing hovered
  if(cylHoverIdx===-1) cylHoverRotT=Math.max(0, cylHoverRotT-0.1);

  drawnCylTiles=drawn;
}

let drawnCylTiles=[];
let hoverRaf;
const headerInfo=document.getElementById('header-info');
function updateHoverInfo(mx,my){
  if(state!=='grid') return;
  let found=null;
  for(const d of [...drawnCylTiles].reverse()){
    if(mx>=d.sx&&mx<=d.sx+d.sw&&my>=d.sy&&my<=d.sy+d.sh){ found=d; break; }
  }
  if(found) updateMeta(found.ref);
  else updateMetaEmpty();
}

function updateMetaEmpty(){
  const panel=document.getElementById('info-panel');
  if(!panelBuilt) buildInfoPanel();
  panel.classList.remove('row-view');
  panel.querySelectorAll('.iv-text').forEach(el=>el.textContent='');
}
window.addEventListener('mousemove',e=>{
  if(state==='grid') updateHoverInfo(e.clientX,e.clientY);
});

function resize(){
  const rect = cvs.getBoundingClientRect();
W = cvs.width = bgCvs.width = Math.round(rect.width);
H = cvs.height = bgCvs.height = Math.round(rect.height);
  cvs.style.height = H + 'px';
  bgCvs.style.height = H + 'px';
  if(state==='grid')buildGrid();
  if(state==='floated'||state==='exploding'){rebuildFloaters();buildHitTargets();}
}
function draw(){
  ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
  if(state==='grid'){
      drawCylinder();
      if(!cylDragging){
        if(autoRotate) cylAngle += 0.0005;   // slow ambient rotation
        cylAngle+=cylVel;
        cylVel*=0.96;
      }
      return;
  }
  if(state==='returning'){
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  } else {
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  }
  // Draw particles — pure X/Y, no Z perspective
  for(const p of particles){
    if(!p.visible) continue;
    const im=getImg(p.ref);
    ctx.save();
    ctx.globalAlpha=p.alpha;
    ctx.translate(p.x+p.sz/2, p.y+p.sz/2);
    ctx.rotate(p.rot);
    if(im&&im.complete&&im.naturalWidth>0){
      ctx.drawImage(im,-p.sz/2,-p.sz/2,p.sz,p.sz);
    } else {
      ctx.fillStyle=`rgb(${p.color[0]},${p.color[1]},${p.color[2]})`;
      ctx.fillRect(-p.sz/2,-p.sz/2,p.sz,p.sz);
    }
    ctx.restore();
  }
  if(floaters.length>0){
    if(state==='returning'){
      // Draw at animated positions directly — don't recalculate from coverflow
      for(const f of floaters){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);
        const fx=f.x+(f.sz-fw)/2;
        const fy=f.y+(f.sz-fh)/2;
        drawRef(f.ref,fx,fy,fw,fh,f.alpha,getFlickerImgLarge(f.ref));
      }
    } else {
      const{sz,cx,cy}=getCF();
      const GAP_CF=18;

      function cardWidth(f){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        return fh+(natW-fh)*(f.reveal||0);
      }

      const centre=floaters.find(f=>f.offset===0);
      const cw=centre?cardWidth(centre):sz;

      for(const f of [...floaters].sort((a,b)=>a.offset-b.offset)){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);

        let fx=cx-fw/2;
        if(f.offset!==0){
          const dir=Math.sign(f.offset);
          let accum=cw/2+GAP_CF;
          for(let o=dir;Math.abs(o)<Math.abs(f.offset);o+=dir){
            const nb=floaters.find(n=>n.offset===o);
            if(nb) accum+=cardWidth(nb)+GAP_CF;
          }
          fx=dir>0 ? cx+accum : cx-accum-fw;
        }

        const fy=cy-fh/2;
        // Store actual top-left of the bounding box for hit targets / rebuild
        f.drawX=fx; f.drawY=fy; f.drawW=fw; f.drawH=fh;
        f.x=fx-(f.sz-fw)/2;
        f.y=fy-(f.sz-fh)/2;
        drawRef(f.ref,fx,fy,fw,fh,f.alpha,getFlickerImgLarge(f.ref));
      }
    }
  }
}

function startExplode(mx,my,forcedIdx){
  if(state!=='grid')return;
  let sIdx=forcedIdx!==undefined?forcedIdx:0;
  if(forcedIdx===undefined){
    // Flat grid fallback hit test
    let found=false;
    for(let i=0;i<tiles.length;i++){
      const t=tiles[i];
      const sx=t.x-gridScrollY, sy=t.y, sw=t.tw||t.sz, sh=t.th||t.sz;
      if(mx>=sx&&mx<=sx+sw&&my>=sy&&my<=sy+sh){ sIdx=i; found=true; break; }
    }
    if(!found){
      let minD=Infinity;
      tiles.forEach((t,i)=>{ const sx=t.x-gridScrollY,sy=t.y; const d=Math.hypot(sx+(t.tw||t.sz)/2-mx,sy+(t.th||t.sz)/2-my); if(d<minD){minD=d;sIdx=i;} });
    }
  }
  selectedRef=tiles[sIdx].ref;
  currentRefIdx=sortedRefs.findIndex(r=>r===selectedRef);
  const SIDES=7,n=sortedRefs.length;

  // Floaters start from their ACTUAL rendered cylinder position (no jump to flat grid)
  // and ease smoothly into coverflow targets.
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const idx=(currentRefIdx+off+n)%n, ref=sortedRefs[idx];
    if(!ref) continue;
    const tgt=cfPos(off);
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;

    // Use the currently rendered cylinder tile as the starting position.
    // If the ref isn't visible on the cylinder (back-facing), fall back to the clicked tile.
    let sx, sy, ssz;
    const drawn = drawnCylTiles.find(d => d.i === idx);
    if (drawn) {
      sx = drawn.sx; sy = drawn.sy; ssz = drawn.sw;
    } else {
      const clicked = drawnCylTiles.find(d => d.i === currentRefIdx);
      if (clicked) { sx = clicked.sx; sy = clicked.sy; ssz = clicked.sw; }
      else { sx = W/2; sy = H/2; ssz = 80; }
    }

    floaters.push({ref,color:ref.color,
      x:sx, y:sy,
      tx:tgt.x, ty:tgt.y, tsz:tgt.sz,
      sz:ssz, offset:off, alpha:1, reveal:0, natRatio});
  }

  particles=[];
  state='exploding'; phase=0;
  cfScrollX=0; cfScrollVel=0;
  cancelAnimationFrame(animFrame);
  showUI();
  animFrame=requestAnimationFrame(loopExplode);
}

function stepParticles(){
  for(const p of particles){
    p.vx*=0.98; p.vy*=0.98;
    p.vy+=0.3; // strong gravity so they fall fast
    p.x+=p.vx; p.y+=p.vy;
    p.rot+=p.rotV;
    const offscreen=p.x+p.sz<-50||p.x>W+50||p.y+p.sz<-50||p.y>H+50;
    if(offscreen){
      p.alpha=Math.max(0,p.alpha-0.15);
      if(p.alpha<=0) p.visible=false;
    }
  }
}

function loopFloated(){
  tickFlicker();
  draw();
  animFrame=requestAnimationFrame(loopFloated);
}
const loopFloat=loopFloated; // alias for safety

function loopExplode(){
  phase++;
  stepParticles();

  // Floaters ease toward coverflow targets. Match reveal's curve to the
  // x/y/sz easing — using a linear 0.05/frame for reveal made portrait
  // cards (text books) "catch up" to their natural ratio late, giving
  // a visible bounce that square sound covers don't show.
  let done=true;
  for(const f of floaters){
    f.x+=(f.tx-f.x)*0.1; f.y+=(f.ty-f.y)*0.1; f.sz+=(f.tsz-f.sz)*0.1;
    f.reveal=(f.reveal||0)+(1-(f.reveal||0))*0.1;
    if(f.reveal>0.995) f.reveal=1;
    if(Math.hypot(f.tx-f.x,f.ty-f.y)>2) done=false;
  }

  draw();
  if(done&&phase>20){
    for(const f of floaters){f.x=f.tx;f.y=f.ty;f.sz=f.tsz;}
    particles=[];
    state='floated'; phase=0;
    buildHitTargets();
    animFrame=requestAnimationFrame(loopFloated);
    return;
  }
  animFrame=requestAnimationFrame(loopExplode);
}


function getCylPos(refIdx){
  const ROWS=getGridRows();
  const TILE=Math.floor(GRID_H()/ROWS);
  const R=W/Math.PI*2.2;
  const FOCAL=R*0.55; // tighter focal = more dramatic perspective
  const CY=HEADER_H+GRID_H()/2;
  const CX=W/2;
  const N=sortedRefs.length||1;
  const colsFor360=Math.ceil(2*Math.PI*R/TILE);
  const COLS=Math.max(Math.ceil(N/ROWS), colsFor360);
  const anglePerCol=(2*Math.PI)/COLS;
  const col=Math.floor(refIdx/ROWS);
  const row=refIdx%ROWS;
  const tileAngle=col*anglePerCol+cylAngle;
  const x3=Math.sin(tileAngle)*R;
  const z3=Math.cos(tileAngle)*R;
  const scale=FOCAL/(FOCAL+R-z3);
  const screenX=CX+x3*scale;
  const screenY=CY+(row-(ROWS-1)/2)*TILE*scale;
  const tileW=TILE*scale;
  return{x:screenX-tileW/2, y:screenY-tileW/2, sz:tileW};
}

function startReassemble(){
  if(state!=='floated'&&state!=='exploding') return;
  hideUI(); clearHitTargets();

  // Snapshot floater positions for the implosion
  const snap=[...floaters];
  const cx=W/2, cy=H/2;

  state='returning'; phase=0;
  cancelAnimationFrame(animFrame);

  // Phase 1 (~35 frames): neighbours suck into centre card
  // Phase 2 (~20 frames): centre card shrinks to dot
  // Phase 3: dots appear on screen and grow into cylinder tiles

  let implodePhase=0;
  const IMPLODE_DUR=35;
  const SHRINK_DUR=20;
  let bigBangStarted=false;

  function loopImplode(){
    implodePhase++;
    ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);

    if(implodePhase<=IMPLODE_DUR){
      const t=implodePhase/IMPLODE_DUR;
      const ease=t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
      // Draw neighbours first (behind), then centre on top
      const sorted=[...snap].sort((a,b)=>Math.abs(b.offset)-Math.abs(a.offset));
      for(const f of sorted){
        const fh=f.offset===0?f.sz*1.7:f.sz;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);
        const fx0=f.x+(f.sz-fw)/2;
        const fy0=f.y+(f.sz-fh)/2;
        const tx=cx-fw/2, ty=cy-fh/2;
        const fx=fx0+(tx-fx0)*ease;
        const fy=fy0+(ty-fy0)*ease;
        drawRef(f.ref,fx,fy,fw,fh,1,getFlickerImgLarge(f.ref));
      }
    } else {
      // Centre card shrinks to dot, keeping its natural ratio
      const t2=(implodePhase-IMPLODE_DUR)/SHRINK_DUR;
      const sc=Math.max(0,1-t2);
      const centre=snap.find(f=>f.offset===0)||snap[0];
      if(centre&&sc>0){
        const fh=centre.sz*1.7*sc;
        const natW=centre.natRatio?fh*centre.natRatio:fh;
        const fw=fh+(natW-fh)*(centre.reveal||0);
        drawRef(centre.ref,cx-fw/2,cy-fh/2,fw,fh,1,getFlickerImgLarge(centre.ref));
      }

      if(implodePhase>=IMPLODE_DUR+SHRINK_DUR && !bigBangStarted){
        bigBangStarted=true;
        buildGrid();
        tiles.forEach(t=>{ t.popDelay=Math.random()*1200; t._popped=false; });
        cylPopStart=performance.now();
        state='grid'; phase=0;
        cancelAnimationFrame(animFrame);
        animFrame=requestAnimationFrame(loopGrid);
        return;
      }
    }
    animFrame=requestAnimationFrame(loopImplode);
  }
  animFrame=requestAnimationFrame(loopImplode);
}

function loopReassembleBlast(){
  // Step particles
  for(const p of particles){
    p.vx*=0.97; p.vy*=0.97; p.vy+=0.12;
    p.x+=p.vx; p.y+=p.vy; p.rot+=p.rotV; p.frames++;
    const off=p.x+p.sz<-50||p.x>W+50||p.y+p.sz<-50||p.y>H+50;
    if(off){p.alpha=Math.max(0,p.alpha-0.15);if(p.alpha<=0)p.visible=false;}
  }
  // Draw cylinder (tiles pop in one by one — alpha is 0 or 1, no fade)
  ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
  bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  drawCylinder();
  // Draw blast particles on top
  for(const p of particles){
    if(!p.visible)continue;
    const im=getImg(p.ref);
    ctx.save();ctx.globalAlpha=p.alpha;
    ctx.translate(p.x+p.sz/2,p.y+p.sz/2);ctx.rotate(p.rot);
    if(im&&im.complete&&im.naturalWidth>0) ctx.drawImage(im,-p.sz/2,-p.sz/2,p.sz,p.sz);
    else{ctx.fillStyle=`rgb(${p.color[0]},${p.color[1]},${p.color[2]})`;ctx.fillRect(-p.sz/2,-p.sz/2,p.sz,p.sz);}
    ctx.restore();
  }
  const anyVisible=particles.some(p=>p.visible);
  const popDone=!cylPopStart||performance.now()-cylPopStart>1200;
  if(!anyVisible&&popDone){
    particles=[];cylPopStart=null;
    animFrame=requestAnimationFrame(loopGrid);
  } else {
    animFrame=requestAnimationFrame(loopReassembleBlast);
  }
}

function blastToGrid(callback){
  // Simply ease all floaters back to their grid tile positions
  // For non-floater tiles (grid size / filter change), just rebuild immediately
  if(floaters.length===0){
    if(callback) callback();
    state='grid'; phase=0; buildGrid();
    cancelAnimationFrame(animFrame);
    animFrame=requestAnimationFrame(loopGrid);
    return;
  }

  // Set each floater's target to its grid tile position
  for(const f of floaters){
    const tile=tiles.find(t=>t.ref===f.ref);
    if(tile){
      f.tx=tile.x-gridScrollY; f.ty=tile.y; f.tsz=tile.sz;
    } else {
      f.tx=f.x<W/2?-f.sz:W+f.sz; f.ty=f.y; f.tsz=f.sz;
    }
    f.reveal=0;
  }

  state='returning'; phase=0;
  cancelAnimationFrame(animFrame);
  animFrame=requestAnimationFrame(loopReturn);
}

function loopGrid(){
  tickFlicker();
  if(cylPopStart&&performance.now()-cylPopStart>3500) cylPopStart=null;
  updateCylScrubber();
  draw();
  animFrame=requestAnimationFrame(loopGrid);
}

function rebuildFloaters(){
  const n=sortedRefs.length,SIDES=7;
  // Build a map of current floater positions by ref
  const curPos=new Map();
  for(const f of floaters) curPos.set(f.ref,{x:f.x,y:f.y,sz:f.sz,reveal:f.reveal||0});
  const{cx,cy}=getCF();
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const idx=(currentRefIdx+off+n)%n,ref=sortedRefs[idx],tgt=cfPos(off);
    if(!ref) continue;
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;
    const prev=curPos.get(ref);
    floaters.push({ref,color:ref.color,
      // Start from previous position if known, else target
      x:prev?prev.x:tgt.x, y:prev?prev.y:tgt.y, sz:prev?prev.sz:tgt.sz,
      tx:tgt.x, ty:tgt.y, tsz:tgt.sz,
      offset:off, alpha:1, reveal:prev?prev.reveal:1, natRatio});
  }
  // Animate to new positions via loopExplode
  state='exploding'; phase=0;
  cancelAnimationFrame(animFrame);
  animFrame=requestAnimationFrame(loopExplode);
}

function buildHitTargets(){
  const stack=document.getElementById('card-stack');
  stack.innerHTML='';
  const{sz}=getCF(),n=sortedRefs.length,VISIBLE=7;
  for(let off=-VISIBLE;off<=VISIBLE;off++){
    const idx=(currentRefIdx+off+n)%n,ref=sortedRefs[idx],pos=cfPos(off);
    if(!ref) continue;
    const sc=off===0?1.5:1.0;
    const w=sz*sc,h=sz*sc,x=pos.x+(sz-w)/2,y=pos.y+(sz-h)/2;
    const div=document.createElement('div');
    div.className='stack-card';
    div.style.cssText=`left:${x}px;top:${y}px;width:${w}px;height:${h}px;z-index:${VISIBLE+1-Math.abs(off)};`;
    if(off!==0){
      div.addEventListener('click',e=>{
        e.stopPropagation();
        currentRefIdx=idx;selectedRef=ref;
        rebuildFloaters();buildHitTargets();updateMeta(ref);updateScrubber();
      });
    }
    stack.appendChild(div);
  }
  stack.classList.add('active');
}

function clearHitTargets(){
  const stack=document.getElementById('card-stack');
  stack.innerHTML=''; stack.classList.remove('active');
}

// ── Thumbnail strip ───────────────────────────────────────────────────────
let thumbInterval=null, thumbIdx=0, thumbPaused=false;

function buildThumbStrip(ref){
  const strip=document.getElementById('thumb-strip');
  strip.innerHTML='';
  strip.classList.remove('show');
  clearInterval(thumbInterval);
  if(!ref.images||ref.images.length===0) return;

  thumbIdx=flickerIdx.get(ref)||0;

  // Position strip below the centre card
  const{sz,cx,cy}=getCF();
  const sc=1.7, fh=sz*sc;
  const stripY=cy+fh/2+14;
  strip.style.top=stripY+'px';
  strip.style.left='0'; strip.style.right='0';

  // Build thumbnails — main img first, then images array
  const allImgs=[ref.img,...(ref.images||[])];
  allImgs.forEach((src,i)=>{
    const item=document.createElement('div');
    item.className='thumb-item'+(i===thumbIdx?' active':'');
    if(src){
      const img=document.createElement('img');
      img.src=src; item.appendChild(img);
    } else {
      item.style.background=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
    }
    item.addEventListener('click',()=>{ thumbIdx=i; flickerIdx.set(ref,i); updateThumbActive(strip,i); });
    strip.appendChild(item);
  });

  strip.classList.add('show');

  // Auto-slideshow
  clearInterval(thumbInterval);
  thumbInterval=setInterval(()=>{
    if(thumbPaused) return;
    thumbIdx=(thumbIdx+1)%allImgs.length;
    flickerIdx.set(ref,thumbIdx);
    updateThumbActive(strip,thumbIdx);
  }, 1200);
}

function updateThumbActive(strip, idx){
  [...strip.children].forEach((c,i)=>c.classList.toggle('active',i===idx));
}

function hideThumbStrip(){
  clearInterval(thumbInterval);
  document.getElementById('thumb-strip').classList.remove('show');
}

// Pause strip when hovering centre card area
function isOverCentreCard(mx,my){
  const centre=floaters.find(f=>f.offset===0);
  if(!centre) return false;
  const{sz,cx,cy}=getCF();
  const sc=1.7, fh=centre.sz*sc;
  const natW=centre.natRatio?fh*centre.natRatio:fh;
  const fw=fh+(natW-fh)*(centre.reveal||0);
  const fx=centre.x+(centre.sz-fw)/2;
  const fy=centre.y+(centre.sz-fh)/2;
  return mx>=fx&&mx<=fx+fw&&my>=fy&&my<=fy+fh;
}
window.addEventListener('mousemove',e=>{
  if(state==='floated'||state==='exploding'){
    thumbPaused=isOverCentreCard(e.clientX,e.clientY);
  }
});
function showUI(){
  document.getElementById('cyl-nav').style.display='none';
  document.getElementById('back-btn').classList.add('show');
  resetRowSearchUI();
  updateMeta(selectedRef); updateScrubber();
  buildThumbStrip(selectedRef);
}

function hideUI(){
  document.getElementById('cyl-nav').style.display='flex';
  document.getElementById('back-btn').classList.remove('show');
  resetRowSearchUI();
  hideThumbStrip();
  updateCylScrubber();
  updateMetaEmpty();
}

// Panel rows: [label, ref key, searchable field or null]
const PANEL_ROWS=[
  ['Title',    'title',   'title'],
  ['Creator',  'artist',  'artist'],
  ['Year',     'year',    null],
  ['Added by', 'addedBy', null],
  ['Category', 'cat',     null],
];
let panelBuilt=false;

// Built ONCE. Rebuilding on every step would destroy the open input (and its
// focus and caret) on each keystroke, since typing walks the row.
function buildInfoPanel(){
  const panel=document.getElementById('info-panel');
  panel.innerHTML=PANEL_ROWS.map(([label,key,field])=>{
    const name=field==='artist'?'creator':'title';
    return `<div class="info-row" data-field="${field||''}">`
      +`<span class="info-label">${label}${field?searchIconHTML(field):''}</span>`
      +`<span class="info-value"><span class="iv-text"></span>`
      +(field?`<span class="iv-field"><span class="iv-ghost"></span>`
        +`<input class="iv-input" type="text" data-field="${field}" autocomplete="off" spellcheck="false"></span>`:'')
      +`</span></div>`;
  }).join('');
  panelBuilt=true;
}

// Reflect rowSearchField onto the icons and rows.
function syncSearchUI(){
  if(!panelBuilt) return;
  const panel=document.getElementById('info-panel');
  panel.querySelectorAll('.info-search-icon').forEach(b=>
    b.classList.toggle('active',b.dataset.field===rowSearchField));
  panel.querySelectorAll('.info-row').forEach(r=>{
    const on=!!r.dataset.field&&r.dataset.field===rowSearchField;
    r.classList.toggle('searching',on);
    if(!on) r.classList.remove('no-match');
  });
}

// Paint the grey completion behind the input so you can always read which card
// is centred. Empty box → the whole value. Typing a prefix → the remainder
// trails off in grey. A non-prefix (mid-word) hit still names the card, after
// a dash, since the typed text can't overlay it.
function syncGhost(){
  if(!panelBuilt) return;
  const panel=document.getElementById('info-panel');
  panel.querySelectorAll('.info-row[data-field]').forEach(row=>{
    const f=row.dataset.field;
    const ghost=row.querySelector('.iv-ghost');
    const input=row.querySelector('.iv-input');
    if(!ghost||!input||!f) return;
    ghost.textContent='';
    if(f!==rowSearchField||!selectedRef) return;
    const cur=fieldVal(selectedRef,f);
    const typed=input.value;
    let rest;
    if(!typed) rest=cur;
    else if(cur.toLowerCase().startsWith(typed.toLowerCase())) rest=cur.slice(typed.length);
    else rest=cur?'  —  '+cur:'';
    const a=document.createElement('span'); a.className='iv-ghost-typed'; a.textContent=typed;
    const b=document.createElement('span'); b.className='iv-ghost-rest';  b.textContent=rest;
    ghost.append(a,b);
  });
}

function updateMeta(ref){
  // Header info (cylinder hover — single line)
  const info=document.getElementById('header-info');
  info.innerHTML=`${ref.title}<span class="sep">·</span>${ref.artist}<span class="sep">·</span>${ref.year}`;

  const panel=document.getElementById('info-panel');
  if(!panelBuilt) buildInfoPanel();
  panel.classList.toggle('row-view',inRowView());
  PANEL_ROWS.forEach(([,key],i)=>{
    const cell=panel.children[i].querySelector('.iv-text');
    if(cell) cell.textContent=ref[key]||'—';
  });
  syncSearchUI();
  syncGhost();
}

// Magnifier markup for the TITLE / CREATOR rows. Only rendered in the row
// view — updateMeta() also runs on cylinder hover, where search doesn't apply.
function searchIconHTML(field){
  const name=field==='artist'?'creator':'title';
  const on=rowSearchField===field?' active':'';
  return `<button class="info-search-icon${on}" data-field="${field}" aria-label="Search ${name}" title="Search ${name}">`
    +`<svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">`
    +`<circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.8"/>`
    +`<line x1="10.8" y1="10.8" x2="15" y2="15" stroke="currentColor" stroke-width="1.8"/>`
    +`</svg></button>`;
}

function updateScrubber(){
  const n=sortedRefs.length,pct=n>1?currentRefIdx/(n-1):0;
  const dot=document.getElementById('scrubber-dot');
  dot.style.transition='none'; dot.style.left=(pct*100)+'%';
}

// ── Dropdown menus ────────────────────────────────────────────────────────
// Open dropdown on button click
document.getElementById('filter-btn').addEventListener('click',e=>{
  e.stopPropagation();
  document.getElementById('filter-drop').classList.toggle('open');
});
// Close dropdowns on click outside
document.addEventListener('click',()=>{ document.querySelectorAll('.hdr-dropdown').forEach(d=>d.classList.remove('open')); });

document.querySelectorAll('#filter-menu button').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#filter-menu button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('filter-label').textContent=btn.textContent;
    document.getElementById('filter-drop').classList.remove('open');
    activeFilter=btn.dataset.filter;
    if(state==='grid'){ buildGrid(); cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopGrid); }
  });
});

// Sort dropdown — mirrors the filter dropdown. Re-sorts and rebuilds the
// cylinder in place; the active type filter is preserved because buildGrid()
// filters first, then sortRefs() sorts the filtered set.
document.getElementById('sort-btn').addEventListener('click',e=>{
  e.stopPropagation();
  document.getElementById('sort-drop').classList.toggle('open');
});
document.querySelectorAll('#sort-menu button').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('#sort-menu button').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('sort-label').textContent=btn.textContent;
    document.getElementById('sort-drop').classList.remove('open');
    activeSort=btn.dataset.sort;
    if(state==='grid'){ buildGrid(); cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopGrid); }
  });
});

// ── Row-view search ─────────────────────────────────────────────────────────
// Clicking the magnifier on TITLE or CREATOR lines the ENTIRE row up A–Z on
// that field — nothing is removed. Typing then walks the view to the first
// match (Enter cycles to the next). Closing keeps the alphabetical order.
// Only ever active in the row view; returning to the cylinder re-runs
// buildGrid(), which rebuilds sortedRefs, so this never leaks into the grid.
let rowSearchField=null, rowSearchQuery='';

function inRowView(){ return state==='floated'||state==='exploding'; }

// Value of the field being searched, for one ref.
function fieldVal(r,f){ return ((f==='artist'?r.artist:r.title)||'').toString(); }

// The current type filter's refs, lined up A–Z on `field`.
function alphaSorted(field){
  const src=activeFilter==='all'?REFS:REFS.filter(r=>(r.cat||'').toLowerCase()===activeFilter.toLowerCase());
  return [...src].sort((a,b)=>
    fieldVal(a,field).localeCompare(fieldVal(b,field),undefined,{sensitivity:'base',numeric:true})
    || (a.title||'').localeCompare(b.title||'')
  );
}

// Swap the row order, staying on whatever cover is currently centred.
function reorderRow(list){
  const keep=selectedRef;
  sortedRefs=list;
  const i=keep?sortedRefs.indexOf(keep):-1;
  currentRefIdx=i>=0?i:0;
  cfStep(0);                            // rebuilds floaters + meta around the new index
}

// First match scanning forward from `from`, wrapping. Prefers a prefix match
// (typing "b" lands on the B's, not the first title containing a "b").
function findMatch(q,from){
  const n=sortedRefs.length;
  if(!q||n===0||!rowSearchField) return -1;
  const tests=[v=>v.startsWith(q), v=>v.includes(q)];
  for(const test of tests){
    for(let k=0;k<n;k++){
      const i=((from+k)%n+n)%n;
      if(test(fieldVal(sortedRefs[i],rowSearchField).toLowerCase().trim())) return i;
    }
  }
  return -1;
}

// The input belonging to the field currently being searched.
function activeInput(){
  if(!rowSearchField||!panelBuilt) return null;
  return document.querySelector(`.iv-input[data-field="${rowSearchField}"]`);
}
function activeRow(){
  if(!rowSearchField||!panelBuilt) return null;
  return document.querySelector(`.info-row[data-field="${rowSearchField}"]`);
}

function resetRowSearchUI(){
  clearSettle();
  rowSearchField=null; rowSearchQuery='';
  if(panelBuilt) document.querySelectorAll('.iv-input').forEach(i=>{ i.value=''; });
  syncSearchUI();
  syncGhost();
}

function applyRowSearch(from){
  if(!inRowView()||!rowSearchField) return;
  const row=activeRow();
  const q=rowSearchQuery.trim().toLowerCase();
  if(!q){ row&&row.classList.remove('no-match'); return; }  // empty box: stay put, row already A–Z
  const idx=findMatch(q,from===undefined?0:from);
  if(idx<0){ row&&row.classList.add('no-match'); return; }  // no match: hold position, flag it
  row&&row.classList.remove('no-match');
  currentRefIdx=idx;
  cfStep(0);                                                // walk the row to the match
}

function openRowSearch(field){
  if(!inRowView()) return;
  clearSettle();                        // cancel a pending commit fade
  rowSearchField=field;                 // set before reorder so syncSearchUI paints it
  rowSearchQuery='';
  const i=activeInput(); if(i) i.value='';
  reorderRow(alphaSorted(field));       // line the whole row up A–Z on this field
  syncSearchUI();
  syncGhost();
  const inp=activeInput();
  if(inp) setTimeout(()=>inp.focus(),0);
}

function closeRowSearch(){
  resetRowSearchUI();                   // order stays alphabetical, as requested
}

const _panel=document.getElementById('info-panel');

// Toggle a field's search. Opening one closes the other — only ever one at a time.
_panel.addEventListener('click',e=>{
  const btn=e.target.closest('.info-search-icon');
  if(!btn) return;
  e.stopPropagation();
  const f=btn.dataset.field;
  if(rowSearchField===f) closeRowSearch(); else openRowSearch(f);
});

// Accept the grey completion: fill the input with the centred card's full
// value (in ITS casing, so "ak" becomes "Akira"). Returns false when there's
// nothing to accept — the caller then falls through to cycling matches.
function acceptCompletion(){
  const input=activeInput();
  if(!input||!selectedRef||!rowSearchField) return false;
  const cur=fieldVal(selectedRef,rowSearchField);
  const typed=input.value;
  if(!typed||!cur) return false;
  if(!cur.toLowerCase().startsWith(typed.toLowerCase())) return false;  // mid-word hit: nothing to trail
  if(typed.length>=cur.length) return false;                            // already complete
  input.value=cur; rowSearchQuery=cur;
  try{ input.setSelectionRange(cur.length,cur.length); }catch(_){}      // caret to end
  syncGhost();
  return true;
}

// Commit: settle the search. The row keeps its A–Z order and stays on the
// centred card, but the underbar and the icon highlight go away — the value
// reverts to plain static text. Since that text is already the centred card's
// full title, in the same font at the same spot, the swap is seamless.
let settleTimer=null;
function clearSettle(){
  if(settleTimer){ clearTimeout(settleTimer); settleTimer=null; }
  document.querySelectorAll('.info-row.settling').forEach(r=>r.classList.remove('settling'));
}

function commitRowSearch(){
  const row=activeRow(), input=activeInput();
  if(input) input.blur();               // also dismisses the mobile keyboard
  if(!row){ closeRowSearch(); return; }
  const icon=row.querySelector('.info-search-icon');
  if(icon) icon.classList.remove('active');   // un-highlight now, so both fade together
  clearSettle();
  row.classList.add('settling');              // underline fades to transparent
  settleTimer=setTimeout(()=>{
    settleTimer=null;
    row.classList.remove('settling');
    closeRowSearch();                         // swap input → static value text
  },180);                                     // matches the .18s transition
}

// The inputs persist across steps now, so delegation just keeps this tidy.
_panel.addEventListener('mousedown',e=>{ if(e.target.closest('.iv-input')) e.stopPropagation(); });
_panel.addEventListener('input',e=>{
  const i=e.target.closest('.iv-input'); if(!i) return;
  rowSearchQuery=i.value; applyRowSearch(0); syncGhost();
});
_panel.addEventListener('keydown',e=>{
  if(!e.target.closest('.iv-input')) return;
  e.stopPropagation();                  // keep arrows/escape from driving the coverflow
  if(e.key==='Escape'){ closeRowSearch(); }
  else if(e.key==='Enter'){
    e.preventDefault();
    const row=activeRow();
    // Nothing found: hold the red underbar rather than silently settling.
    if(row&&row.classList.contains('no-match')) return;
    acceptCompletion();                 // fill in any grey remainder first
    commitRowSearch();                  // then drop the underline + icon highlight
  }
  else if(e.key==='Tab'){               // accept the completion, stay in the field
    if(acceptCompletion()) e.preventDefault();
  }
  else if(e.key==='ArrowRight'){        // caret at end + grey text showing → accept
    const i=e.target;
    if(i.selectionStart===i.value.length&&i.selectionStart===i.selectionEnd){
      if(acceptCompletion()) e.preventDefault();
    }
  }
});

function updateCylScrubber(){
  // Map cylAngle to scrubber dot position (mod 2PI → 0-100%)
  const dot=document.getElementById('scrubber-dot');
  if(!dot) return;
  const pct=((cylAngle%(Math.PI*2))+Math.PI*2)%(Math.PI*2) / (Math.PI*2);
  dot.style.transition='none';
  dot.style.left=(pct*100)+'%';
}

function setupScrubberDrag(){
  const wrap=document.getElementById('scrubber-wrap');
  let s=false;
  function to(cx){
    const r=wrap.getBoundingClientRect();
    const pct=Math.max(0,Math.min(1,(cx-r.left)/r.width));
    if(state==='floated'||state==='exploding'){
      // Expanded view: step through refs
      const n=sortedRefs.length, idx=Math.round(pct*(n-1));
      document.getElementById('scrubber-dot').style.left=(pct*100)+'%';
      if(idx!==currentRefIdx) cfStep(idx-currentRefIdx);
    } else if(state==='grid'){
      // Cylinder: drag scrubber to rotate
      document.getElementById('scrubber-dot').style.left=(pct*100)+'%';
      cylAngle=pct*Math.PI*2;
      cylVel=0;
      autoRotate=false;     
    }
  }
  wrap.addEventListener('mousedown',e=>{
    if(e.target.closest('#scrubber-wrap')){ s=true; to(e.clientX); }
  });
  window.addEventListener('mousemove',e=>{if(s)to(e.clientX);});
  window.addEventListener('mouseup',()=>{s=false;});
  wrap.addEventListener('touchstart',e=>{s=true;to(e.touches[0].clientX);},{passive:true});
  window.addEventListener('touchmove',e=>{if(s)to(e.touches[0].clientX);},{passive:true});
  window.addEventListener('touchend',()=>{s=false;});
}

// Wheel scrolls through refs in expanded view
let cfWheelAcc=0;
function cfStep(steps){
  if(state==='grid'||state==='returning') return;
  hideThumbStrip();
  const n=sortedRefs.length;
  if(n===0) return;
  currentRefIdx=Math.max(0,Math.min(n-1,currentRefIdx+steps));
  selectedRef=sortedRefs[currentRefIdx];
  if(!selectedRef) return;
  updateMeta(selectedRef);
  updateScrubber();
  buildThumbStrip(selectedRef);
  const SIDES=7;
  const prevReveal=floaters.length>0?(floaters[0].reveal||1):1;
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const i=(currentRefIdx+off+n)%n, ref=sortedRefs[i];
    if(!ref) continue;
    const tgt=cfPos(off);
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;
    floaters.push({ref,color:ref.color,x:tgt.x,y:tgt.y,sz:tgt.sz,tx:tgt.x,ty:tgt.y,tsz:tgt.sz,offset:off,alpha:1,reveal:prevReveal,natRatio});
  }
  buildHitTargets();
  if(state!=='floated'){ state='floated'; cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopFloated); }
}
function cfWheelScroll(delta){
  if(state==='grid'||state==='returning') return;
  cfWheelAcc+=delta;
  const threshold=50;
  if(Math.abs(cfWheelAcc)>=threshold){
    const steps=Math.round(cfWheelAcc/threshold);
    cfWheelAcc=0;
    cfStep(steps);
  }
}
cvs.addEventListener('mousedown',e=>{
  if(state==='grid'){ cylDragging=true; cylDragX=e.clientX; cylVel=0; autoRotate=false; }
});
document.addEventListener('mousedown',e=>{
  // Don't start cfDrag when interacting with the scrubber or the header (search/back)
  if(e.target.closest('#scrubber-wrap, #header')) return;
  if(state==='floated'||state==='exploding'){ cfDragging=true; cfDragX=e.clientX; cfScrollVel=0; cfDragMoved=false; }
});
let cfDragMoved=false;
window.addEventListener('mousemove',e=>{
  if(cylDragging&&state==='grid'){
    const dx=e.clientX-cylDragX; cylAngle+=dx*0.003; cylVel=dx*0.003; cylDragX=e.clientX;
  }
  if(cfDragging&&(state==='floated'||state==='exploding')){
    const dx=e.clientX-cfDragX;
    if(Math.abs(dx)>3) cfDragMoved=true;
    cfDragX=e.clientX;
    cfWheelScroll(-dx*0.7);
  }
  // Cylinder hover peek
  if(state==='grid'&&!cylDragging){
    cylHoverIdx=-1;
    for(const d of [...drawnCylTiles].reverse()){
      if(e.clientX>=d.sx&&e.clientX<=d.sx+d.sw&&e.clientY>=d.sy&&e.clientY<=d.sy+d.sh){
        cylHoverIdx=d.i;
        cylHoverX=(e.clientX-d.sx)/d.sw;
        cylHoverY=(e.clientY-d.sy)/d.sh;
        break;
      }
    }
  } else if(state!=='grid'){
    cylHoverIdx=-1;
  }
});
window.addEventListener('mouseup',()=>{ cylDragging=false; cfDragging=false; });

cvs.addEventListener('wheel',e=>{
  e.preventDefault();
  if(state==='grid'){ cylVel+=(e.deltaX+e.deltaY)*0.0006; autoRotate=false; }
  if(state==='floated'||state==='exploding'){ const d=Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY; cfWheelScroll(d); }
},{passive:false});

['card-stack','scrubber-wrap','header'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener('wheel',e=>{
    if(state==='floated'||state==='exploding'){ e.preventDefault(); cfWheelScroll(Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY); }
  },{passive:false});
});
cvs.addEventListener('click',e=>{
  const ui=['BUTTON','INPUT','SELECT','A'];
  if(ui.includes(e.target.tagName)) return;
  if(e.target.closest('#grid-sizer,#threads,#back-btn,#scrubber-wrap,#pile-overlay,#header')) return;
  if(state!=='grid') return;
  // Hit test against cylinder-projected tiles (front to back)
  for(const d of [...drawnCylTiles].reverse()){
    if(e.clientX>=d.sx&&e.clientX<=d.sx+d.sw&&e.clientY>=d.sy&&e.clientY<=d.sy+d.sh){
      startExplode(e.clientX, e.clientY, d.i);
      break;
    }
  }
});
// Touch for cylinder and coverflow row
let touchStartX=0, touchStartY=0;
cvs.addEventListener('touchstart',e=>{
  touchStartX=e.touches[0].clientX;
  touchStartY=e.touches[0].clientY;
  if(state==='grid'){ cylDragX=e.touches[0].clientX; cylVel=0; cylDragging=true; autoRotate=false; }
  if(state==='floated'||state==='exploding'){ cfDragX=e.touches[0].clientX; cfScrollVel=0; cfDragging=true; }
},{passive:true});

window.addEventListener('touchmove',e=>{
  if(state==='grid'&&cylDragging){
    const dx=e.touches[0].clientX-cylDragX;
    cylAngle+=dx*0.003; cylVel=dx*0.003; cylDragX=e.touches[0].clientX;
  }
  if((state==='floated'||state==='exploding')&&cfDragging){
    const dx=e.touches[0].clientX-cfDragX;
    cfDragX=e.touches[0].clientX;
    cfWheelScroll(-dx*0.5);
    e.preventDefault();
  }
},{passive:false});

window.addEventListener('wheel',e=>{
  if(state==='floated'||state==='exploding'){ e.preventDefault(); cfWheelScroll(Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY); }
},{passive:false});
window.addEventListener('touchend',()=>{ cylDragging=false; cfDragging=false; });

// Mobile two-tap interaction: tap once to SELECT (info panel updates,
// like hover on desktop), tap again on the same tile within 4s to OPEN
// (coverflow). Touches with significant movement are treated as cylinder
// rotation and ignored here.
let cylLastTapIdx = -1;
let cylLastTapTime = 0;
cvs.addEventListener('touchend',e=>{
  e.preventDefault();
  const t=e.changedTouches[0];
  if(state!=='grid') return;
  const dx = t.clientX - touchStartX;
  const dy = t.clientY - touchStartY;
  if (Math.sqrt(dx*dx + dy*dy) > 12) return;  // drag, not tap
  // Generous hit-test padding so fingertip taps don't need pixel-perfect
  // accuracy — the cylinder tiles are small and the 3D depth makes their
  // visual centres slightly different from the exact draw rect.
  const PAD = 8;
  let tappedIdx = -1;
  for(const d of [...drawnCylTiles].reverse()){
    if(t.clientX>=d.sx-PAD&&t.clientX<=d.sx+d.sw+PAD&&t.clientY>=d.sy-PAD&&t.clientY<=d.sy+d.sh+PAD){
      tappedIdx = d.i; break;
    }
  }
  if (tappedIdx < 0) return;
  const now = performance.now();
  if (tappedIdx === cylLastTapIdx && now - cylLastTapTime < 4000) {
    startExplode(t.clientX, t.clientY, tappedIdx);
    cylLastTapIdx = -1;
  } else {
    cylHoverIdx = tappedIdx;
    cylLastTapIdx = tappedIdx;
    cylLastTapTime = now;
    const ref = sortedRefs[tappedIdx];
    if (ref) updateMeta(ref);
  }
},{passive:false});

document.getElementById('back-btn').addEventListener('click',()=>{ if(state==='floated'||state==='exploding')startReassemble(); });

document.querySelectorAll('.thread-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    if(state!=='grid')return;
    document.querySelectorAll('.thread-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); activeFilter=btn.dataset.filter;
    if(state==='grid'){ buildGrid(); cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopGrid); }
  });
});



document.addEventListener('keydown',e=>{
  if(state!=='floated')return;
  const n=sortedRefs.length;
  if(e.key==='ArrowRight') cfStep(1);
  if(e.key==='ArrowLeft') cfStep(-1);
  if(e.key==='Escape')startReassemble();
});

// ── Pile overlay for multi-image expanded view ────────────────────────────────
(function(){
  const overlay=document.getElementById('pile-overlay');
  const stack=document.getElementById('pile-stack');
  const counter=document.getElementById('pile-counter');
  const closeBtn=document.getElementById('pile-close');
  let pileRef=null, pileIdx=0;
  let pileCards=[]; // cached card refs — avoid re-querying stack.children on every cycle

  function closePile(){
    overlay.hidden=true;
    overlay.classList.remove('open');
  }

  function buildPile(ref){
    pileRef=ref; pileIdx=0;
    stack.innerHTML='';
    const n=imgCount(ref);
    counter.textContent=`${pileIdx+1} / ${n}`;

    // Create stacked cards — slight rotation offsets
    const frag=document.createDocumentFragment();
    for(let i=n-1;i>=0;i--){
      const card=document.createElement('div');
      card.className='pile-card';
      const rot=(i-Math.floor(n/2))*3.5*(Math.random()*0.4+0.8);
      card.style.setProperty('--rot',`${rot}deg`);
      const img=document.createElement('img');
      const im=getImgAt(ref,i);
      if(im) img.src=im.src;
      card.appendChild(img);
      card.dataset.idx=i;
      frag.appendChild(card);
    }
    stack.appendChild(frag);
    pileCards=Array.from(stack.children);

    overlay.hidden=false;
    overlay.classList.add('open');
    updateTop();
  }

  function updateTop(){
    const n=imgCount(pileRef);
    counter.textContent=`${pileIdx+1} / ${n}`;
    // Bring pileIdx card to top — write CSS vars, no transform string concat
    for(let k=0;k<pileCards.length;k++){
      const c=pileCards[k];
      const i=parseInt(c.dataset.idx);
      const offset=i-pileIdx;
      const absOffset=Math.abs(offset);
      c.style.setProperty('--rot',`${offset*3.5}deg`);
      c.style.setProperty('--scale',`${1-absOffset*0.04}`);
      c.style.setProperty('--ty',`${absOffset*6}px`);
      c.style.setProperty('--z',`${n-absOffset}`);
    }
  }

  stack.addEventListener('click',()=>{
    const n=imgCount(pileRef);
    pileIdx=(pileIdx+1)%n;
    updateTop();
  });

  closeBtn.addEventListener('click',closePile);
  overlay.addEventListener('keydown',e=>{ if(e.key==='Escape') closePile(); });

  // Expose openPile globally so expanded view can trigger it
  window.openPile=buildPile;
})();

// In expanded view, clicking the centre card opens pile if multi-image
document.getElementById('card-stack').addEventListener('click',e=>{
  if(state!=='floated') return;
  const centre=floaters.find(f=>f.offset===0);
  if(centre && imgCount(centre.ref)>1){
    // Check click is on centre card area
    const f=centre;
    const{sz,cx,cy}=getCF();
    const sc=1.3, fh=f.sz*sc;
    const natW=f.natRatio?fh*f.natRatio:fh;
    const fw=fh+(natW-fh)*(f.reveal||0);
    const fx=f.x+(f.sz-fw)/2, fy=f.y+(f.sz-fh)/2;
    if(e.clientX>fx&&e.clientX<fx+fw&&e.clientY>fy&&e.clientY<fy+fh){
      window.openPile(centre.ref);
    }
  }
});


// ── Grid size switcher
document.querySelectorAll('.gs-btn').forEach(btn=>{
  btn.addEventListener('click',(e)=>{
    e.stopPropagation();
    document.querySelectorAll('.gs-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    gridSize=btn.dataset.cols;
    if(state==='grid'){
      gridSize=btn.dataset.cols;
      buildGrid();
      tiles.forEach(t=>{ t.popDelay=Math.random()*800; t._popped=false; });
      cylPopStart=performance.now();
      cancelAnimationFrame(animFrame);
      animFrame=requestAnimationFrame(loopGrid);
    }
  });
});

