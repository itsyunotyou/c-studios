---
import Layout from '../layouts/Layout.astro';
import services from '../data/services.json';
import clients from '../data/clients.json';
import projectsData from '../data/projects.json';


---

<Layout title="C-STUDIOS">
  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- C-STUDIOS / Hero with moon animation                          -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="cstudios">
    <div class="cst-hero" id="cstHero">
      <!-- Slideshow (inside #cstHero so mix-blend works on .container) -->
  <!-- Slideshow -->
      <div id="flashSequence" class="cst-stage">
        <img
          src="/images/hero/intro01-1280w.webp"
          srcset="/images/hero/intro01-640w.webp 640w, /images/hero/intro01-828w.webp 828w, /images/hero/intro01-1280w.webp 1280w, /images/hero/intro01-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro02-1280w.webp"
          srcset="/images/hero/intro02-640w.webp 640w, /images/hero/intro02-828w.webp 828w, /images/hero/intro02-1280w.webp 1280w, /images/hero/intro02-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro03-1280w.webp"
          srcset="/images/hero/intro03-640w.webp 640w, /images/hero/intro03-828w.webp 828w, /images/hero/intro03-1280w.webp 1280w, /images/hero/intro03-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro04-1280w.webp"
          srcset="/images/hero/intro04-640w.webp 640w, /images/hero/intro04-828w.webp 828w, /images/hero/intro04-1280w.webp 1280w, /images/hero/intro04-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro05-1280w.webp"
          srcset="/images/hero/intro05-640w.webp 640w, /images/hero/intro05-828w.webp 828w, /images/hero/intro05-1280w.webp 1280w, /images/hero/intro05-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro06-1280w.webp"
          srcset="/images/hero/intro06-640w.webp 640w, /images/hero/intro06-828w.webp 828w, /images/hero/intro06-1280w.webp 1280w, /images/hero/intro06-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro07-1280w.webp"
          srcset="/images/hero/intro07-640w.webp 640w, /images/hero/intro07-828w.webp 828w, /images/hero/intro07-1280w.webp 1280w, /images/hero/intro07-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro08-1280w.webp"
          srcset="/images/hero/intro08-640w.webp 640w, /images/hero/intro08-828w.webp 828w, /images/hero/intro08-1280w.webp 1280w, /images/hero/intro08-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro09-1280w.webp"
          srcset="/images/hero/intro09-640w.webp 640w, /images/hero/intro09-828w.webp 828w, /images/hero/intro09-1280w.webp 1280w, /images/hero/intro09-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro10-1280w.webp"
          srcset="/images/hero/intro10-640w.webp 640w, /images/hero/intro10-828w.webp 828w, /images/hero/intro10-1280w.webp 1280w, /images/hero/intro10-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
      </div>

      <!-- Moon (tracker) -->
      <div class="moon"></div>

      <!-- Text -->
      <div class="container" id="textContainer">
        <p class="home-text">C-STUDIOS</p>
        <p class="sub-text" id="subText">
          is a creative strategy studio working across cultural research, concepts, creative direction, consulting, and curation.
        </p>
      </div>

      <!-- Inverted mask + matching rim -->
      <div id="revealHole" class="reveal-hole" aria-hidden="true"></div>
      <div id="holeRim" class="hole-rim" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- SERVICES                                                      -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="services" class="services-section">
    <div class="services-tabs">
      {services.map((tab, i) => (
        <button
          class:list={["services-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {services.map((tab, i) => (
      <div class:list={["services-panel", { active: i === 0 }]} data-tab={tab.slug}>
        <div class="services-images">
          {tab.columns.map(col => (
            <img
              src={`/images/services/${col.image}-1280w.webp`}
              srcset={`/images/services/${col.image}-640w.webp 640w, /images/services/${col.image}-828w.webp 828w, /images/services/${col.image}-1280w.webp 1280w, /images/services/${col.image}-2560w.webp 2560w`}
              sizes="25vw"
              alt={col.alt}
              loading="lazy" />
          ))}
        </div>
        <div class="services-texts">
          {tab.columns.map(col => {
            const hasContent = col.category || col.services.length > 0;
            return (
              <div class="services-column">
                {hasContent && col.category && <div class="services-category">[ {col.category} ]</div>}
                {hasContent && col.services.length > 0 && (
                  <ul class="services-list">
                    {col.services.map(s => <li>{s}</li>)}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </section>



  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- CLIENTS — two-row marquee, opposite directions                -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="clients" class="clients-section">
    <!-- Top row — scrolls left → right -->
    <div class="marquee">
      <div
        class="marquee-track marquee-right"
        style={`animation-duration: ${clients.row1.length * 5.5}s`}>
        {[...clients.row1, ...clients.row1].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="lazy" />
        ))}
      </div>
    </div>
    <!-- Bottom row — scrolls right → left -->
    <div class="marquee">
      <div
        class="marquee-track marquee-left"
        style={`animation-duration: ${clients.row2.length * 5.5}s`}>
        {[...clients.row2, ...clients.row2].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- PROJECTS — tabs + expandable rows with image strip            -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="projects" class="projects-section">
    <div class="projects-tabs">
      {projectsData.map((tab, i) => (
        <button
          class:list={["projects-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {projectsData.map((tab, i) => (
      <div class:list={["projects-panel", { active: i === 0 }]} data-tab={tab.slug}>
        {tab.projects.length === 0 ? (
          <div class="projects-empty">No projects to show in this category yet.</div>
        ) : (
          <div class="projects-list">
            {tab.projects.map((project) => (
              <div class="project-row">
                <button class="project-summary" type="button">
                  <span class="project-title">{project.title.toUpperCase()}</span>
                  <span class="project-year">{project.year}</span>
                  <span class="project-description">{project.description}</span>
                </button>
                {project.images.length > 0 && (
                  <div class="project-images">
                    {project.images.map((img) => {
                      const stem = img.replace(/\.[^.]+$/, '');
                      return (
                        <img
                          src={`${stem}-1280w.webp`}
                          srcset={`${stem}-640w.webp 640w, ${stem}-828w.webp 828w, ${stem}-1280w.webp 1280w, ${stem}-2560w.webp 2560w`}
                          sizes="20vw"
                          alt={project.title}
                          loading="lazy" />
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- INFO (placeholder)                                            -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="info" class="info-section">
    <div class="info-content">
      <p class="info-paragraph">We are a collective of thought leaders who never settle for a singular method, but constantly explore new methods to make sense of our world.</p>
      <p class="info-paragraph">Powered by strategists, researchers, artists, academics, creative directors and designers, C-STUDIOS blends strategic thinking with aesthetics and cultural intelligence at the core of every project.</p>
      <p class="info-paragraph">Through our curatorial and stylistic lens, we conduct ongoing research and connect with real people, stories and contexts to deliver strategies, visuals and experiences that move culture forward. By translating insight into strategic action, we equip brands and organisations with the ideas, tools and frameworks to create meaningful, lasting impact.</p>
    </div>
  </section>

</Layout>

<!-- ════════════════════════════════════════════════════════════ -->
<!-- HERO STYLES (moon animation, slideshow, text)                 -->
<!-- ════════════════════════════════════════════════════════════ -->
<style is:global>
  :root { --vh: 1vh; }

  .container, .home-text, .sub-text, .moon, .flash-img {
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /* Base layout */
  #cstHero {
    position: relative;
    width: 100vw;
    height: calc(var(--vh) * 100);
    overflow: hidden;
    background: white;
  }

  .cst-stage {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: calc(var(--vh) * 100);
    z-index: 0;
  }

  .flash-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: calc(var(--vh) * 100) !important;
    object-fit: cover !important;
    object-position: center top !important;
    opacity: 0 !important;
    transition: opacity 1.2s ease-in-out !important;
    transform: scale(1) !important;
    z-index: 0;
    display: block !important;
    visibility: visible !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    max-width: none !important;
    max-height: none !important;
    min-width: 100vw !important;
    min-height: calc(var(--vh) * 100) !important;
  }

  .flash-img.active {
    opacity: 1 !important;
    transform: scale(1) !important;
    z-index: 1;
  }

  @supports (height: 100svh) {
    #cstHero, .cst-stage, .flash-img { height: 100svh; }
  }
  @supports (height: 100dvh) {
    #cstHero, .cst-stage, .flash-img { height: 100dvh; }
  }

  /* Text block */
  .container {
    position: absolute;
    top: 50%;
    left: 93vw;
    transform: translateY(-50%);
    white-space: nowrap;
    opacity: 1;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
    mix-blend-mode: difference;       /* text auto-adapts to slideshow photo brightness */
  }

  .text-centered {
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    justify-content: center;
    text-align: center;
  }

  .home-text, .sub-text {
    margin: 0;
    white-space: nowrap;
    text-transform: uppercase;
    font: 400 16px/1.2 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
    opacity: 0;
  }

  .home-text {
    transform: translateX(-100vw);
    animation: slideInLeft 2.5s cubic-bezier(0.645, 0.045, 0.355, 1) forwards;
    margin-right: 8px;
  }

  @keyframes slideInLeft {
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .sub-text span {
    font: inherit !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
    display: inline !important;
  }

  /* Moon */
  .moon {
    background: transparent;
    position: absolute;
    top: 50%;
    left: 100vw;
    width: calc(var(--vh) * 95);
    height: calc(var(--vh) * 95);
    border-radius: 50%;
    transform: translateY(-50%);
    z-index: 5;
    transition: transform 2.5s cubic-bezier(0.645, 0.045, 0.355, 1), opacity 1s ease-in;
    opacity: 1;
  }

  @supports (height: 100svh) { .moon { width: 95svh; height: 95svh; } }
  @supports (height: 100dvh) { .moon { width: 95dvh; height: 95dvh; } }

  /* Mask layers */
  .reveal-hole {
    position: absolute;
    inset: 0;
    background: #fff;
    z-index: 25;
    pointer-events: none;
    opacity: 1;
    transition: opacity .6s ease;
    --mx: 120vw;
    --my: 50vh;
    --mr: 0px;
    -webkit-mask: radial-gradient(circle var(--mr) at var(--mx) var(--my), transparent 98%, #000 100%);
            mask: radial-gradient(circle var(--mr) at var(--mx) var(--my), transparent 98%, #000 100%);
  }

  .hole-rim {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 26;
    pointer-events: none;
    border-radius: 50%;
    opacity: 1;
    transition: opacity .6s ease;
    box-shadow:
      inset 8px 8px 12px rgba(0,0,0,0.25),
      inset -4px -4px 8px rgba(255,255,255,0.9);
  }

  /* Mobile */
  @media (max-width: 767px) {
    #cstHero, .cst-stage, .flash-img {
      height: calc(var(--vh) * 100) !important;
    }

  .moon {
    background: transparent !important;
    width: 80vw !important;
    height: 80vw !important;
    left: 50% !important;
    top: auto !important;
    bottom: -40vw !important;
    transform: translate(-50%, 80vw) !important;
    transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease-out !important;
  }

    #cstHero .container.text-centered {
      left: 5vw !important;
      transform: translateY(-50%) !important;
      justify-content: flex-start !important;
      text-align: left !important;
    }
    .home-text, .sub-text {
      font-size: 0.7em !important;
      line-height: 1.25 !important;
      white-space: normal !important;
    }
    .sub-text { visibility: hidden; }
    .sub-text .line { display: block; }
    #cstHero .container {
      width: calc(100vw - 52px);
      color: white;
      display: block !important;
      left: 26px !important;
      top: 40vh !important;
      transform: none !important;
      z-index: 30 !important;
      align-items: flex-start !important;
    }
    .home-text {
      float: left;
      white-space: nowrap !important;
      margin: 0 8px 0 0 !important;
      line-height: 1.25 !important;
      font-size: 0.65rem !important;
    }
    .sub-text {
      display: block;
      white-space: normal !important;
      font-size: 0.65rem !important;
      line-height: 1.25 !important;
    }
    #cstHero .container::after {
      content: "";
      display: block;
      clear: both;
    }
    #cstHero { isolation: isolate; }
    .home-text, .sub-text {
      color: white;
      text-shadow: none !important;
      -webkit-text-stroke: 0 !important;
    }
    .flash-img {
      height: calc(var(--vh) * 100) !important;
      min-height: calc(var(--vh) * 100) !important;
    }
  }

  @media (min-width: 768px) {
    .sub-text {
      opacity: 0;
      transform: translateX(20vw);
      animation: slideInLeft 2s cubic-bezier(0.645,0.045,0.355,1) 1.5s forwards;
    }
    #textContainer {
      transition: left 1200ms cubic-bezier(0.22,1,0.36,1),
                  transform 1200ms cubic-bezier(0.22,1,0.36,1);
    }
  }

  #cstHero { isolation: isolate; }

  .cst-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.25);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity .35s ease;
  }

  .cst-stage:has(.flash-img.active)::after {
    opacity: 1;
  }

  .home-text, .sub-text {
    color: lightgrey;
    transition: color .3s ease;
  }
  /* Once slideshow is running, switch source to white so mix-blend produces max contrast */
  #cstHero:has(.flash-img.active) .home-text,
  #cstHero:has(.flash-img.active) .sub-text {
    color: #fff;
  }

  
  /* Per-image crop alignment overrides */
  .flash-img[data-align="center"]       { object-position: center center !important; }
  .flash-img[data-align="bottom"]       { object-position: center bottom !important; }
  .flash-img[data-align="left"]         { object-position: left center !important; }
  .flash-img[data-align="right"]        { object-position: right center !important; }
  .flash-img[data-align="top-left"]     { object-position: left top !important; }
  .flash-img[data-align="top-right"]    { object-position: right top !important; }
  .flash-img[data-align="bottom-left"]  { object-position: left bottom !important; }
  .flash-img[data-align="bottom-right"] { object-position: right bottom !important; }


  /* ════════════════════════════════════════════════════════════ */
  /* SERVICES section                                              */
  /* ════════════════════════════════════════════════════════════ */
  .services-section {
    height: 100vh;
    padding: 80px 0 40px;
    background: white;
    position: relative;
    z-index: 2;
    /* Grid lets all panels share the same area and overlap during transitions */
    display: grid;
    grid-template-areas: "tabs" "panels";
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }
 
 .services-tabs {
  grid-area: tabs;
  align-self: start;
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  margin-bottom: 40px;
  padding: 0 28px;
}
  .services-tab {
    background: none;
    border: none;
    padding: 0;
    color: lightgrey;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .services-tab:hover { color: grey; }
  .services-tab.active { color: #0a0a0a; }

  /* Directional carousel: panels slide left/right based on tab navigation direction.
     Smoother easing curve (easeInOutCubic) + longer duration for fluid motion. */
  .services-panel {
    grid-area: panels;
    transform: translateX(100%);     /* default parked off-screen right */
    visibility: hidden;
    pointer-events: none;
    z-index: 1;
    transition:
      transform 1s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0s 1s;
  }

  /* Pre-positioning for new panel entrance (set with .no-transition, then animate) */
  .services-panel.enter-from-right {
    transform: translateX(100%);
    visibility: visible;
  }
  .services-panel.enter-from-left {
    transform: translateX(-100%);
    visibility: visible;
  }

  /* Exit states — direction depends on whether new tab is to the LEFT or RIGHT */
  .services-panel.exit-left {
    transform: translateX(-100%);
    visibility: visible;
    z-index: 2;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .services-panel.exit-right {
    transform: translateX(100%);
    visibility: visible;
    z-index: 2;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .services-panel.active {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
    transition:
      transform 1s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0s 0s;
  }

  /* Skip transitions for instant positioning (pre-entrance, post-exit cleanup) */
  .services-panel.no-transition {
    transition: none !important;
  }

  /* Image grid — edge to edge, no gaps */
  .services-images {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    width: 100%;
    overflow: hidden;            /* clip images that start stacked off-screen */
  }
  .services-images img {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 45vh;
    object-fit: cover;
    display: block;
    position: relative;
  }







  .services-texts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 30px 40px 0;        /* text gets the side padding */
  }
  .services-column { padding-right: 30px; }
  .services-category {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0a0a0a;
    margin-bottom: 1rem;
  }
  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.7;
  }

  /* ─── Mobile: 2-column grid, same slide-from-stack logic per row ─── */
  @media (max-width: 768px) {
    .services-tabs { padding: 0 20px; gap: 16px; }
    .services-tabs::before, .services-tabs::after { display: none; }   /* no L on mobile */
    .services-tab { font-size: 0.7rem; }

    .services-images {
      grid-template-columns: repeat(2, 1fr);
    }


    .services-texts {
      grid-template-columns: repeat(2, 1fr);
      padding: 20px;
    }
    .services-list, .services-category { font-size: 0.7rem; }
  }

  /* ════════════════════════════════════════════════════════════ */
  /* CLIENTS — marquee                                             */
  /* ════════════════════════════════════════════════════════════ */
  .clients-section {
    height: 100vh;
    background: white;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;     /* logos anchor toward bottom */
    gap: 24px;                      /* tighter row gap */
    padding: 0 0 12vh 0;
    overflow: hidden;
  }
  .marquee {
    width: 100%;
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    /* No `gap` here — we use `margin-right` on each logo so the loop is seamless */
    width: max-content;
    align-items: center;
  }
  .marquee-track img {
    height: 120px;                   /* 1.2x size */
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    user-select: none;
    margin-right: 60px;              /* spacing on every logo, including the last */
  }
  /* Animation name only — duration is set inline based on row length */
  .marquee-right {
    animation-name: marquee-shift-right;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .marquee-left {
    animation-name: marquee-shift-left;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes marquee-shift-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes marquee-shift-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
  @media (max-width: 768px) {
    .clients-section { gap: 60px; }
    .marquee-track { gap: 60px; }
    .marquee-track img { height: 40px; }

  }

  /* ════════════════════════════════════════════════════════════ */
  /* ════════════════════════════════════════════════════════════ */
  /* INFO — dots animate into letters                               */
  /* ════════════════════════════════════════════════════════════ */
  .info-section {
    height: 100vh;
    width: 100%;
    background: white;
    position: relative;
    z-index: 2;
    overflow: hidden;
    /* No flex; absolute centering instead so the content position is fixed
       and immune to sub-pixel layout changes during the animation. */
  }
  .info-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* Match Header / Footer horizontal padding (20px from each edge) */
    width: calc(100% - 40px);
    max-width: 900px;
    /* Promote to its own compositor layer so descendant animations don't affect host layout */
    will-change: transform;
  }
  /* Three paragraphs — same style (no hierarchy), all caps, with breathing room between */
  .info-paragraph {
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.8;
    color: #0a0a0a;
    font-weight: 400;
    margin: 0 0 1.5em;
    max-width: 700px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .info-paragraph:last-child { margin-bottom: 0; }

  /* Letters fade in via pure opacity — no transform, no inline-block,
     so the spans don't affect the paragraph's baseline / line-height calculations.
     Pairs to each dot's dissolve timing. */
  .info-section .letter {
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .info-section .letter.reveal {
    opacity: 1;
  }

  /* The dots layer: absolute over .info-content; dots animate from random spots to their letter target */
  .info-dots-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .info-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 3px;
    background: #0a0a0a;
    border-radius: 50%;
    opacity: 0;
    transition:
      transform 1.4s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.5s ease;
  }
  /* When dissolving: slower fade + subtle scale up so dots "puff out" softly */
  /* (Not strictly used — phase 3 sets inline styles — but kept in sync as fallback) */
  .info-dot.dissolve {
    transition: opacity 1.6s ease, transform 1.6s ease;
    transform: scale(0);
    opacity: 0;
  }

  @media (max-width: 768px) {
    .info-manifesto { font-size: 18px; margin-bottom: 40px; }
    .info-body { font-size: 12px; }
  }

  /* PROJECTS — tabs + expandable rows                             */
  /* ════════════════════════════════════════════════════════════ */
  .projects-section {
    min-height: 100vh;
    padding: 80px 0 40px;
    background: white;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .projects-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 40px;
    padding: 0 28px;
  }
  .projects-tab {
    background: none;
    border: none;
    padding: 0;
    color: lightgrey;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .projects-tab:hover { color: grey; }
  .projects-tab.active { color: #0a0a0a; }

  .projects-panel {
    display: none;
  }
  .projects-panel.active {
    display: block;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .projects-panel.active::-webkit-scrollbar {
    width: 6px;
  }
  .projects-panel.active::-webkit-scrollbar-thumb {
    background: lightgrey;
    border-radius: 3px;
  }

  .projects-empty {
    padding: 0 28px;
    font-size: 0.85rem;
    color: lightgrey;
    font-style: italic;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-row {
    border-bottom: 1px solid #eee;
  }
  .project-row:first-child { border-top: 1px solid #eee; }

.project-summary {
  display: grid;
  grid-template-columns: 2fr 0.5fr 3fr;
  gap: 30px;
  width: 100%;
  padding: 0 28px;
  height: 56px;
  align-items: center;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  font: inherit;
  font-size: 0.8rem;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: #0a0a0a;
  transition: background 0.2s ease;
}
  .project-summary:hover { background: #fafafa; }
  .project-title {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .project-year { color: #0a0a0a; }
.project-description {
  color: #0a0a0a;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

  /* Expandable image strip — full viewport width, slides down on expand */
  .project-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    width: 100vw;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-row.expanded .project-images {
    max-height: 22vh;
  }
  .project-images img {
    width: 100%;
    height: 22vh;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .projects-tabs { padding: 0 20px; gap: 16p
    x; }
    .projects-tab { font-size: 0.7rem; }
    .project-summary {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 18px 20px;
      font-size: 0.7rem;
    }
    .project-images { grid-auto-columns: 100%; }
    .project-images img { height: 40vh; }
    .project-row.expanded .project-images { max-height: 40vh; }
  }

  /* ════════════════════════════════════════════════════════════ */
  /* LIBRARY PREVIEW GRID                                          */
  /* ════════════════════════════════════════════════════════════ */
  @media (max-width: 768px) {
  }
</style>

<!-- ════════════════════════════════════════════════════════════ -->
<!-- HERO SCRIPT (moon, slideshow, text animation)                 -->
<!-- ════════════════════════════════════════════════════════════ -->
<script is:inline>
function prepareMobileSubtextEarly() {
  const isPhone = window.matchMedia('(max-width: 767px)').matches;
  if (!isPhone) return;
  const sub = document.getElementById('subText');
  if (!sub) return;
  sub.innerHTML =
    '<span class="line">IS A CREATIVE STRATEGY STUDIO </span>' +
    '<span class="line">WORKING ACROSS CULTURAL RESEARCH, </span>' +
    '<span class="line">CONCEPTS, CREATIVE DIRECTION, CONSULTING, AND CURATION.</span>';
  sub.style.opacity = '0';
  sub.style.transform = 'translateX(140vw)';
  sub.style.visibility = 'hidden';
}

function swapMobileImages() {
  if (!window.matchMedia('(max-width: 767px)').matches) return;
  const mobileUrls = [];
  document.querySelectorAll('#flashSequence .flash-img').forEach(img => {
    const m = img.getAttribute('data-mobile');
    if (m && img.src !== m) {
      mobileUrls.push(m);
      img.src = m;
      img.loading = 'eager';
    }
  });
  mobileUrls.slice(0, 3).forEach(url => {
    const preloadImg = new Image();
    preloadImg.src = url;
  });
}

function setRealVH() {
  const vh = window.innerHeight * 0.01;
  document.documentElement.style.setProperty('--vh', `${vh}px`);
  if (window.innerWidth <= 767) {
    document.body.style.overflow = 'hidden';
    document.documentElement.style.transform = 'translateZ(0)';
  }
}

function syncHoleToMoon(durationMs = 5000) {
  const moon = document.querySelector('.moon');
  const hole = document.getElementById('revealHole');
  const rim = document.getElementById('holeRim');
  if (!moon || !hole || !rim) return;
  let start = performance.now();
  function tick(now) {
    const r = moon.getBoundingClientRect();
    const cx = r.left + r.width/2;
    const cy = r.top + r.height/2;
    const radius = r.width/2;
    hole.style.setProperty('--mx', cx + 'px');
    hole.style.setProperty('--my', cy + 'px');
    hole.style.setProperty('--mr', radius + 'px');
    rim.style.width = r.width + 'px';
    rim.style.height = r.height + 'px';
    rim.style.left = (cx - radius) + 'px';
    rim.style.top = (cy - radius) + 'px';
    if (now - start < durationMs) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
window.scrollTo(0, 0);

function startSlideshow() {
  const images = document.querySelectorAll('#flashSequence .flash-img');
  if (!images.length) return;
  images.forEach(img => {
    const isMobile = window.innerWidth <= 767;
    const heightValue = isMobile ? 'calc(var(--vh) * 100)' : '100vh';
    img.style.cssText += `
      opacity: 0 !important;
      transition: opacity 1.2s ease-in-out !important;
      z-index: 0 !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: ${heightValue} !important;
      object-fit: cover !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100vw !important;
      min-height: ${heightValue} !important;
      transform: scale(1) !important;
    `;
  });

  let current = 0;
  images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
  images[current].classList.add('active');

  setInterval(() => {
    const prev = current;
    current = (current + 1) % images.length;
    images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
    images[current].classList.add('active');
    setTimeout(() => {
      images[prev].style.cssText += 'opacity: 0 !important; z-index: 0 !important;';
      images[prev].classList.remove('active');
    }, 600);
  }, 1200);
}

// Main animation sequence
setTimeout(() => {
  prepareMobileSubtextEarly();
  swapMobileImages();
  setRealVH();

  // Skip intro on revisits — go straight to slideshow loop
  let introSeen = false;
  try { introSeen = sessionStorage.getItem('cst-intro-seen') === 'true'; } catch (e) {}
  if (introSeen) {
    const moon = document.querySelector('.moon');
    if (moon) moon.style.display = 'none';
    const hole = document.getElementById('revealHole');
    if (hole) hole.style.display = 'none';
    const rim = document.getElementById('holeRim');
    if (rim) rim.style.display = 'none';
    const hero = document.getElementById('cstHero');
    if (hero) hero.style.backgroundColor = 'transparent';
    startSlideshow();
    return;
  }


// MOBILE: no moon animation, slideshow plays immediately
  if (window.innerWidth <= 767) {
    const moonEl = document.querySelector('.moon');
    const heroEl = document.getElementById('cstHero');
    const holeEl = document.getElementById('revealHole');
    const rimEl = document.getElementById('holeRim');

    // Hide all moon-related elements
    if (moonEl) moonEl.style.display = 'none';
    if (holeEl) holeEl.style.display = 'none';
    if (rimEl) rimEl.style.display = 'none';
    if (heroEl) heroEl.style.backgroundColor = 'transparent';

    // Start slideshow right away
    startSlideshow();

    // Slide subText in from the right
    setTimeout(() => {
      const subText = document.getElementById('subText');
      if (subText) {
        subText.style.visibility = 'visible';
        subText.style.transform = 'translateX(140vw)';
        subText.style.opacity = '0';
        void subText.offsetHeight;
        subText.style.transition = 'transform 900ms cubic-bezier(0.22,1,0.36,1), opacity 900ms ease-out';
        subText.style.transform = 'translate3d(0,0,0)';
        subText.style.opacity = '1';
      }
    }, 600);

    try { sessionStorage.setItem('cst-intro-seen', 'true'); } catch (e) {}
    return;
  }

  setTimeout(() => {
    const isPhone = window.innerWidth <= 767;
    const subText = document.getElementById('subText');
    if (isPhone && subText) {
      subText.style.visibility = 'visible';
      subText.style.transform = 'translateX(140vw)';
      subText.style.opacity = '0';
      subText.offsetHeight;
      subText.style.transition = 'transform 900ms cubic-bezier(0.22,1,0.36,1), opacity 900ms ease-out';
      subText.style.transform = 'translate3d(0,0,0)';
      subText.style.opacity = '1';
    }
  }, 2500);
}, 100);

let resizeTimeout;
window.addEventListener('resize', () => {
  if (resizeTimeout) return;
  resizeTimeout = setTimeout(() => {
    setRealVH();
    resizeTimeout = null;
  }, 100);
}, { passive: true });

window.addEventListener('orientationchange', setRealVH, { passive: true });

document.addEventListener('DOMContentLoaded', () => {
  const mqPhone = window.matchMedia('(max-width: 767px)');
  const imgs = Array.from(document.querySelectorAll('#flashSequence .flash-img'));

  imgs.forEach(img => {
    if (!img.dataset.desktop) {
      img.dataset.desktop = img.getAttribute('src') || '';
      img.dataset.desktopSrcset = img.getAttribute('srcset') || '';
    }
  });

  function applyResponsiveImages() {
    imgs.forEach(img => {
      const desktop = img.dataset.desktop || '';
      if (!mqPhone.matches) {
        if (desktop && img.src.indexOf(desktop) === -1) {
          img.src = desktop;
          const deskSet = img.dataset.desktopSrcset || '';
          if (deskSet) img.srcset = deskSet;
        }
      }
    });
  }
  applyResponsiveImages();
  mqPhone.addEventListener('change', applyResponsiveImages);
});

document.addEventListener('DOMContentLoaded', () => {
  if (window.innerWidth < 768) return;
  const container = document.getElementById('textContainer');
  const sub = document.querySelector('.sub-text');
  if (!container || !sub) return;
  const onSubDone = (e) => {
    if (e.target !== sub) return;
    requestAnimationFrame(() => container.classList.add('text-centered'));
    sub.removeEventListener('animationend', onSubDone);
  };
  sub.addEventListener('animationend', onSubDone);
});

// ════════════════════════════════════════════════════════════
// PROJECTS — tab switching + expandable rows
// ════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  // Tab switching
  const pTabs = document.querySelectorAll('.projects-tab');
  const pPanels = document.querySelectorAll('.projects-panel');
  pTabs.forEach((tab) => {
    tab.onclick = () => {
      const target = tab.getAttribute('data-target');
      pTabs.forEach((t) => t.classList.toggle('active', t === tab));
      pPanels.forEach((p) => {
        p.classList.remove('active');
        void p.offsetWidth;
        if (p.getAttribute('data-tab') === target) p.classList.add('active');
      });
    };
  });

  // Row expand / collapse on click of the summary button
  document.querySelectorAll('.project-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.project-row');
      if (!row) return;
      const isOpen = row.classList.contains('expanded');
      // Close any other open rows in the same panel
      row.parentElement?.querySelectorAll('.project-row.expanded').forEach((r) => {
        if (r !== row) r.classList.remove('expanded');
      });
      row.classList.toggle('expanded', !isOpen);
    });
  });
});

// ════════════════════════════════════════════════════════════
// SERVICES tabs — wired here because this script runs reliably
// ════════════════════════════════════════════════════════════
// Align services tabs with SERVICES menu link + compute L branch position
function alignServicesTabs() {
  const link = document.querySelector('[data-key="services"]');
  const tabsEl = document.querySelector('.services-tabs');
  if (!link || !tabsEl) return;
  const rect = link.getBoundingClientRect();
  const styles = getComputedStyle(link);
  const padLeft = parseFloat(styles.paddingLeft) || 0;
  const padRight = parseFloat(styles.paddingRight) || 0;
  const textLeft = rect.left + padLeft;
  const textRight = rect.right - padRight;
  const textCenter = (textLeft + textRight) / 2;
  document.documentElement.style.setProperty('--services-tabs-x', textLeft + 'px');
  document.documentElement.style.setProperty('--services-link-center-x', textCenter + 'px');
}
window.addEventListener('load', alignServicesTabs);
window.addEventListener('resize', alignServicesTabs);
setTimeout(alignServicesTabs, 200);


// ═══════════════════════════ INFO: dots → letters ═══════════════════════════
function setupInfoReveal() {
  console.log('[info] setupInfoReveal start');
  const section = document.getElementById('info');
  if (!section) { console.warn('[info] no #info section'); return; }
  const contentEl = section.querySelector('.info-content');
  if (!contentEl) { console.warn('[info] no .info-content'); return; }

  // Wrap every non-space char into <span class="letter">
  const paragraphs = contentEl.querySelectorAll('p');
  let letterCount = 0;
  paragraphs.forEach((p) => {
    if (p.dataset.split === 'true') return;
    const text = p.textContent || '';
    p.textContent = '';
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (ch === ' ') {
        p.appendChild(document.createTextNode(' '));
      } else {
        const span = document.createElement('span');
        span.className = 'letter';
        span.textContent = ch;
        p.appendChild(span);
        letterCount++;
      }
    }
    p.dataset.split = 'true';
  });
  console.log('[info] wrapped letters:', letterCount);

  let triggered = false;

  function runAnimation() {
    if (triggered) return;
    triggered = true;
    console.log('[info] triggering animation');

    // Wait two rAFs to ensure all layout/font measurements are stable
    requestAnimationFrame(() => requestAnimationFrame(() => {
      const letters = Array.from(contentEl.querySelectorAll('.letter'));
      if (!letters.length) { console.warn('[info] no letters to animate'); return; }
      const contentRect = contentEl.getBoundingClientRect();
      const sectionRect = section.getBoundingClientRect();

      // Dots layer overlay
      const dotsLayer = document.createElement('div');
      dotsLayer.className = 'info-dots-layer';
      contentEl.appendChild(dotsLayer);

      // Build dot data — random initial positions over the whole section
      const dots = letters.map((letter) => {
        const lr = letter.getBoundingClientRect();
        // For uppercase text with line-height: 1.8, the letter glyph sits in the upper
        // portion of the bounding rect (above the baseline). Using a 0.62 multiplier
        // instead of 0.5 places the dot at the visual middle of the letter glyph,
        // close to the baseline area where the eye naturally reads the letter.
        const targetX = (lr.left + lr.width / 2) - contentRect.left - 1.5;
        const targetY = (lr.top + lr.height * 0.62) - contentRect.top - 1.5;
        // Random initial position relative to dotsLayer
        const startX = (Math.random() * sectionRect.width) - (contentRect.left - sectionRect.left);
        const startY = (Math.random() * sectionRect.height) - (contentRect.top - sectionRect.top);
        return { letter, targetX, targetY, startX, startY };
      });

      // Place all dots at their start positions (no transition yet)
      dots.forEach((d) => {
        const dot = document.createElement('div');
        dot.className = 'info-dot';
        dot.style.transform = `translate(${d.startX}px, ${d.startY}px)`;
        dotsLayer.appendChild(dot);
        d.dot = dot;
      });

      // Force reflow so the start positions apply before we animate
      void dotsLayer.offsetWidth;

      // Phase 1: dots fade in at random positions (small per-dot stagger)
      dots.forEach((d) => {
        const delay = Math.random() * 250;
        setTimeout(() => { d.dot.style.opacity = '1'; }, delay);
      });

      // Phase 2: 400ms later, animate each dot to its letter target
      setTimeout(() => {
        dots.forEach((d) => {
          const delay = Math.random() * 300;
          setTimeout(() => {
            d.dot.style.transform = `translate(${d.targetX}px, ${d.targetY}px)`;
          }, delay);
        });
      }, 400);

      // Phase 3: ~2100ms — dots have settled at letter positions, now morph individually.
      // Each (dot, letter) pair morphs at a random moment within a wide stagger window.
      // We set inline styles directly because inline beats class rules — the .dissolve class
      // was being overridden by the inline opacity/transform we set in earlier phases.
      setTimeout(() => {
        const STAGGER_MAX = 2800;
        dots.forEach((d) => {
          const delay = Math.random() * STAGGER_MAX;
          setTimeout(() => {
            // Slow fade-out for the dot (inline transition + opacity, beats CSS class)
            d.dot.style.transition = 'opacity 1.6s ease, transform 1.6s ease';
            d.dot.style.opacity = '0';
            // Shrink to nothing while fading — feels like the dot collapses into the letter
            const currentTransform = d.dot.style.transform || '';
            d.dot.style.transform = currentTransform + ' scale(0)';
            // Reveal the matching letter at the same moment
            d.letter.classList.add('reveal');
          }, delay);
        });
        // Don't remove dotsLayer from DOM (DOM mutation can cause sub-pixel shifts).
        // Dots are at opacity 0; the layer has pointer-events: none, so it's harmless to keep.
      }, 2100);
    }));
  }

  // Observer — fire as soon as any of the section is visible.
  // Explicit root: null forces viewport-based observation regardless of ancestor overflow.
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      console.log('[info] IO entry:', e.isIntersecting, 'ratio:', e.intersectionRatio);
      if (e.isIntersecting) {
        runAnimation();
        io.disconnect();
        window.removeEventListener('scroll', scrollFallback);
      }
    });
  }, { root: null, threshold: 0, rootMargin: '0px' });
  io.observe(section);

  // Fallback: scroll listener that checks if section is in viewport.
  // Triggers in case IntersectionObserver doesn't fire (e.g., due to nested overflow contexts).
  function scrollFallback() {
    const rect = section.getBoundingClientRect();
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      console.log('[info] scroll fallback triggered animation');
      runAnimation();
      window.removeEventListener('scroll', scrollFallback);
      io.disconnect();
    }
  }
  window.addEventListener('scroll', scrollFallback, { passive: true });

  // Also check on page load in case section is already in viewport
  setTimeout(scrollFallback, 100);

  console.log('[info] observer attached');
}

document.addEventListener('DOMContentLoaded', () => {
  setupInfoReveal();
  alignServicesTabs();
  const sTabs = document.querySelectorAll('.services-tab');
  const sPanels = document.querySelectorAll('.services-panel');
  sTabs.forEach((tab) => {
    tab.onclick = () => {
      const target = tab.getAttribute('data-target');
      const currentPanel = document.querySelector('.services-panel.active');
      const newPanel = document.querySelector(`.services-panel[data-tab="${target}"]`);

      if (!newPanel || currentPanel === newPanel) return;

      // Determine direction based on tab order: new to the RIGHT → slide everything LEFT
      const allPanels = Array.from(sPanels);
      const newIdx = allPanels.indexOf(newPanel);
      const currentIdx = currentPanel ? allPanels.indexOf(currentPanel) : -1;
      const movingRight = newIdx > currentIdx;   // clicking a tab to the right

      // Tab button highlights
      sTabs.forEach((t) => t.classList.toggle('active', t === tab));

      // Clean up any lingering states on unrelated panels
      allPanels.forEach((p) => {
        if (p !== currentPanel && p !== newPanel) {
          p.classList.remove('active', 'exit-left', 'exit-right', 'enter-from-left', 'enter-from-right');
        }
      });

      if (currentPanel) {
        currentPanel.classList.remove('active');
        // Old panel exits in the direction matching the navigation
        currentPanel.classList.add(movingRight ? 'exit-left' : 'exit-right');

        // After the slide completes, park it (invisibly) back to default off-screen-right
        setTimeout(() => {
          const panel = currentPanel;
          panel.classList.add('no-transition');
          panel.classList.remove('exit-left', 'exit-right');
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              panel.classList.remove('no-transition');
            });
          });
        }, 1050);
      }

      // Position the new panel on the correct side BEFORE animating it to center
      newPanel.classList.remove('exit-left', 'exit-right');
      newPanel.classList.add('no-transition');
      newPanel.classList.add(movingRight ? 'enter-from-right' : 'enter-from-left');
      void newPanel.offsetWidth;   // force the browser to apply the starting position

      // Trigger the entrance animation
      newPanel.classList.remove('no-transition', 'enter-from-right', 'enter-from-left');
      newPanel.classList.add('active');
    };
  });

  // L-branch animation: trigger when SERVICES section comes into view
  const servicesSection = document.getElementById('services');
  const tabsEl = document.querySelector('.services-tabs');
  if (servicesSection && tabsEl) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
          // Force restart by removing then re-adding the class
          tabsEl.classList.remove('l-drawn');
          void tabsEl.offsetWidth;
          tabsEl.classList.add('l-drawn');
        } else if (!entry.isIntersecting) {
          tabsEl.classList.remove('l-drawn');
        }
      });
    }, { threshold: [0, 0.5, 1] });
    obs.observe(servicesSection);
  }
});
</script>