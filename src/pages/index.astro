  /* CLIENTS — marquee                                             */
  /* ════════════════════════════════════════════════════════════ */
  .clients-section {
    height: 100vh;
    background: white;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;     /* logos anchor toward bottom */
    gap: 24px;                      /* tighter row gap */
    padding: 0 0 20vh 0;
    overflow: hidden;
  }
  .marquee {
    width: 100%;
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    /* No `gap` here — we use `margin-right` on each logo so the loop is seamless */
    width: max-content;
    align-items: center;
  }
  .marquee-track img {
    height: 120px;                   /* 1.2x size */
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    user-select: none;
    margin-right: 60px;              /* spacing on every logo, including the last */
  }
  /* Animation name only — duration is set inline based on row length */
  .marquee-right {
    animation-name: marquee-shift-right;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .marquee-left {
    animation-name: marquee-shift-left;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes marquee-shift-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes marquee-shift-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
  @media (max-width: 768px) {
      .clients-section {
    justify-content: center;   /* sit in the middle of the section, not the bottom */
    padding: 0;                /* drop the desktop 12vh bottom padding */
    gap: 16px;                 /* slightly tighter row gap than desktop */
  }
  .marquee-track img {
    height: 70px;
    margin-right: 32px;        /* logos are smaller, tighten spacing to match */
  }

    .marquee-track { gap: 0; }
    .marquee-track img { height: 70px; }

  }

