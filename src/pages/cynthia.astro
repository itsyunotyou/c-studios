<script is:inline define:vars={{ referencesJSON, projectsJSON, placeholderRefsJSON, curatedRefsJSON }}>
  // Inject references data (cylinder cards) + cynthia-specific maps.
  const REFS = JSON.parse(referencesJSON);
  const CYN_PROJECTS = JSON.parse(projectsJSON);
  const CYN_PLACEHOLDER_REFS = JSON.parse(placeholderRefsJSON);
  const CYN_CURATED_REFS = JSON.parse(curatedRefsJSON);
// ── CANVAS ────────────────────────────────────────────────────────────────────
const bgCvs = document.getElementById('bg-canvas');
const bgCtx = bgCvs.getContext('2d');
const cvs   = document.getElementById('grid-canvas');
const ctx   = cvs.getContext('2d');

let W, H;
let tiles=[], particles=[], floaters=[];
let state='grid';
let gridScrollY=0, gridScrollMax=0;
let animFrame, phase=0, revealPhase=0;
let activeFilter='all', activeSort='color';
let sortedRefs=[], currentRefIdx=0, selectedRef=null;

const imgCache=new Map();
// Single reusable offscreen canvas for pixel dissolve
const _oc=document.createElement('canvas');
const _oc2=_oc.getContext('2d');
// ── Multi-image support ───────────────────────────────────────────────────────
const imgCacheExtra=new Map();
function getImgAt(ref, idx){
  if(idx===0) return getImg(ref); // main image
  const imgs=ref.images;
  if(!imgs||!imgs[idx-1]) return getImg(ref); // fallback
  const key=ref.title+':'+idx;
  if(imgCacheExtra.has(key)) return imgCacheExtra.get(key);
  const im=new window.Image(); im.src=imgs[idx-1];
  imgCacheExtra.set(key,im); return im;
}
function imgCount(ref){ return 1+(ref.images?ref.images.length:0); }

// LRU-evicting image cache — caps memory at 1000-entry scale.
const IMG_CACHE_MAX=200;
function getImg(ref){
  if(!ref||!ref.img)return null;
  if(imgCache.has(ref)){
    const im=imgCache.get(ref);
    // refresh LRU position
    imgCache.delete(ref); imgCache.set(ref,im);
    return im;
  }
  // evict oldest entry if at cap
  if(imgCache.size>=IMG_CACHE_MAX){
    imgCache.delete(imgCache.keys().next().value);
  }
  const im=new window.Image(); im.src=ref.img;
  imgCache.set(ref,im); return im;
}

// Larger variant used only by the coverflow / row view. Lazy-loaded per ref —
// the cylinder never touches this, so its preload stays small.
const largeCache=new Map();
function getLargeImg(ref){
  if(!ref||!ref.imgLarge) return getImg(ref);
  if(largeCache.has(ref)) return largeCache.get(ref);
  const im=new window.Image(); im.src=ref.imgLarge;
  largeCache.set(ref,im); return im;
}
function preloadImages(){ REFS.forEach(r=>{ getImg(r); if(r.images) r.images.forEach((_,i)=>getImgAt(r,i)); }); }

// Flicker state per tile: which image index showing
const flickerIdx=new Map();
let flickerT=0;
const FLICKER_INTERVAL=90; // frames between flicks

function getFlickerImg(ref){
  const n=imgCount(ref);
  if(n<=1) return getImg(ref);
  let idx=flickerIdx.get(ref)||0;
  return getImgAt(ref,idx);
}

// Larger version for the row/coverflow view. Single-image refs get the
// 800w -large.webp; multi-image refs stay on the cycling thumbs since
// they swap too fast for the larger load to be worth it.
function getFlickerImgLarge(ref){
  const n=imgCount(ref);
  if(n<=1) return getLargeImg(ref);
  let idx=flickerIdx.get(ref)||0;
  return getImgAt(ref,idx);
}

function tickFlicker(){
  flickerT++;
  if(flickerT%FLICKER_INTERVAL===0){
    for(const t of tiles){
      const n=imgCount(t.ref);
      if(n>1){
        const cur=flickerIdx.get(t.ref)||0;
        flickerIdx.set(t.ref,(cur+1)%n);
      }
    }
  }
}

function drawRef(ref,x,y,w,h,alpha,imgOverride){
  if(alpha<=0)return;
  const im=imgOverride||getImg(ref);
  ctx.save(); ctx.globalAlpha=alpha;
  if(im&&im.complete&&im.naturalWidth>0){
    // Crop to fill — centre crop, no squash
    const iw=im.naturalWidth, ih=im.naturalHeight;
    const scale=Math.max(w/iw, h/ih);
    const sw=w/scale, sh=h/scale;
    const sx=(iw-sw)/2, sy=(ih-sh)/2;
    ctx.drawImage(im, sx, sy, sw, sh, x, y, w, h);
  } else {
    ctx.fillStyle=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
    ctx.fillRect(x,y,w,h);
  }
  ctx.restore();
}

let cfScrollX=0, cfScrollVel=0;
let cfDragging=false, cfDragX=0;
function getCF(){ const sz=Math.min(220,W*0.24,H*0.34); return{sz,spread:sz*0.78,cx:W/2,cy:H/2}; }
function cfPos(off){ const{sz,spread,cx,cy}=getCF(); return{x:cx-sz/2+off*spread+cfScrollX,y:cy-sz/2,sz}; }

function hue(r,g,b){
  r/=255;g/=255;b/=255;
  const mx=Math.max(r,g,b),mn=Math.min(r,g,b),d=mx-mn;
  if(!d)return 0;
  let h;
  if(mx===r)h=((g-b)/d+6)%6; else if(mx===g)h=(b-r)/d+2; else h=(r-g)/d+4;
  return h/6;
}
function sortRefs(src){
  const s=[...src];
  if(activeSort==='color')return s.sort((a,b)=>hue(...a.color)-hue(...b.color));
  if(activeSort==='year') return s.sort((a,b)=>parseInt(a.year)-parseInt(b.year));
  return s.sort((a,b)=>a.title.localeCompare(b.title));
}

const GAP=3;
// Cynthia overrides: leave room for the top info bar (nav 56 + bigger
// info bar ~92 = ~148 desktop) and the bottom reference strip + scrubber
// + footer (220 strip + 60 footer = 280, plus scrubber clearance).
// (Mobile is unused — cynthia is desktop-only.)
const HEADER_H = window.innerWidth <= 767 ? 160 : 170;
const FOOTER_H = window.innerWidth <= 767 ? 220 : 340;
const GRID_H=()=>H-HEADER_H-FOOTER_H; // usable height for cylinder
let popInStart=null;
const POP_DURATION=600; // ms per tile fade in
const POP_STAGGER=40;  // ms between tiles

let gridSize='large';
function getGridRows(){
  // Cynthia uses 3 rows — bigger cards than library's grid.
  return 3;
}

function buildGrid(){
  const src=activeFilter==='all'?REFS:REFS.filter(r=>(r.cat||'').toLowerCase()===activeFilter.toLowerCase());
  sortedRefs=sortRefs(src);
  const N=sortedRefs.length;
  const ROWS=getGridRows();
  const TILE=Math.floor(GRID_H()/ROWS);
  const totalW=Math.ceil(N/ROWS)*TILE;
  tiles=sortedRefs.map((ref,i)=>({ref,
    x:Math.floor(i/ROWS)*TILE+GAP/2, y:HEADER_H+(i%ROWS)*TILE+GAP/2,
       sz:TILE-GAP, tw:TILE-GAP, th:TILE-GAP, color:ref.color,
    popDelay:Math.random()*2500})); // random stagger up to 2.5s — wider for clear sequential reveal
  gridScrollMax=Math.max(0, totalW-W);
  gridScrollY=0;
  popInStart=performance.now();
  cylPopStart=performance.now();   // trigger cylinder pop-in animation (incl. initial load)
}

// ── 3D Cylinder state ──────────────────────────────────────────────────────
let cylAngle=0, cylVel=0, cylDragging=false, cylDragX=0;
let autoRotate = true;
let cylHoverIdx=-1, cylHoverX=0, cylHoverY=0, cylHoverRotT=0;
let cylPopStart=null;

function drawCylinder(){
  const now=performance.now();
  const ROWS=getGridRows();
  // Tile height fills viewport exactly
  const TILE=Math.floor(GRID_H()/ROWS);

  // Radius: front face fills viewport width
  // At front (z3=R), scale = FOCAL/(FOCAL+R-R) = 1, so tileW = TILE
  // We want ~(W/TILE) tiles visible across front half of cylinder
  // Circumference = 2*PI*R, front half arc = PI*R
  // Tiles in front half = PI*R/TILE = W/TILE => R = W/PI
  const R=W/Math.PI*2.2;
  const FOCAL=R*0.55; // focal length relative to radius feels good

  const CY=HEADER_H+GRID_H()/2;
  const CX=W/2;

  const N=sortedRefs.length;
  // One column per ceil(N/ROWS) — never expand to fill 360° via i%N wrap,
  // which was visually duplicating cards on the cylinder.
  const COLS=Math.max(1, Math.ceil(N/ROWS));
  const anglePerCol=(2*Math.PI)/COLS;

  const drawn=[];
  for(let col=0;col<COLS;col++){
    const tileAngle=col*anglePerCol + cylAngle;
    const x3=Math.sin(tileAngle)*R;
    const z3=Math.cos(tileAngle)*R;
    if(z3<0) continue; // back-facing
    const scale=FOCAL/(FOCAL+R-z3);
    const screenX=CX + x3*scale;

    for(let row=0;row<ROWS;row++){
      const i=col*ROWS+row;
      if(i>=N) continue;            // no wrap — gaps preferred over dupes
      const ref=sortedRefs[i];
      const tile=tiles[i];
      if(!ref) continue;
      const screenY=CY + (row-(ROWS-1)/2)*TILE*scale;
      const tileW=TILE*scale;
      const tileH=TILE*scale;
      const delay=tile?tile.popDelay:Math.random()*1200;
      const elapsed=cylPopStart?(performance.now()-cylPopStart)-delay:Infinity;
      const growT=Math.max(0,Math.min(1,elapsed/450));
      const alpha=growT>0?1:0;
      const popScale=cylPopStart?(0.01+0.99*growT):1;
      drawn.push({ref,screenX,screenY,tileW,tileH,z3,alpha,i,scale,popScale});
    }
  }

  drawn.sort((a,b)=>a.z3-b.z3);

  for(const d of drawn){
    const{ref,screenX,screenY,tileW,tileH,alpha,scale,popScale=1}=d;
    const g=GAP*scale;
    const ps=popScale; // scale from dot to full
    const isHovered=cylHoverIdx===d.i;

    if(isHovered) cylHoverRotT=Math.min(1, cylHoverRotT+0.08);

    const x=screenX-tileW*ps/2+g*ps/2;
    const y=screenY-tileH*ps/2+g*ps/2;
    const w=(tileW-g)*ps, h=(tileH-g)*ps;

    // Depth-based alpha — front tiles full opacity, sides fade to ~15%
    const depthAlpha=alpha*(0.1+0.9*Math.pow(d.z3/R, 2.5));

    if(isHovered && cylHoverRotT>0){
      const sc=1+cylHoverRotT*0.1;
      const hw=(tileW-g)*sc, hh=(tileH-g)*sc;
      const hx=screenX-hw/2, hy=screenY-hh/2;
      ctx.save();
      ctx.globalAlpha=depthAlpha;
      const im=getImg(ref)||getFlickerImg(ref);
      if(im&&im.complete&&im.naturalWidth>0){
        const iw=im.naturalWidth,ih=im.naturalHeight;
        const s2=Math.max(hw/iw,hh/ih);
        const sw=hw/s2,sh=hh/s2,sx=(iw-sw)/2,sy=(ih-sh)/2;
        ctx.drawImage(im,sx,sy,sw,sh,hx,hy,hw,hh);
      } else {
        ctx.fillStyle=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
        ctx.fillRect(hx,hy,hw,hh);
      }
      ctx.restore();
      d.sx=hx; d.sy=hy; d.sw=hw; d.sh=hh;
    } else {
      drawRef(ref,x,y,w,h,depthAlpha,getFlickerImg(ref));
    }
    d.sx=x; d.sy=y; d.sw=w; d.sh=h;
  }

  // Decay hover when nothing hovered
  if(cylHoverIdx===-1) cylHoverRotT=Math.max(0, cylHoverRotT-0.1);

  drawnCylTiles=drawn;
}

let drawnCylTiles=[];
let hoverRaf;
const headerInfo=document.getElementById('header-info');
function updateHoverInfo(mx,my){
  if(state!=='grid') return;
  let found=null;
  for(const d of [...drawnCylTiles].reverse()){
    if(mx>=d.sx&&mx<=d.sx+d.sw&&my>=d.sy&&my<=d.sy+d.sh){ found=d; break; }
  }
  if(found) updateMeta(found.ref);
  else updateMetaEmpty();
}

function updateMetaEmpty(){
  const panel=document.getElementById('info-panel');
  const fields=[['Title',''],['Creator',''],['Year',''],['Added by',''],['Category','']];
  panel.innerHTML=fields.map(([label,val])=>
    `<div class="info-row"><span class="info-label">${label}</span><span class="info-value">${val}</span></div>`
  ).join('');
}
window.addEventListener('mousemove',e=>{
  if(state==='grid') updateHoverInfo(e.clientX,e.clientY);
});

function resize(){
  const rect = cvs.getBoundingClientRect();
W = cvs.width = bgCvs.width = Math.round(rect.width);
H = cvs.height = bgCvs.height = Math.round(rect.height);
  cvs.style.height = H + 'px';
  bgCvs.style.height = H + 'px';
  if(state==='grid')buildGrid();
  if(state==='floated'||state==='exploding'){rebuildFloaters();buildHitTargets();}
}
function draw(){
  ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
  if(state==='grid'){
      drawCylinder();
      if(!cylDragging){
        if(autoRotate) cylAngle += 0.0005;   // slow ambient rotation
        cylAngle+=cylVel;
        cylVel*=0.96;
      }
      return;
  }
  if(state==='returning'){
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  } else {
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  }
  // Draw particles — pure X/Y, no Z perspective
  for(const p of particles){
    if(!p.visible) continue;
    const im=getImg(p.ref);
    ctx.save();
    ctx.globalAlpha=p.alpha;
    ctx.translate(p.x+p.sz/2, p.y+p.sz/2);
    ctx.rotate(p.rot);
    if(im&&im.complete&&im.naturalWidth>0){
      ctx.drawImage(im,-p.sz/2,-p.sz/2,p.sz,p.sz);
    } else {
      ctx.fillStyle=`rgb(${p.color[0]},${p.color[1]},${p.color[2]})`;
      ctx.fillRect(-p.sz/2,-p.sz/2,p.sz,p.sz);
    }
    ctx.restore();
  }
  if(floaters.length>0){
    if(state==='returning'){
      // Draw at animated positions directly — don't recalculate from coverflow
      for(const f of floaters){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);
        const fx=f.x+(f.sz-fw)/2;
        const fy=f.y+(f.sz-fh)/2;
        drawRef(f.ref,fx,fy,fw,fh,f.alpha,getFlickerImgLarge(f.ref));
      }
    } else {
      const{sz,cx,cy}=getCF();
      const GAP_CF=18;

      function cardWidth(f){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        return fh+(natW-fh)*(f.reveal||0);
      }

      const centre=floaters.find(f=>f.offset===0);
      const cw=centre?cardWidth(centre):sz;

      for(const f of [...floaters].sort((a,b)=>a.offset-b.offset)){
        const sc=f.offset===0?1.7:1.0;
        const fh=f.sz*sc;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);

        let fx=cx-fw/2;
        if(f.offset!==0){
          const dir=Math.sign(f.offset);
          let accum=cw/2+GAP_CF;
          for(let o=dir;Math.abs(o)<Math.abs(f.offset);o+=dir){
            const nb=floaters.find(n=>n.offset===o);
            if(nb) accum+=cardWidth(nb)+GAP_CF;
          }
          fx=dir>0 ? cx+accum : cx-accum-fw;
        }

        const fy=cy-fh/2;
        // Store actual top-left of the bounding box for hit targets / rebuild
        f.drawX=fx; f.drawY=fy; f.drawW=fw; f.drawH=fh;
        f.x=fx-(f.sz-fw)/2;
        f.y=fy-(f.sz-fh)/2;
        drawRef(f.ref,fx,fy,fw,fh,f.alpha,getFlickerImgLarge(f.ref));
      }
    }
  }
}

function startExplode(mx,my,forcedIdx){
  if(state!=='grid')return;
  let sIdx=forcedIdx!==undefined?forcedIdx:0;
  if(forcedIdx===undefined){
    // Flat grid fallback hit test
    let found=false;
    for(let i=0;i<tiles.length;i++){
      const t=tiles[i];
      const sx=t.x-gridScrollY, sy=t.y, sw=t.tw||t.sz, sh=t.th||t.sz;
      if(mx>=sx&&mx<=sx+sw&&my>=sy&&my<=sy+sh){ sIdx=i; found=true; break; }
    }
    if(!found){
      let minD=Infinity;
      tiles.forEach((t,i)=>{ const sx=t.x-gridScrollY,sy=t.y; const d=Math.hypot(sx+(t.tw||t.sz)/2-mx,sy+(t.th||t.sz)/2-my); if(d<minD){minD=d;sIdx=i;} });
    }
  }
  selectedRef=tiles[sIdx].ref;
  currentRefIdx=sortedRefs.findIndex(r=>r===selectedRef);
  const SIDES=7,n=sortedRefs.length;

  // Floaters start from their ACTUAL rendered cylinder position (no jump to flat grid)
  // and ease smoothly into coverflow targets.
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const idx=(currentRefIdx+off+n)%n, ref=sortedRefs[idx];
    if(!ref) continue;
    const tgt=cfPos(off);
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;

    // Use the currently rendered cylinder tile as the starting position.
    // If the ref isn't visible on the cylinder (back-facing), fall back to the clicked tile.
    let sx, sy, ssz;
    const drawn = drawnCylTiles.find(d => d.i === idx);
    if (drawn) {
      sx = drawn.sx; sy = drawn.sy; ssz = drawn.sw;
    } else {
      const clicked = drawnCylTiles.find(d => d.i === currentRefIdx);
      if (clicked) { sx = clicked.sx; sy = clicked.sy; ssz = clicked.sw; }
      else { sx = W/2; sy = H/2; ssz = 80; }
    }

    floaters.push({ref,color:ref.color,
      x:sx, y:sy,
      tx:tgt.x, ty:tgt.y, tsz:tgt.sz,
      sz:ssz, offset:off, alpha:1, reveal:0, natRatio});
  }

  particles=[];
  state='exploding'; phase=0;
  cfScrollX=0; cfScrollVel=0;
  cancelAnimationFrame(animFrame);
  showUI();
  animFrame=requestAnimationFrame(loopExplode);
}

function stepParticles(){
  for(const p of particles){
    p.vx*=0.98; p.vy*=0.98;
    p.vy+=0.3; // strong gravity so they fall fast
    p.x+=p.vx; p.y+=p.vy;
    p.rot+=p.rotV;
    const offscreen=p.x+p.sz<-50||p.x>W+50||p.y+p.sz<-50||p.y>H+50;
    if(offscreen){
      p.alpha=Math.max(0,p.alpha-0.15);
      if(p.alpha<=0) p.visible=false;
    }
  }
}

function loopFloated(){
  tickFlicker();
  draw();
  animFrame=requestAnimationFrame(loopFloated);
}
const loopFloat=loopFloated; // alias for safety

function loopExplode(){
  phase++;
  stepParticles();

  // Floaters ease toward coverflow targets. Match reveal's curve to the
  // x/y/sz easing — using a linear 0.05/frame for reveal made portrait
  // cards (text books) "catch up" to their natural ratio late, giving
  // a visible bounce that square sound covers don't show.
  let done=true;
  for(const f of floaters){
    f.x+=(f.tx-f.x)*0.1; f.y+=(f.ty-f.y)*0.1; f.sz+=(f.tsz-f.sz)*0.1;
    f.reveal=(f.reveal||0)+(1-(f.reveal||0))*0.1;
    if(f.reveal>0.995) f.reveal=1;
    if(Math.hypot(f.tx-f.x,f.ty-f.y)>2) done=false;
  }

  draw();
  if(done&&phase>20){
    for(const f of floaters){f.x=f.tx;f.y=f.ty;f.sz=f.tsz;}
    particles=[];
    state='floated'; phase=0;
    buildHitTargets();
    animFrame=requestAnimationFrame(loopFloated);
    return;
  }
  animFrame=requestAnimationFrame(loopExplode);
}


function getCylPos(refIdx){
  const ROWS=getGridRows();
  const TILE=Math.floor(GRID_H()/ROWS);
  const R=W/Math.PI*2.2;
  const FOCAL=R*0.55; // tighter focal = more dramatic perspective
  const CY=HEADER_H+GRID_H()/2;
  const CX=W/2;
  const N=sortedRefs.length||1;
  const colsFor360=Math.ceil(2*Math.PI*R/TILE);
  const COLS=Math.max(Math.ceil(N/ROWS), colsFor360);
  const anglePerCol=(2*Math.PI)/COLS;
  const col=Math.floor(refIdx/ROWS);
  const row=refIdx%ROWS;
  const tileAngle=col*anglePerCol+cylAngle;
  const x3=Math.sin(tileAngle)*R;
  const z3=Math.cos(tileAngle)*R;
  const scale=FOCAL/(FOCAL+R-z3);
  const screenX=CX+x3*scale;
  const screenY=CY+(row-(ROWS-1)/2)*TILE*scale;
  const tileW=TILE*scale;
  return{x:screenX-tileW/2, y:screenY-tileW/2, sz:tileW};
}

function startReassemble(){
  if(state!=='floated'&&state!=='exploding') return;
  hideUI(); clearHitTargets();

  // Snapshot floater positions for the implosion
  const snap=[...floaters];
  const cx=W/2, cy=H/2;

  state='returning'; phase=0;
  cancelAnimationFrame(animFrame);

  // Phase 1 (~35 frames): neighbours suck into centre card
  // Phase 2 (~20 frames): centre card shrinks to dot
  // Phase 3: dots appear on screen and grow into cylinder tiles

  let implodePhase=0;
  const IMPLODE_DUR=35;
  const SHRINK_DUR=20;
  let bigBangStarted=false;

  function loopImplode(){
    implodePhase++;
    ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
    bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);

    if(implodePhase<=IMPLODE_DUR){
      const t=implodePhase/IMPLODE_DUR;
      const ease=t<0.5?2*t*t:1-Math.pow(-2*t+2,2)/2;
      // Draw neighbours first (behind), then centre on top
      const sorted=[...snap].sort((a,b)=>Math.abs(b.offset)-Math.abs(a.offset));
      for(const f of sorted){
        const fh=f.offset===0?f.sz*1.7:f.sz;
        const natW=f.natRatio?fh*f.natRatio:fh;
        const fw=fh+(natW-fh)*(f.reveal||0);
        const fx0=f.x+(f.sz-fw)/2;
        const fy0=f.y+(f.sz-fh)/2;
        const tx=cx-fw/2, ty=cy-fh/2;
        const fx=fx0+(tx-fx0)*ease;
        const fy=fy0+(ty-fy0)*ease;
        drawRef(f.ref,fx,fy,fw,fh,1,getFlickerImgLarge(f.ref));
      }
    } else {
      // Centre card shrinks to dot, keeping its natural ratio
      const t2=(implodePhase-IMPLODE_DUR)/SHRINK_DUR;
      const sc=Math.max(0,1-t2);
      const centre=snap.find(f=>f.offset===0)||snap[0];
      if(centre&&sc>0){
        const fh=centre.sz*1.7*sc;
        const natW=centre.natRatio?fh*centre.natRatio:fh;
        const fw=fh+(natW-fh)*(centre.reveal||0);
        drawRef(centre.ref,cx-fw/2,cy-fh/2,fw,fh,1,getFlickerImgLarge(centre.ref));
      }

      if(implodePhase>=IMPLODE_DUR+SHRINK_DUR && !bigBangStarted){
        bigBangStarted=true;
        buildGrid();
        tiles.forEach(t=>{ t.popDelay=Math.random()*1200; t._popped=false; });
        cylPopStart=performance.now();
        state='grid'; phase=0;
        cancelAnimationFrame(animFrame);
        animFrame=requestAnimationFrame(loopGrid);
        return;
      }
    }
    animFrame=requestAnimationFrame(loopImplode);
  }
  animFrame=requestAnimationFrame(loopImplode);
}

function loopReassembleBlast(){
  // Step particles
  for(const p of particles){
    p.vx*=0.97; p.vy*=0.97; p.vy+=0.12;
    p.x+=p.vx; p.y+=p.vy; p.rot+=p.rotV; p.frames++;
    const off=p.x+p.sz<-50||p.x>W+50||p.y+p.sz<-50||p.y>H+50;
    if(off){p.alpha=Math.max(0,p.alpha-0.15);if(p.alpha<=0)p.visible=false;}
  }
  // Draw cylinder (tiles pop in one by one — alpha is 0 or 1, no fade)
  ctx.clearRect(0,0,W,H); bgCtx.clearRect(0,0,W,H);
  bgCtx.fillStyle='#ffffff'; bgCtx.fillRect(0,0,W,H);
  drawCylinder();
  // Draw blast particles on top
  for(const p of particles){
    if(!p.visible)continue;
    const im=getImg(p.ref);
    ctx.save();ctx.globalAlpha=p.alpha;
    ctx.translate(p.x+p.sz/2,p.y+p.sz/2);ctx.rotate(p.rot);
    if(im&&im.complete&&im.naturalWidth>0) ctx.drawImage(im,-p.sz/2,-p.sz/2,p.sz,p.sz);
    else{ctx.fillStyle=`rgb(${p.color[0]},${p.color[1]},${p.color[2]})`;ctx.fillRect(-p.sz/2,-p.sz/2,p.sz,p.sz);}
    ctx.restore();
  }
  const anyVisible=particles.some(p=>p.visible);
  const popDone=!cylPopStart||performance.now()-cylPopStart>1200;
  if(!anyVisible&&popDone){
    particles=[];cylPopStart=null;
    animFrame=requestAnimationFrame(loopGrid);
  } else {
    animFrame=requestAnimationFrame(loopReassembleBlast);
  }
}

function blastToGrid(callback){
  // Simply ease all floaters back to their grid tile positions
  // For non-floater tiles (grid size / filter change), just rebuild immediately
  if(floaters.length===0){
    if(callback) callback();
    state='grid'; phase=0; buildGrid();
    cancelAnimationFrame(animFrame);
    animFrame=requestAnimationFrame(loopGrid);
    return;
  }

  // Set each floater's target to its grid tile position
  for(const f of floaters){
    const tile=tiles.find(t=>t.ref===f.ref);
    if(tile){
      f.tx=tile.x-gridScrollY; f.ty=tile.y; f.tsz=tile.sz;
    } else {
      f.tx=f.x<W/2?-f.sz:W+f.sz; f.ty=f.y; f.tsz=f.sz;
    }
    f.reveal=0;
  }

  state='returning'; phase=0;
  cancelAnimationFrame(animFrame);
  animFrame=requestAnimationFrame(loopReturn);
}

function loopGrid(){
  tickFlicker();
  if(cylPopStart&&performance.now()-cylPopStart>3500) cylPopStart=null;
  updateCylScrubber();
  draw();
  animFrame=requestAnimationFrame(loopGrid);
}

function rebuildFloaters(){
  const n=sortedRefs.length,SIDES=7;
  // Build a map of current floater positions by ref
  const curPos=new Map();
  for(const f of floaters) curPos.set(f.ref,{x:f.x,y:f.y,sz:f.sz,reveal:f.reveal||0});
  const{cx,cy}=getCF();
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const idx=(currentRefIdx+off+n)%n,ref=sortedRefs[idx],tgt=cfPos(off);
    if(!ref) continue;
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;
    const prev=curPos.get(ref);
    floaters.push({ref,color:ref.color,
      // Start from previous position if known, else target
      x:prev?prev.x:tgt.x, y:prev?prev.y:tgt.y, sz:prev?prev.sz:tgt.sz,
      tx:tgt.x, ty:tgt.y, tsz:tgt.sz,
      offset:off, alpha:1, reveal:prev?prev.reveal:1, natRatio});
  }
  // Animate to new positions via loopExplode
  state='exploding'; phase=0;
  cancelAnimationFrame(animFrame);
  animFrame=requestAnimationFrame(loopExplode);
}

function buildHitTargets(){
  const stack=document.getElementById('card-stack');
  stack.innerHTML='';
  const{sz}=getCF(),n=sortedRefs.length,VISIBLE=7;
  for(let off=-VISIBLE;off<=VISIBLE;off++){
    const idx=(currentRefIdx+off+n)%n,ref=sortedRefs[idx],pos=cfPos(off);
    if(!ref) continue;
    const sc=off===0?1.5:1.0;
    const w=sz*sc,h=sz*sc,x=pos.x+(sz-w)/2,y=pos.y+(sz-h)/2;
    const div=document.createElement('div');
    div.className='stack-card';
    div.style.cssText=`left:${x}px;top:${y}px;width:${w}px;height:${h}px;z-index:${VISIBLE+1-Math.abs(off)};`;
    if(off!==0){
      div.addEventListener('click',e=>{
        e.stopPropagation();
        currentRefIdx=idx;selectedRef=ref;
        rebuildFloaters();buildHitTargets();updateMeta(ref);updateScrubber();
      });
    }
    stack.appendChild(div);
  }
  stack.classList.add('active');
}

function clearHitTargets(){
  const stack=document.getElementById('card-stack');
  stack.innerHTML=''; stack.classList.remove('active');
}

// ── Thumbnail strip ───────────────────────────────────────────────────────
let thumbInterval=null, thumbIdx=0, thumbPaused=false;

function buildThumbStrip(ref){
  const strip=document.getElementById('thumb-strip');
  strip.innerHTML='';
  strip.classList.remove('show');
  clearInterval(thumbInterval);
  if(!ref.images||ref.images.length===0) return;

  thumbIdx=flickerIdx.get(ref)||0;

  // Position strip below the centre card
  const{sz,cx,cy}=getCF();
  const sc=1.7, fh=sz*sc;
  const stripY=cy+fh/2+14;
  strip.style.top=stripY+'px';
  strip.style.left='0'; strip.style.right='0';

  // Build thumbnails — main img first, then images array
  const allImgs=[ref.img,...(ref.images||[])];
  allImgs.forEach((src,i)=>{
    const item=document.createElement('div');
    item.className='thumb-item'+(i===thumbIdx?' active':'');
    if(src){
      const img=document.createElement('img');
      img.src=src; item.appendChild(img);
    } else {
      item.style.background=`rgb(${ref.color[0]},${ref.color[1]},${ref.color[2]})`;
    }
    item.addEventListener('click',()=>{ thumbIdx=i; flickerIdx.set(ref,i); updateThumbActive(strip,i); });
    strip.appendChild(item);
  });

  strip.classList.add('show');

  // Auto-slideshow
  clearInterval(thumbInterval);
  thumbInterval=setInterval(()=>{
    if(thumbPaused) return;
    thumbIdx=(thumbIdx+1)%allImgs.length;
    flickerIdx.set(ref,thumbIdx);
    updateThumbActive(strip,thumbIdx);
  }, 1200);
}

function updateThumbActive(strip, idx){
  [...strip.children].forEach((c,i)=>c.classList.toggle('active',i===idx));
}

function hideThumbStrip(){
  clearInterval(thumbInterval);
  document.getElementById('thumb-strip').classList.remove('show');
}

// Pause strip when hovering centre card area
function isOverCentreCard(mx,my){
  const centre=floaters.find(f=>f.offset===0);
  if(!centre) return false;
  const{sz,cx,cy}=getCF();
  const sc=1.7, fh=centre.sz*sc;
  const natW=centre.natRatio?fh*centre.natRatio:fh;
  const fw=fh+(natW-fh)*(centre.reveal||0);
  const fx=centre.x+(centre.sz-fw)/2;
  const fy=centre.y+(centre.sz-fh)/2;
  return mx>=fx&&mx<=fx+fw&&my>=fy&&my<=fy+fh;
}
window.addEventListener('mousemove',e=>{
  if(state==='floated'||state==='exploding'){
    thumbPaused=isOverCentreCard(e.clientX,e.clientY);
  }
});
function showUI(){
  document.getElementById('cyl-nav').style.display='none';
  document.getElementById('back-btn').classList.add('show');
  updateMeta(selectedRef); updateScrubber();
  buildThumbStrip(selectedRef);
}

function hideUI(){
  document.getElementById('cyl-nav').style.display='flex';
  document.getElementById('back-btn').classList.remove('show');
  hideThumbStrip();
  updateCylScrubber();
  updateMetaEmpty();
}

function updateMeta(ref){
  // Header info (cylinder hover — single line)
  const info=document.getElementById('header-info');
  info.innerHTML=`${ref.title}<span class="sep">·</span>${ref.artist}<span class="sep">·</span>${ref.year}`;

  // Info panel (expanded view — 2-col list)
  const panel=document.getElementById('info-panel');
  const fields=[
    ['Title',    ref.title||'—'],
    ['Creator',  ref.artist||'—'],
    ['Year',     ref.year||'—'],
    ['Added by', ref.addedBy||'—'],
    ['Category', ref.cat||'—'],
  ];
  panel.innerHTML=fields.map(([label,val])=>
    `<div class="info-row"><span class="info-label">${label}</span><span class="info-value">${val}</span></div>`
  ).join('');
}

function updateScrubber(){
  const n=sortedRefs.length,pct=n>1?currentRefIdx/(n-1):0;
  const dot=document.getElementById('scrubber-dot');
  dot.style.transition='none'; dot.style.left=(pct*100)+'%';
}

