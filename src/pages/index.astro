---
import Layout from '../layouts/Layout.astro';
import services from '../data/services.json';
import clients from '../data/clients.json';
import projectsData from '../data/projects.json';


---

<Layout title="C-STUDIOS">
  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- C-STUDIOS / Hero with moon animation                          -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="cstudios">
    <div class="cst-hero" id="cstHero">
      <!-- Slideshow (inside #cstHero so mix-blend works on .container) -->
  <!-- Slideshow -->
      <div id="flashSequence" class="cst-stage">
        <img
          src="/images/hero/intro01-1280w.webp"
          srcset="/images/hero/intro01-640w.webp 640w, /images/hero/intro01-828w.webp 828w, /images/hero/intro01-1280w.webp 1280w, /images/hero/intro01-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro02-1280w.webp"
          srcset="/images/hero/intro02-640w.webp 640w, /images/hero/intro02-828w.webp 828w, /images/hero/intro02-1280w.webp 1280w, /images/hero/intro02-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro03-1280w.webp"
          srcset="/images/hero/intro03-640w.webp 640w, /images/hero/intro03-828w.webp 828w, /images/hero/intro03-1280w.webp 1280w, /images/hero/intro03-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro04-1280w.webp"
          srcset="/images/hero/intro04-640w.webp 640w, /images/hero/intro04-828w.webp 828w, /images/hero/intro04-1280w.webp 1280w, /images/hero/intro04-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro05-1280w.webp"
          srcset="/images/hero/intro05-640w.webp 640w, /images/hero/intro05-828w.webp 828w, /images/hero/intro05-1280w.webp 1280w, /images/hero/intro05-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro06-1280w.webp"
          srcset="/images/hero/intro06-640w.webp 640w, /images/hero/intro06-828w.webp 828w, /images/hero/intro06-1280w.webp 1280w, /images/hero/intro06-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro07-1280w.webp"
          srcset="/images/hero/intro07-640w.webp 640w, /images/hero/intro07-828w.webp 828w, /images/hero/intro07-1280w.webp 1280w, /images/hero/intro07-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro08-1280w.webp"
          srcset="/images/hero/intro08-640w.webp 640w, /images/hero/intro08-828w.webp 828w, /images/hero/intro08-1280w.webp 1280w, /images/hero/intro08-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro09-1280w.webp"
          srcset="/images/hero/intro09-640w.webp 640w, /images/hero/intro09-828w.webp 828w, /images/hero/intro09-1280w.webp 1280w, /images/hero/intro09-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro10-1280w.webp"
          srcset="/images/hero/intro10-640w.webp 640w, /images/hero/intro10-828w.webp 828w, /images/hero/intro10-1280w.webp 1280w, /images/hero/intro10-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro11-1280w.webp"
          srcset="/images/hero/intro11-640w.webp 640w, /images/hero/intro11-828w.webp 828w, /images/hero/intro11-1280w.webp 1280w, /images/hero/intro11-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro12-1280w.webp"
          srcset="/images/hero/intro12-640w.webp 640w, /images/hero/intro12-828w.webp 828w, /images/hero/intro12-1280w.webp 1280w, /images/hero/intro12-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro13-1280w.webp"
          srcset="/images/hero/intro13-640w.webp 640w, /images/hero/intro13-828w.webp 828w, /images/hero/intro13-1280w.webp 1280w, /images/hero/intro13-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro14-1280w.webp"
          srcset="/images/hero/intro14-640w.webp 640w, /images/hero/intro14-828w.webp 828w, /images/hero/intro14-1280w.webp 1280w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
      </div>

      <!-- Moon (tracker) -->
      <div class="moon"></div>

      <!-- Text -->
      <div class="container" id="textContainer">
        <p class="home-text">C-STUDIOS</p>
        <p class="sub-text" id="subText">
          is a creative strategy studio working across cultural research, concepts, creative direction, consulting, and curation.
        </p>
      </div>

      <!-- Inverted mask + matching rim -->
      <div id="revealHole" class="reveal-hole" aria-hidden="true"></div>
      <div id="holeRim" class="hole-rim" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- SERVICES                                                      -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="services" class="services-section">
    <div class="services-tabs">
      {services.map((tab, i) => (
        <button
          class:list={["services-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {services.map((tab, i) => (
      <div class:list={["services-panel", { active: i === 0 }]} data-tab={tab.slug}>
        <div class="services-images" style={`grid-template-columns: repeat(${tab.columns.length}, 1fr)`}>
          {tab.columns.map(col => (
            <img
              src={`/images/services/${col.image}-1280w.webp`}
              srcset={`/images/services/${col.image}-640w.webp 640w, /images/services/${col.image}-828w.webp 828w, /images/services/${col.image}-1280w.webp 1280w, /images/services/${col.image}-2560w.webp 2560w`}
              sizes="25vw"
              alt={col.alt}
              data-align={col.align}
              loading="lazy" />
          ))}
        </div>
        {(() => {
          const textCols = tab.columns.filter(c => c.category || c.services.length > 0);
          return (
            <div class="services-texts" style={`grid-template-columns: repeat(${textCols.length}, 1fr)`}>
              {textCols.map(col => (
                <div class="services-column">
                  {col.category && <div class="services-category">[ {col.category} ]</div>}
                  {col.services.length > 0 && (
                    <ul class="services-list">
                      {col.services.map(s => <li>{s}</li>)}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          );
        })()}
      </div>
    ))}
  </section>



  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- CLIENTS — two-row marquee, opposite directions                -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="clients" class="clients-section">
    <!-- Top row — scrolls left → right. 4x duplication keeps the track
         wider than 2x viewport so no blank slot appears during translate.
         eager loading prevents off-screen logos from popping in mid-scroll. -->
    <div class="marquee">
      <div
        class="marquee-track marquee-right"
        style={`animation-duration: ${clients.row1.length * 5.5 * 2}s`}>
        {[...clients.row1, ...clients.row1, ...clients.row1, ...clients.row1].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="eager" />
        ))}
      </div>
    </div>
    <!-- Bottom row — scrolls right → left -->
    <div class="marquee">
      <div
        class="marquee-track marquee-left"
        style={`animation-duration: ${clients.row2.length * 5.5 * 2}s`}>
        {[...clients.row2, ...clients.row2, ...clients.row2, ...clients.row2].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="eager" />
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- PROJECTS — tabs + expandable rows with image strip            -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="projects" class="projects-section">
    <div class="projects-tabs">
      {projectsData.map((tab, i) => (
        <button
          class:list={["projects-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {projectsData.map((tab, i) => (
      <div class:list={["projects-panel", { active: i === 0 }]} data-tab={tab.slug}>
        {tab.projects.length === 0 ? (
          <div class="projects-empty">No projects to show in this category yet.</div>
        ) : (
          <div class="projects-list">
            {tab.projects.map((project) => (
              <div class="project-row">
                <button class="project-summary" type="button">
                  <span class="project-title">{project.title.toUpperCase()}</span>
                  <span class="project-year">{project.year}</span>
                  <span class="project-description">{project.description}</span>
                </button>
                {project.images.length > 0 && (
                  <div class="project-images" data-scrubber>
                    {project.images.map((img) => {
                      const stem = img.replace(/\.[^.]+$/, '');
                      return (
                        <img
                          src={`${stem}-1280w.webp`}
                          srcset={`${stem}-640w.webp 640w, ${stem}-828w.webp 828w, ${stem}-1280w.webp 1280w, ${stem}-2560w.webp 2560w`}
                          sizes="20vw"
                          alt={project.title}
                          loading="lazy" />
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- INFO (placeholder)                                            -->
  <!-- ════════════════════════════════════════════════════════════ -->
<section id="info" class="info-section">
  <div class="info-wrap">
    <div class="info-venn">
      <p class="venn-text venn-text-left">
        Where we translate our insights into sustainable solutions for an evolving network of international clients.
      </p>
      <div class="venn-stage">
        <svg class="venn-svg" viewBox="172 32 456 336" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="venn-circle venn-circle-left"  cx="340" cy="200" r="160" />
          <circle class="venn-circle venn-circle-right" cx="460" cy="200" r="160" />
          <image class="venn-c-logo" href="/images/brand/c-studios-logo.png"
                 x="370" y="180" width="60" height="43"
                 preserveAspectRatio="xMidYMid meet" />
        </svg>
        <span class="venn-label venn-label-left">Strategy</span>
        <span class="venn-label venn-label-right">Curation</span>
      </div>
      <p class="venn-text venn-text-right">
        How we test and expand our ideas through collaborative models that explore new forms of cultural production and collective care.
      </p>
    </div>
    <div class="info-body">
      <p class="info-paragraph">
        C-STUDIOS is a collective of cross-disciplinary translators – from strategists, researchers and artists to academics, designers and creative practitioners. Together we operate across industry sectors, creative ecosystems and artistic expressions.
      </p>
      <p class="info-paragraph">
        At every level, culture continues to accelerate. In this climate, C-STUDIOS applies cultural literacy to design effective creative industry solutions for brands, labels, artists, institutions and beyond.
      </p>
    </div>
  </div>
</section>

</Layout>

<!-- ════════════════════════════════════════════════════════════ -->
<!-- HERO STYLES (moon animation, slideshow, text)                 -->
<!-- ════════════════════════════════════════════════════════════ -->
<style is:global>
  :root { --vh: 1vh; }

 /* Hide native scrollbar on scrubber-enabled elements */
[data-scrubber] {
  scrollbar-width: none;
}
[data-scrubber]::-webkit-scrollbar {
  display: none;
}

/* Scrubber container */
.scrubber {
  cursor: crosshair;
  pointer-events: all;
  transition: opacity 0.3s ease;
}
.scrubber-hidden {
  opacity: 0;
  pointer-events: none;
}

/* Horizontal */
.scrubber-h {
  width: 100%;
  height: 20px;
  padding: 0 28px;
  box-sizing: border-box;
  position: relative;
}
.scrubber-h .scrubber-track {
  position: relative;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 1px;
  background: rgba(0, 0, 0, 0.25);
}
.scrubber-h .scrubber-dot {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  background: #0a0a0a;
}

/* Vertical (for later use) */
.scrubber-v {
  position: fixed;
  right: 0;
  top: 0;
  width: 20px;
  height: 100vh;
  padding: 28px 0;
  box-sizing: border-box;
  z-index: 200;
}
.scrubber-v .scrubber-track {
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  height: 100%;
  width: 1px;
  background: rgba(0, 0, 0, 0.25);
}
.scrubber-v .scrubber-dot {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  background: #0a0a0a;
}

  .container, .home-text, .sub-text, .moon, .flash-img {
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  /* Base layout */
  #cstHero {
    position: relative;
    width: 100vw;
    height: calc(var(--vh) * 100);
    overflow: hidden;
    background: white;
  }

  .cst-stage {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: calc(var(--vh) * 100);
    z-index: 0;
  }

  .flash-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: calc(var(--vh) * 100) !important;
    object-fit: cover !important;
    object-position: center top !important;
    opacity: 0 !important;
    transition: opacity 1.2s ease-in-out !important;
    transform: scale(1) !important;
    z-index: 0;
    display: block !important;
    visibility: visible !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    max-width: none !important;
    max-height: none !important;
    min-width: 100vw !important;
    min-height: calc(var(--vh) * 100) !important;
  }

  .flash-img.active {
    opacity: 1 !important;
    transform: scale(1) !important;
    z-index: 1;
  }

  @supports (height: 100svh) {
    #cstHero, .cst-stage, .flash-img { height: 100svh; }
  }
  @supports (height: 100dvh) {
    #cstHero, .cst-stage, .flash-img { height: 100dvh; }
  }

  /* Text block */
  .container {
    position: absolute;
    top: 50%;
    left: 93vw;
    transform: translateY(-50%);
    white-space: nowrap;
    opacity: 1;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: nowrap;
       /* text auto-adapts to slideshow photo brightness */
  }

  .text-centered {
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    justify-content: center;
    text-align: center;
  }

  .home-text, .sub-text {
    margin: 0;
    white-space: nowrap;
    text-transform: uppercase;
    font: 400 16px/1.2 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
    letter-spacing: 0.05em;
    opacity: 0;
  }

  .home-text {
    transform: translateX(-100vw);
    animation: slideInLeft 2.5s cubic-bezier(0.645, 0.045, 0.355, 1) forwards;
    margin-right: 8px;
  }

  @keyframes slideInLeft {
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .sub-text span {
    font: inherit !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
    display: inline !important;
  }

  /* Moon */
  .moon {
    background: transparent;
    position: absolute;
    top: 50%;
    left: 100vw;
    width: calc(var(--vh) * 95);
    height: calc(var(--vh) * 95);
    border-radius: 50%;
    transform: translateY(-50%);
    z-index: 5;
    transition: transform 2.5s cubic-bezier(0.645, 0.045, 0.355, 1), opacity 1s ease-in;
    opacity: 1;
  }

  @supports (height: 100svh) { .moon { width: 95svh; height: 95svh; } }
  @supports (height: 100dvh) { .moon { width: 95dvh; height: 95dvh; } }

  /* Mask layers */
  .reveal-hole {
    position: absolute;
    inset: 0;
    background: #fff;
    z-index: 25;
    pointer-events: none;
    opacity: 1;
    transition: opacity .6s ease;
    --mx: 120vw;
    --my: 50vh;
    --mr: 0px;
    -webkit-mask: radial-gradient(circle var(--mr) at var(--mx) var(--my), transparent 98%, #000 100%);
            mask: radial-gradient(circle var(--mr) at var(--mx) var(--my), transparent 98%, #000 100%);
  }

  .hole-rim {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 26;
    pointer-events: none;
    border-radius: 50%;
    opacity: 1;
    transition: opacity .6s ease;
    box-shadow:
      inset 8px 8px 12px rgba(0,0,0,0.25),
      inset -4px -4px 8px rgba(255,255,255,0.9);
  }

  /* Mobile */
  @media (max-width: 767px) {
    #cstHero, .cst-stage, .flash-img {
      height: calc(var(--vh) * 100) !important;
    }

.moon { 
    width: calc(var(--vh) * 75) !important; 
    height: calc(var(--vh) * 75) !important; 
    left: 100vw; 
  }
    #cstHero .container.text-centered {
      left: 5vw !important;
      transform: translateY(-50%) !important;
      justify-content: flex-start !important;
      text-align: left !important;
    }
    .home-text, .sub-text {
      font-size: 0.7em !important;
      line-height: 1.25 !important;
      white-space: normal !important;
    }
    .sub-text { visibility: hidden; }
    .sub-text .line { display: block; }
    #cstHero .container {
      width: calc(100vw - 52px);
      color: white;
      display: block !important;
      left: 26px !important;
      top: 40vh !important;
      transform: none !important;
      z-index: 30 !important;
      align-items: flex-start !important;
    }
    .home-text {
      float: left;
      white-space: nowrap !important;
      margin: 0 4px 0 0 !important;
      line-height: 1.25 !important;
      font-size: 0.65rem !important;
    }
    .sub-text {
      display: block;
      white-space: normal !important;
      font-size: 0.65rem !important;
      line-height: 1.25 !important;
    }
    #cstHero .container::after {
      content: "";
      display: block;
      clear: both;
    }
    #cstHero { isolation: isolate; }
    .home-text, .sub-text {
      color: white;
      text-shadow: none !important;
      -webkit-text-stroke: 0 !important;
    }
    .flash-img {
      height: calc(var(--vh) * 100) !important;
      min-height: calc(var(--vh) * 100) !important;
    }
  }

  @media (min-width: 768px) {
    .sub-text {
      opacity: 0;
      transform: translateX(20vw);
      animation: slideInLeft 2s cubic-bezier(0.645,0.045,0.355,1) 1.5s forwards;
    }
    #textContainer {
      transition: left 1200ms cubic-bezier(0.22,1,0.36,1),
                  transform 1200ms cubic-bezier(0.22,1,0.36,1);
    }
  }

  #cstHero { isolation: isolate; }

  .cst-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity .35s ease;
  }

  .cst-stage:has(.flash-img.active)::after {
    opacity: 1;
  }

  .home-text, .sub-text {
    color: lightgrey;
    transition: color .3s ease;
  }
  /* Once slideshow is running, switch source to white so mix-blend produces max contrast */
  #cstHero:has(.flash-img.active) .home-text,
  #cstHero:has(.flash-img.active) .sub-text {
    color: #fff;
  }

  
  /* Per-image crop alignment overrides */
  .flash-img[data-align="center"]       { object-position: center center !important; }
  .flash-img[data-align="bottom"]       { object-position: center bottom !important; }
  .flash-img[data-align="left"]         { object-position: left center !important; }
  .flash-img[data-align="right"]        { object-position: right center !important; }
  .flash-img[data-align="top-left"]     { object-position: left top !important; }
  .flash-img[data-align="top-right"]    { object-position: right top !important; }
  .flash-img[data-align="bottom-left"]  { object-position: left bottom !important; }
  .flash-img[data-align="bottom-right"] { object-position: right bottom !important; }


  /* ════════════════════════════════════════════════════════════ */
  /* SERVICES section                                              */
  /* ════════════════════════════════════════════════════════════ */
  .services-section {
    height: 100vh;
    padding: 80px 0 40px;
    background: white;
    position: relative;
    z-index: 2;
    /* Grid lets all panels share the same area and overlap during transitions */
    display: grid;
    grid-template-areas: "tabs" "panels";
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }
 
 .services-tabs {
  grid-area: tabs;
  align-self: start;
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  margin-bottom: 40px;
  padding: 0 28px;
}
  .services-tab {
    background: none;
    border: none;
    padding: 0;
    color: lightgrey;
    cursor: pointer;
    font: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .services-tab:hover { color: grey; }
  .services-tab.active { color: #0a0a0a; }

  /* Directional carousel: panels slide left/right based on tab navigation direction.
     Smoother easing curve (easeInOutCubic) + longer duration for fluid motion. */
  .services-panel {
    grid-area: panels;
    transform: translateX(100%);     /* default parked off-screen right */
    visibility: hidden;
    pointer-events: none;
    z-index: 1;
    transition:
      transform 1s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0s 1s;
  }

  /* Pre-positioning for new panel entrance (set with .no-transition, then animate) */
  .services-panel.enter-from-right {
    transform: translateX(100%);
    visibility: visible;
  }
  .services-panel.enter-from-left {
    transform: translateX(-100%);
    visibility: visible;
  }

  /* Exit states — direction depends on whether new tab is to the LEFT or RIGHT */
  .services-panel.exit-left {
    transform: translateX(-100%);
    visibility: visible;
    z-index: 2;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .services-panel.exit-right {
    transform: translateX(100%);
    visibility: visible;
    z-index: 2;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .services-panel.active {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
    transition:
      transform 1s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0s 0s;
  }

  /* Skip transitions for instant positioning (pre-entrance, post-exit cleanup) */
  .services-panel.no-transition {
    transition: none !important;
  }

  /* Image grid — edge to edge, no gaps */
  .services-images {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    width: 100%;
    overflow: hidden;            /* clip images that start stacked off-screen */
  }
  .services-images img {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 45vh;
    object-fit: cover;
    display: block;
    position: relative;
  }
  .services-images img[data-align="top"]    { object-position: center top; }
  .services-images img[data-align="bottom"] { object-position: center bottom; }
  .services-images img[data-align="left"]   { object-position: left center; }
  .services-images img[data-align="right"]  { object-position: right center; }







  .services-texts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 30px 30px 0;        /* text gets the side padding */
  }
  .services-column { padding-right: 30px; }
  .services-category {
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0a0a0a;
    margin-bottom: 1rem;
  }
  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.7;
  }

  /* ─── Mobile: tabs collapse to a click-to-open dropdown ─── */
  @media (max-width: 768px) {
    /* Tabs sit directly under the nav — same anchor projects uses. */
    .services-section {
      padding-top: var(--cst-nav-bottom);
    }
    .services-tabs {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      margin-bottom: 0;
      padding: 0;
      position: relative;
      background: white;
      z-index: 100;
      box-sizing: border-box;
    }
    .services-tabs::before, .services-tabs::after { display: none; }
    .services-tab {
      width: 100%;
      text-align: left;
      padding: 10px 12px;        /* 12px viewport inset; background spans full width */
      font-size: 0.6rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      background: white;
      border: none;
      cursor: pointer;
      color: grey;
      white-space: nowrap;
    }
    .services-tab:not(.active) { display: none; }
    .services-tab.active {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #0a0a0a;
      border-bottom: 1px solid #e5e5e5;
    }
    .services-tab.active::after {
      content: '';
      width: 12px;
      height: 12px;
      flex-shrink: 0;
      margin-left: 12px;
      background-color: currentColor;
      -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
              mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
      transition: transform 0.2s ease;
    }
    /* Open: inactive tabs render as an absolute overlay below the active one
       so the rest of the section doesn't push down. Each item plays a
       short fade+drop animation in DOM order so the menu reads as
       "growing from below the active tab". */
    .services-tabs.open .services-tab:not(.active) {
      display: flex;
      position: absolute;
      left: 0;                  /* edge-to-edge background */
      right: 0;
      top: calc(100% * var(--tab-i, 1));
      background: white;
      z-index: 99;
      border-bottom: 1px solid #f5f5f5;
      animation: tab-dropdown-in 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--tab-i, 1) * 55ms);
    }
    .services-tabs.open .services-tab.active::after { transform: rotate(45deg); }
    @keyframes tab-dropdown-in {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0);     }
    }

    .services-images {
    position: relative;
    display: block;
    grid-template-columns: none;
    width: 100%;
    height: 50vh;
    overflow: hidden;
  }
  .services-images img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }
  .services-images img.active {
    opacity: 1;
  }

    .services-texts {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;                    /* equal spacing between columns */
      padding: 32px 10px 10px;      /* extra top space below the image */
    }
    .services-column { padding-right: 0; }   /* let grid gap handle it */
    .services-list, .services-category { font-size: 0.5rem; }
  }

