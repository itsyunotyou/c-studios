    document.getElementById('filter-drop').classList.remove('open');
    activeFilter=btn.dataset.filter;
    if(state==='grid'){ buildGrid(); cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopGrid); }
  });
});

function updateCylScrubber(){
  // Map cylAngle to scrubber dot position (mod 2PI → 0-100%)
  const dot=document.getElementById('scrubber-dot');
  if(!dot) return;
  const pct=((cylAngle%(Math.PI*2))+Math.PI*2)%(Math.PI*2) / (Math.PI*2);
  dot.style.transition='none';
  dot.style.left=(pct*100)+'%';
}

function setupScrubberDrag(){
  const wrap=document.getElementById('scrubber-wrap');
  let s=false;
  function to(cx){
    const r=wrap.getBoundingClientRect();
    const pct=Math.max(0,Math.min(1,(cx-r.left)/r.width));
    if(state==='floated'||state==='exploding'){
      // Expanded view: step through refs
      const n=sortedRefs.length, idx=Math.round(pct*(n-1));
      document.getElementById('scrubber-dot').style.left=(pct*100)+'%';
      if(idx!==currentRefIdx) cfStep(idx-currentRefIdx);
    } else if(state==='grid'){
      // Cylinder: drag scrubber to rotate
      document.getElementById('scrubber-dot').style.left=(pct*100)+'%';
      cylAngle=pct*Math.PI*2;
      cylVel=0;
      autoRotate=false;     
    }
  }
  wrap.addEventListener('mousedown',e=>{
    if(e.target.closest('#scrubber-wrap')){ s=true; to(e.clientX); }
  });
  window.addEventListener('mousemove',e=>{if(s)to(e.clientX);});
  window.addEventListener('mouseup',()=>{s=false;});
  wrap.addEventListener('touchstart',e=>{s=true;to(e.touches[0].clientX);},{passive:true});
  window.addEventListener('touchmove',e=>{if(s)to(e.touches[0].clientX);},{passive:true});
  window.addEventListener('touchend',()=>{s=false;});
}

// Wheel scrolls through refs in expanded view
let cfWheelAcc=0;
function cfStep(steps){
  if(state==='grid'||state==='returning') return;
  hideThumbStrip();
  const n=sortedRefs.length;
  if(n===0) return;
  currentRefIdx=Math.max(0,Math.min(n-1,currentRefIdx+steps));
  selectedRef=sortedRefs[currentRefIdx];
  if(!selectedRef) return;
  updateMeta(selectedRef);
  updateScrubber();
  buildThumbStrip(selectedRef);
  const SIDES=7;
  const prevReveal=floaters.length>0?(floaters[0].reveal||1):1;
  floaters=[];
  for(let off=-SIDES;off<=SIDES;off++){
    const i=(currentRefIdx+off+n)%n, ref=sortedRefs[i];
    if(!ref) continue;
    const tgt=cfPos(off);
    const im=getImg(ref);
    const natRatio=(im&&im.naturalWidth&&im.naturalHeight)?im.naturalWidth/im.naturalHeight:1;
    floaters.push({ref,color:ref.color,x:tgt.x,y:tgt.y,sz:tgt.sz,tx:tgt.x,ty:tgt.y,tsz:tgt.sz,offset:off,alpha:1,reveal:prevReveal,natRatio});
  }
  buildHitTargets();
  if(state!=='floated'){ state='floated'; cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopFloated); }
}
function cfWheelScroll(delta){
  if(state==='grid'||state==='returning') return;
  cfWheelAcc+=delta;
  const threshold=50;
  if(Math.abs(cfWheelAcc)>=threshold){
    const steps=Math.round(cfWheelAcc/threshold);
    cfWheelAcc=0;
    cfStep(steps);
  }
}
cvs.addEventListener('mousedown',e=>{
  if(state==='grid'){ cylDragging=true; cylDragX=e.clientX; cylVel=0; autoRotate=false; }
});
document.addEventListener('mousedown',e=>{
  // Don't start cfDrag if clicking the scrubber
  if(e.target.closest('#scrubber-wrap')) return;
  if(state==='floated'||state==='exploding'){ cfDragging=true; cfDragX=e.clientX; cfScrollVel=0; cfDragMoved=false; }
});
let cfDragMoved=false;
window.addEventListener('mousemove',e=>{
  if(cylDragging&&state==='grid'){
    const dx=e.clientX-cylDragX; cylAngle+=dx*0.003; cylVel=dx*0.003; cylDragX=e.clientX;
  }
  if(cfDragging&&(state==='floated'||state==='exploding')){
    const dx=e.clientX-cfDragX;
    if(Math.abs(dx)>3) cfDragMoved=true;
    cfDragX=e.clientX;
    cfWheelScroll(-dx*0.7);
  }
  // Cylinder hover peek
  if(state==='grid'&&!cylDragging){
    cylHoverIdx=-1;
    for(const d of [...drawnCylTiles].reverse()){
      if(e.clientX>=d.sx&&e.clientX<=d.sx+d.sw&&e.clientY>=d.sy&&e.clientY<=d.sy+d.sh){
        cylHoverIdx=d.i;
        cylHoverX=(e.clientX-d.sx)/d.sw;
        cylHoverY=(e.clientY-d.sy)/d.sh;
        break;
      }
    }
  } else if(state!=='grid'){
    cylHoverIdx=-1;
  }
});
window.addEventListener('mouseup',()=>{ cylDragging=false; cfDragging=false; });

cvs.addEventListener('wheel',e=>{
  e.preventDefault();
  if(state==='grid'){ cylVel+=(e.deltaX+e.deltaY)*0.0006; autoRotate=false; }
  if(state==='floated'||state==='exploding'){ const d=Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY; cfWheelScroll(d); }
},{passive:false});

['card-stack','scrubber-wrap','header'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener('wheel',e=>{
    if(state==='floated'||state==='exploding'){ e.preventDefault(); cfWheelScroll(Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY); }
  },{passive:false});
});
cvs.addEventListener('click',e=>{
  const ui=['BUTTON','INPUT','SELECT','A'];
  if(ui.includes(e.target.tagName)) return;
  if(e.target.closest('#grid-sizer,#threads,#back-btn,#scrubber-wrap,#pile-overlay,#header')) return;
  if(state!=='grid') return;
  // Hit test against cylinder-projected tiles (front to back)
  for(const d of [...drawnCylTiles].reverse()){
    if(e.clientX>=d.sx&&e.clientX<=d.sx+d.sw&&e.clientY>=d.sy&&e.clientY<=d.sy+d.sh){
      startExplode(e.clientX, e.clientY, d.i);
      break;
    }
  }
});
// Touch for cylinder and coverflow row
let touchStartX=0, touchStartY=0;
cvs.addEventListener('touchstart',e=>{
  touchStartX=e.touches[0].clientX;
  touchStartY=e.touches[0].clientY;
  if(state==='grid'){ cylDragX=e.touches[0].clientX; cylVel=0; cylDragging=true; autoRotate=false; }
  if(state==='floated'||state==='exploding'){ cfDragX=e.touches[0].clientX; cfScrollVel=0; cfDragging=true; }
},{passive:true});

window.addEventListener('touchmove',e=>{
  if(state==='grid'&&cylDragging){
    const dx=e.touches[0].clientX-cylDragX;
    cylAngle+=dx*0.003; cylVel=dx*0.003; cylDragX=e.touches[0].clientX;
  }
  if((state==='floated'||state==='exploding')&&cfDragging){
    const dx=e.touches[0].clientX-cfDragX;
    cfDragX=e.touches[0].clientX;
    cfWheelScroll(-dx*0.5);
    e.preventDefault();
  }
},{passive:false});

window.addEventListener('wheel',e=>{
  if(state==='floated'||state==='exploding'){ e.preventDefault(); cfWheelScroll(Math.abs(e.deltaX)>Math.abs(e.deltaY)?e.deltaX:e.deltaY); }
},{passive:false});
window.addEventListener('touchend',()=>{ cylDragging=false; cfDragging=false; });

cvs.addEventListener('touchend',e=>{
  e.preventDefault();
  const t=e.changedTouches[0];
  if(state!=='grid') return;
  for(const d of [...drawnCylTiles].reverse()){
    if(t.clientX>=d.sx&&t.clientX<=d.sx+d.sw&&t.clientY>=d.sy&&t.clientY<=d.sy+d.sh){
      startExplode(t.clientX,t.clientY,d.i); break;
    }
  }
},{passive:false});

document.getElementById('back-btn').addEventListener('click',()=>{ if(state==='floated'||state==='exploding')startReassemble(); });

document.querySelectorAll('.thread-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    if(state!=='grid')return;
    document.querySelectorAll('.thread-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active'); activeFilter=btn.dataset.filter;
    if(state==='grid'){ buildGrid(); cancelAnimationFrame(animFrame); animFrame=requestAnimationFrame(loopGrid); }
  });
});



document.addEventListener('keydown',e=>{
  if(state!=='floated')return;
  const n=sortedRefs.length;
  if(e.key==='ArrowRight') cfStep(1);
  if(e.key==='ArrowLeft') cfStep(-1);
  if(e.key==='Escape')startReassemble();
});

// ── Pile overlay for multi-image expanded view ────────────────────────────────
(function(){
  const overlay=document.getElementById('pile-overlay');
  const stack=document.getElementById('pile-stack');
  const counter=document.getElementById('pile-counter');
  const closeBtn=document.getElementById('pile-close');
  let pileRef=null, pileIdx=0;
  let pileCards=[]; // cached card refs — avoid re-querying stack.children on every cycle

  function closePile(){
    overlay.hidden=true;
    overlay.classList.remove('open');
  }

  function buildPile(ref){
    pileRef=ref; pileIdx=0;
    stack.innerHTML='';
    const n=imgCount(ref);
    counter.textContent=`${pileIdx+1} / ${n}`;

    // Create stacked cards — slight rotation offsets
    const frag=document.createDocumentFragment();
    for(let i=n-1;i>=0;i--){
      const card=document.createElement('div');
      card.className='pile-card';
      const rot=(i-Math.floor(n/2))*3.5*(Math.random()*0.4+0.8);
      card.style.setProperty('--rot',`${rot}deg`);
      const img=document.createElement('img');
      const im=getImgAt(ref,i);
      if(im) img.src=im.src;
      card.appendChild(img);
      card.dataset.idx=i;
      frag.appendChild(card);
    }
    stack.appendChild(frag);
    pileCards=Array.from(stack.children);

    overlay.hidden=false;
    overlay.classList.add('open');
    updateTop();
  }

  function updateTop(){
    const n=imgCount(pileRef);
    counter.textContent=`${pileIdx+1} / ${n}`;
    // Bring pileIdx card to top — write CSS vars, no transform string concat
    for(let k=0;k<pileCards.length;k++){
      const c=pileCards[k];
      const i=parseInt(c.dataset.idx);
      const offset=i-pileIdx;
      const absOffset=Math.abs(offset);
      c.style.setProperty('--rot',`${offset*3.5}deg`);
      c.style.setProperty('--scale',`${1-absOffset*0.04}`);
      c.style.setProperty('--ty',`${absOffset*6}px`);
      c.style.setProperty('--z',`${n-absOffset}`);
    }
  }

  stack.addEventListener('click',()=>{
    const n=imgCount(pileRef);
    pileIdx=(pileIdx+1)%n;
    updateTop();
  });

  closeBtn.addEventListener('click',closePile);
  overlay.addEventListener('keydown',e=>{ if(e.key==='Escape') closePile(); });

  // Expose openPile globally so expanded view can trigger it
  window.openPile=buildPile;
})();

// In expanded view, clicking the centre card opens pile if multi-image
document.getElementById('card-stack').addEventListener('click',e=>{
  if(state!=='floated') return;
  const centre=floaters.find(f=>f.offset===0);
  if(centre && imgCount(centre.ref)>1){
    // Check click is on centre card area
    const f=centre;
    const{sz,cx,cy}=getCF();
    const sc=1.3, fh=f.sz*sc;
    const natW=f.natRatio?fh*f.natRatio:fh;
    const fw=fh+(natW-fh)*(f.reveal||0);
    const fx=f.x+(f.sz-fw)/2, fy=f.y+(f.sz-fh)/2;
    if(e.clientX>fx&&e.clientX<fx+fw&&e.clientY>fy&&e.clientY<fy+fh){
      window.openPile(centre.ref);
    }
  }
});


// ── Grid size switcher
document.querySelectorAll('.gs-btn').forEach(btn=>{
  btn.addEventListener('click',(e)=>{
    e.stopPropagation();
    document.querySelectorAll('.gs-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    gridSize=btn.dataset.cols;
    if(state==='grid'){
      gridSize=btn.dataset.cols;
      buildGrid();
      tiles.forEach(t=>{ t.popDelay=Math.random()*800; t._popped=false; });
      cylPopStart=performance.now();
      cancelAnimationFrame(animFrame);
      animFrame=requestAnimationFrame(loopGrid);
    }
  });
});

