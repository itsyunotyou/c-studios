---

import Layout from '../layouts/Layout.astro';
import cynthiaData from '../data/cynthia.json';
import cynthiaReferences from '../data/cynthia-references.json';
import libraryText from '../data/library-text.json';
import libraryImage from '../data/library-image.json';
import librarySound from '../data/library-sound.json';

// Cards in the cynthia cylinder: one per project image. The shape matches
// the library cylinder so the rendering code can stay almost identical.
// Each card carries its project slug so hover/click can look up meta.
const references = cynthiaData.cards.map(({ slug, img }) => {
  const proj = cynthiaData.projects[slug];
  // Strip the source extension and point at the existing webp variants
  // (same pattern the home projects panel uses).
  const stem = img.replace(/\.[^.]+$/, '');
  return {
    title: proj.title,
    artist: '',
    year: String(proj.year || ''),
    cat: 'image',
    addedBy: '',
    color: [128, 128, 128],
    img: `${stem}-640w.webp`,
    imgLarge: `${stem}-1280w.webp`,
    imgFull: `${stem}-2560w.webp`,
    images: [],
    imagesFull: [],
    imageTitles: [],
    projectSlug: slug,
  };
});

const referencesJSON = JSON.stringify(references);
const projectsJSON  = JSON.stringify(cynthiaData.projects);

// Build a stem → library entry index so curated references in
// cynthia-references.json can be resolved at build time to real image URLs.
// Most sheet-imported library entries store `image` with no extension at
// all (see prepare-library-images.mjs); only strip a trailing extension
// when there really is one, so those entries still resolve to their
// -thumb/-large variant instead of a URL that was never generated.
const stripExt = (s) => s.replace(/\.(jpe?g|png|webp|gif|tiff?|heic)$/i, '');
const allLibrary = [...libraryText, ...libraryImage, ...librarySound]
  .filter(e => e.image);
const libraryByStem = {};
for (const e of allLibrary) {
  const stem = e.image.replace(/^.*\//, '').replace(/\.(jpe?g|png|webp|gif|tiff?|heic)$/i, '');
  libraryByStem[stem] = {
    title: e.title,
    img: `${stripExt(e.image)}-thumb.webp`,
    imgLarge: `${stripExt(e.image)}-large.webp`,
  };
}

// For every project, resolve its curated reference stems to library tiles.
// Stems that aren't in the library are silently skipped (with a warning at
// build time) — see cynthia-references.json _comment for the format.
const curatedRefs = {};
const missingStems = [];
for (const [slug, stems] of Object.entries(cynthiaReferences)) {
  if (slug.startsWith('_') || !Array.isArray(stems)) continue;
  const tiles = [];
  for (const stem of stems) {
    const tile = libraryByStem[stem];
    if (tile) tiles.push(tile);
    else missingStems.push(`${slug}: ${stem}`);
  }
  curatedRefs[slug] = tiles;
}
if (missingStems.length) {
  console.warn(`[Cynthia] ${missingStems.length} curated reference stems not found in library:`);
  missingStems.forEach(s => console.warn(`  - ${s}`));
}

// Placeholder pool — used only for projects with no curated references yet,
// so the panel doesn't render empty.
const placeholderRefsJSON = JSON.stringify(
  allLibrary.map(e => ({
    title: e.title,
    img: `${stripExt(e.image)}-thumb.webp`,
    imgLarge: `${stripExt(e.image)}-large.webp`,
  }))
);
const curatedRefsJSON = JSON.stringify(curatedRefs);

---

<Layout title="C-STUDIOS — Cynthia">
  <div class="library-root cynthia-root">

<div id="header">
  <!-- Left: info panel always visible -->
  <div id="header-left">
    <div id="info-panel"></div>
  </div>
  <!-- Right: filter dropdown + size toggle -->
  <div id="header-right">
    <!-- Cylinder nav (hidden in row view) -->
    <div id="cyl-nav" style="display:flex;flex-direction:row;gap:14px;align-items:center;">
      <div class="hdr-dropdown" id="filter-drop">
        <button class="hdr-btn" id="filter-btn">
          <span id="filter-label">All</span>
        </button>
        <div class="hdr-menu" id="filter-menu">
          <button class="active" data-filter="all">All</button>
          <button data-filter="Image">Image</button>
          <button data-filter="Sound">Sound</button>
          <button data-filter="Text">Text</button>
        </div>
      </div>
    </div>
    <!-- Back button (shown in row view) -->
    <button id="back-btn" title="Return to grid">
      <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
        <rect x="1" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="9" y="1" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="1" y="9" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <rect x="9" y="9" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </button>
  </div>
  <!-- keep these for JS compatibility -->
  <div id="header-info" style="display:none"></div>
  <div id="threads" style="display:none">
    <button class="thread-btn active" data-filter="all">All</button>
    <button class="thread-btn" data-filter="Image">Image</button>
    <button class="thread-btn" data-filter="Sound">Sound</button>
    <button class="thread-btn" data-filter="Text">Text</button>
  </div>
</div>

<div id="scrubber-wrap">
  <div id="scrubber"><div id="scrubber-track"><div id="scrubber-dot"></div></div></div>
</div>

<canvas id="bg-canvas"></canvas>
<canvas id="grid-canvas"></canvas>

<div id="thumb-strip"></div>
<div id="card-stack"></div>

<div id="detail">
  <div id="detail-img-wrap">
    <img id="detail-img" src="" alt="">
  </div>
</div>

<!-- Pile overlay for multi-image refs -->
<div id="pile-overlay" hidden>
  <div id="pile-close">✕ close</div>
  <div id="pile-counter"></div>
  <div id="pile-stack"></div>
</div>

<!-- ═══ CYNTHIA: rows layout ════════════════════════════════════════ -->
<!-- TOP: project info bar (updates on cylinder hover) -->
<header id="cyn-info-bar" aria-hidden="true">
  <h2 id="cyn-title">—</h2>
  <p id="cyn-category">—</p>
  <p id="cyn-year">—</p>
  <p id="cyn-desc"></p>
</header>

<!-- BOTTOM: horizontal strip of curated references for the hovered project -->
<div id="cyn-ref-strip" aria-hidden="true"></div>

<!-- Expanded view: large clicked image (locked in place) + masonic grid of
     other project images (scrolls within the right column). Reference
     strip stays visible underneath. -->
<div id="cyn-expand" hidden>
  <div id="cyn-expand-img-wrap">
    <img id="cyn-expand-img" src="" alt="" />
  </div>
  <div id="cyn-expand-grid"></div>
</div>
<!-- Close button is fixed to the viewport so it lines up with the project
     title in the info bar — not nested inside #cyn-expand. -->
<button id="cyn-expand-close" type="button" aria-label="Close expanded view" hidden>✕</button>


  </div>
</Layout>

<style is:global>
  /* Library page only — these styles are scoped via .library-root */
  body[data-is-home="false"]:has(.library-root) {
    overflow: hidden;
    cursor: crosshair;
  }
  
  * { margin:0;padding:0;box-sizing:border-box; }
  :root { --red:#C8001A;--black:#0a0a0a;--white:#ffffff;--grey:#555;--gap:3px; }
  html,body { width:100%;height:100%;background:var(--white);overflow:hidden;cursor:crosshair;color:var(--black); }

  /* ── HEADER ── */
  #header {
    position:fixed;top:0;left:0;right:0;z-index:200;
    display:flex;align-items:baseline;justify-content:space-between;
    padding:18px 28px;pointer-events:none;
  }
  #header-left { display:flex;align-items:baseline;pointer-events:all; }
  #header-right { display:flex;flex-direction:row;gap:14px;align-items:baseline;pointer-events:all; }

  /* Info panel — top left, always visible, labels always shown.
     Row rhythm = font * line-height. No row gap so it matches the
     dropdown items below (no extra `gap` margin between rows). */
  #info-panel {
    pointer-events:none;
    display:grid;grid-template-columns:auto auto;gap:0 12px;
    line-height:1.7;
  }
  .info-row { display:contents; }
  .info-label {
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;text-transform:uppercase;
    line-height:1.7;
    color:#bbb;white-space:nowrap;
  }
  .info-value {
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;
    line-height:1.7;
    color:var(--black);white-space:nowrap;
  }
  #info-panel.show { opacity:1; } /* kept for JS compat */

  /* Filter dropdown — right side; follows the services/projects design
     system (label + `+` indicator that rotates 45deg into × when open). */
  .hdr-dropdown { position:relative;display:inline-block; }
  .hdr-btn {
    font-family:inherit;
    font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;
    line-height:1.7;
    color:var(--black);
    background:none;border:none;cursor:crosshair;padding:0;
    display:inline-flex;align-items:center;gap:10px;
  }
  .hdr-btn::before {
    content:'';
    display:inline-block;
    width:12px;
    height:12px;
    flex-shrink:0;
    background-color:currentColor;
    -webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
            mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path d='M6 0v12M0 6h12' stroke='black' stroke-width='1' fill='none'/></svg>") center/contain no-repeat;
    transition:transform 0.2s ease;
  }
  .hdr-dropdown:hover .hdr-btn::before,
  .hdr-dropdown.open .hdr-btn::before { transform:rotate(45deg); }
  .hdr-btn:hover { color:grey; }
  .hdr-menu {
    display:none;position:absolute;top:100%;right:0;margin-top:0;
    background:var(--white);min-width:70px;z-index:500;padding:0;
  }
  .hdr-menu::before {
    content:'';position:absolute;top:-6px;left:0;right:0;height:6px;
  }
  .hdr-dropdown:hover .hdr-menu,
  .hdr-dropdown.open .hdr-menu { display:block; }
  .hdr-menu button {
    display:block;width:100%;text-align:right;padding:0;
    font-family:inherit;
    font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;
    line-height:1.7;
    color:lightgrey;background:none;border:none;cursor:crosshair;
  }
  .hdr-menu button:hover { color:grey; }
  .hdr-menu button.active { display:none; }
  #header-info { display:none; }
  #threads { display:none; }

  /* ── CANVASES ── */
  #bg-canvas,#grid-canvas {
    position:fixed;top:0;left:0;width:100%;height:100%;
  }
  #bg-canvas { z-index:0; }
  #grid-canvas { z-index:2; }

  /* ── DETAIL ── */
  #detail { position:fixed;top:0;left:0;right:0;bottom:0;z-index:200;pointer-events:none; }
  #detail-img-wrap { position:absolute;opacity:0;overflow:hidden;will-change:width,height,left,top; }
  #detail-img { display:block;width:100%;height:100%;object-fit:cover; }

  #back-btn {
    background:none;border:none;cursor:crosshair;
    color:var(--grey);padding:0;
    display:none;align-items:center;justify-content:center;
    transition:color .15s;
    font-family:inherit;
    font-size:0.6rem;letter-spacing:0;text-transform:uppercase;
    gap:6px;
  }
  #back-btn.show { display:flex; }
  #back-btn:hover { color:var(--black); }
  #back-btn svg { width:14px;height:14px; }

  #scrubber-wrap {
    position:fixed;bottom:48px;left:0;right:0;z-index:400;
    display:none;pointer-events:all;cursor:crosshair;
    height:20px;padding:0;
  }
  /* Web: lift scrubber clear of the white footer strip that sits at the
     viewport bottom on non-home pages. */
  @media (min-width: 769px) {
    #scrubber-wrap { bottom: 88px; }
  }
  #scrubber-wrap.show { display:block; }
  #scrubber {
    width:100%;height:100%;
    display:flex;align-items:center;padding:0;
    transform:scaleX(0);transform-origin:left;
  }
  #scrubber.show { display:flex; }
  #scrubber-track { position:relative;width:100%;height:1px;background:var(--grey); }
  #scrubber-dot {
    position:absolute;top:50%;transform:translate(-50%,-50%);
    width:8px;height:8px;border-radius:0;background:#0a0a0a;cursor:crosshair;
  }

  /* ── THUMBNAIL STRIP ── */
  #thumb-strip {
    position:fixed;z-index:250;
    display:none;gap:6px;
    align-items:center;justify-content:center;
    pointer-events:all;
  }
  #thumb-strip.show { display:flex; }
  .thumb-item {
    width:44px;height:44px;cursor:crosshair;
    overflow:hidden;opacity:0.45;transition:opacity .15s;flex-shrink:0;
  }
  .thumb-item.active { opacity:1;outline:1px solid rgba(0,0,0,0.25); }
  .thumb-item:hover { opacity:0.8; }
  .thumb-item img,.thumb-item div { width:100%;height:100%;object-fit:cover;display:block; }
  #card-stack {
    position:fixed;top:0;left:0;right:0;bottom:0;z-index:3;
    pointer-events:none;display:none;
  }
  #card-stack.active { display:block;pointer-events:all; }
  .stack-card { position:absolute;background:transparent;cursor:crosshair; }


  /* ── GRID SIZE TOGGLE ── */
  #grid-sizer { display:none; }
  .gs-btn {
    background:none;border:none;cursor:crosshair;padding:0;
    color:var(--grey);opacity:0.45;transition:opacity .15s;
    display:flex;align-items:center;justify-content:center;
  }
  .gs-btn:hover { opacity:0.8; }
  .gs-btn.active { opacity:1; }

  /* ── WORDPRESS NAV SPACING ──
     The library is full-screen fixed-position. When embedded in an Elementor
     HTML widget on a WordPress page, this CSS leaves space at the top so the
     site's main nav appears above the library instead of being overlaid.
     Adjust --nav-h to match your actual nav height (inspect in DevTools first).
  */
  :root { --nav-h: 60px; }
  #header, #bg-canvas, #grid-canvas, #thumb-strip {
    top: var(--nav-h) !important;
  }
  #bg-canvas, #grid-canvas {
    height: calc(100% - var(--nav-h)) !important;
  }


.hdr-btn, .hdr-menu button{
  font-size: 0.7rem;
    letter-spacing: 0.05em;
}
@media (max-width: 767px) {
  #header {
    padding: 0;
    pointer-events: none;
  }

  /* Info panel — same vertical level as the filter button on the right.
     Reserve room on the right so the values never run into the ALL+ button. */
  #header-left {
    position: fixed;
    top: calc(var(--cst-nav-bottom) + 28px);
    left: 12px;
    right: 100px;
    z-index: 100;
    pointer-events: auto;
    justify-content: flex-start;
  }

  #info-panel {
 
    display: grid;
    grid-template-columns: auto 1fr;
    /* Always reserve 2 lines per row whether the value wraps or not,
       so CREATOR / YEAR / ADDED BY don't shift down when a long TITLE
       wraps onto two lines. Cells are vertically centred so a 1-line
       value still baselines with the matching dropdown item.
       Rem-based so the row height computes the same as the dropdown
       items (em on the panel resolves to its inherited 16px, not the
       0.6rem cell font, which used to be the mismatch). */
    grid-auto-rows: 1.8rem;
    gap: 0 12px;
    padding: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-radius: 0;
    width: auto;
    max-width: 100%;
  }

  #info-panel .info-row:last-child {
    display: none;
  }

  /* Match the .hdr-btn / .hdr-menu button size + line-height so each
     info row baselines with the corresponding dropdown row. */
  #info-panel .info-label,
  #info-panel .info-value {
    font-size: 0.6rem;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* Long values wrap onto multiple lines within the row rather than
     overlapping the ALL+ button. Both label and value are vertically
     centred in the 3.4em cell so 1-line values sit on the same y as
     the dropdown item next to them. */
  #info-panel .info-value {
    white-space: normal;
    overflow-wrap: anywhere;
    min-width: 0;
    align-self: start;
  }
  #info-panel .info-label { align-self: start; }

  /* Dropdown menu items and the ALL button render as 1.8rem slots so
     each one baselines with one info-panel row (TITLE / CREATOR /
     YEAR / ADDED BY). Content is top-aligned so the dropdown text
     starts at the same y as the info-panel labels (which use
     align-self: start in their grid cells). */
  .hdr-btn,
  .hdr-menu button {
    line-height: 1.2;
    padding: 0;
    min-height: 1.8rem;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
  }
  .hdr-btn { gap: 10px; }

  /* Filter dropdown — same vertical anchor as #header-left so the ALL+
     button baselines with TITLE, and the dropdown items (when open)
     fall on the same y as the rest of the info rows. */
  #header-right {
    position: fixed;
    top: calc(var(--cst-nav-bottom) + 28px);
    right: 12px;
    z-index: 100;
    min-height: 6.8em;
  }

  .hdr-btn,
  .hdr-menu button {
    font-size: 0.6rem;
    letter-spacing: 0;
  }

  #bg-canvas,
  #grid-canvas {
    height: calc(100vh - 100px) !important;
  }
}

#info-panel .info-row:last-child {
  display: none;
}
  @media (min-width: 768px) {
    .info-label,
    .info-value {
      font-size: 0.7rem;
      letter-spacing: 0.05em;
    }
  }


  /* Pile overlay for multi-image refs */
  #pile-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    pointer-events: all;
    cursor: crosshair;
  }
  #pile-overlay[hidden] { display: none; }
  #pile-overlay.open {
    background: rgba(255, 255, 255, 0.92);
  }
  #pile-close {
    position: absolute;
    top: 20px;
    left: 28px;
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--grey);
    cursor: crosshair;
    z-index: 2;
  }
  #pile-counter {
    position: absolute;
    top: 20px;
    right: 28px;
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--grey);
  }
  #pile-stack {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Stacked cards inside the pile use CSS custom props set from JS */
  .pile-card {
    position: absolute;
    width: min(55vw, 420px);
    aspect-ratio: 1;
    cursor: crosshair;
    transform: rotate(var(--rot, 0deg)) scale(var(--scale, 1)) translateY(var(--ty, 0px));
    transition: transform 0.3s ease;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
    background: #eee;
    overflow: hidden;
    z-index: var(--z, 1);
  }
  .pile-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ═══ CYNTHIA: rows layout ════════════════════════════════════════════ */
  /* Inherited library DOM bits we don't use on cynthia — info-panel (the
     mobile TITLE/CREATOR list) and the filter dropdown header. */
  .cynthia-root #header-left,
  .cynthia-root #header-right,
  .cynthia-root #info-panel,
  .cynthia-root #cyl-nav { display: none !important; }
  /* Cynthia is desktop-only — show a "view on desktop" message on mobile
     and hide everything else (cylinder, panels, references). */
  @media (max-width: 768px) {
    .cynthia-root #header,
    .cynthia-root #scrubber-wrap,
    .cynthia-root #bg-canvas,
    .cynthia-root #grid-canvas,
    .cynthia-root #cyn-info-bar,
    .cynthia-root #cyn-ref-strip,
    .cynthia-root #cyn-expand,
    .cynthia-root #cyn-expand-close { display: none !important; }
    .cynthia-root::before {
      content: "CYNTHIA IS BEST VIEWED ON DESKTOP.";
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: #0a0a0a;
      background: white;
      z-index: 400;
    }
  }

  /* Three stacked rows: info bar at the top, cylinder in the middle (the
     library canvas is full-viewport for math simplicity — we just reserve
     space top/bottom via the cylinder's HEADER_H/FOOTER_H constants), and
     a horizontal reference strip at the bottom.                          */
  .cynthia-root #cyn-info-bar {
    position: fixed;
    top: 56px;                        /* sits just below the nav strip */
    left: 0;
    right: 0;
    z-index: 250;
    background: white;
    padding: 14px 24px 16px;
    box-sizing: border-box;
    display: grid;
    /* Three rows: title (row 1), category + year (row 2), description
       (row 3). Category and year sit together on the LEFT side of row 2. */
    grid-template-columns: auto auto 1fr;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "title    title  title"
      "category year   ."
      "desc     desc   desc";
    column-gap: 16px;
    row-gap: 6px;
    pointer-events: none;
    min-height: 96px;
  }
  .cynthia-root #cyn-info-bar h2 {
    grid-area: title;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #0a0a0a;
    margin: 0;
    font-weight: 400;
    line-height: 1.3;
  }
  .cynthia-root #cyn-info-bar #cyn-category {
    grid-area: category;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: grey;
    margin: 0;
  }
  .cynthia-root #cyn-info-bar #cyn-year {
    grid-area: year;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: grey;
    margin: 0;
    white-space: nowrap;
  }
  .cynthia-root #cyn-info-bar #cyn-desc {
    grid-area: desc;
    font-size: 0.65rem;
    line-height: 1.5;
    color: #0a0a0a;
    letter-spacing: 0.02em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Bottom reference strip — single horizontal row, full viewport width,
     no gaps, fixed height. Each tile keeps its image's natural aspect
     ratio (height pinned, width auto) so the row reads as a continuous
     mosaic. Scrolls horizontally on overflow. */
  .cynthia-root #cyn-ref-strip {
    position: fixed;
    left: 0;
