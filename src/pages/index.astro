      // menu without switching; any subsequent tap closes the menu and
      // proceeds with the normal switch.
      if (window.innerWidth <= 768) {
        if (!tabsEl.classList.contains('open')) {
          tabsEl.classList.add('open');
          return;
        }
        tabsEl.classList.remove('open');
      }
