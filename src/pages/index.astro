<!-- HERO SCRIPT (moon, slideshow, text animation)                 -->
<!-- ════════════════════════════════════════════════════════════ -->
<script is:inline>
function prepareMobileSubtextEarly() {
  const isPhone = window.matchMedia('(max-width: 767px)').matches;
  if (!isPhone) return;
  const sub = document.getElementById('subText');
  if (!sub) return;
  sub.innerHTML =
    '<span class="line">IS A CREATIVE STRATEGY STUDIO </span>' +
    '<span class="line">WORKING ACROSS CULTURAL RESEARCH, </span>' +
    '<span class="line">CONCEPTS, CREATIVE DIRECTION, CONSULTING, AND CURATION.</span>';
  sub.style.opacity = '0';
  sub.style.transform = 'translateX(140vw)';
  sub.style.visibility = 'hidden';
}

function swapMobileImages() {
  if (!window.matchMedia('(max-width: 767px)').matches) return;
  const mobileUrls = [];
  document.querySelectorAll('#flashSequence .flash-img').forEach(img => {
    const m = img.getAttribute('data-mobile');
    if (m && img.src !== m) {
      mobileUrls.push(m);
      img.src = m;
      img.loading = 'eager';
    }
  });
  mobileUrls.slice(0, 3).forEach(url => {
    const preloadImg = new Image();
    preloadImg.src = url;
  });
}

function setRealVH() {
  const vh = window.innerHeight * 0.01;
  document.documentElement.style.setProperty('--vh', `${vh}px`);
  if (window.innerWidth <= 767) {
    document.body.style.overflow = 'hidden';
  }
}

function syncHoleToMoon(durationMs = 5000) {
  const moon = document.querySelector('.moon');
  const hole = document.getElementById('revealHole');
  const rim = document.getElementById('holeRim');
  if (!moon || !hole || !rim) return;
  let start = performance.now();
  function tick(now) {
    const r = moon.getBoundingClientRect();
    const cx = r.left + r.width/2;
    const cy = r.top + r.height/2;
    const radius = r.width/2;
    hole.style.setProperty('--mx', cx + 'px');
    hole.style.setProperty('--my', cy + 'px');
    hole.style.setProperty('--mr', radius + 'px');
    rim.style.width = r.width + 'px';
    rim.style.height = r.height + 'px';
    rim.style.left = (cx - radius) + 'px';
    rim.style.top = (cy - radius) + 'px';
    if (now - start < durationMs) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
window.scrollTo(0, 0);

function startSlideshow() {
  const images = document.querySelectorAll('#flashSequence .flash-img');
  if (!images.length) return;
  images.forEach((img, index) => {
    const isMobile = window.innerWidth <= 767;
    const heightValue = isMobile ? 'calc(var(--vh) * 100)' : '100vh';
    // On mobile, align images 01 (index 0) and 06 (index 5) to the left
    let objectPosition;
if (isMobile && (index === 0 || index === 5)) {
  objectPosition = 'left center';
} else if (!isMobile && (index === 0 || index === 5 || index === 9)) {
  objectPosition = 'center top';
} else {
  objectPosition = 'center center';
}
    img.style.cssText += `
      opacity: 0 !important;
      transition: opacity 1.2s ease-in-out !important;
      z-index: 0 !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: ${heightValue} !important;
      object-fit: cover !important;
      object-position: ${objectPosition} !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100vw !important;
      min-height: ${heightValue} !important;
      transform: scale(1) !important;
    `;
  });

  let current = 0;
  images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
  images[current].classList.add('active');

  setInterval(() => {
    const prev = current;
    current = (current + 1) % images.length;
    images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
    images[current].classList.add('active');
    setTimeout(() => {
      images[prev].style.cssText += 'opacity: 0 !important; z-index: 0 !important;';
      images[prev].classList.remove('active');
    }, 600);
  }, 1200);
}

// Main animation sequence
setTimeout(() => {
  prepareMobileSubtextEarly();
  swapMobileImages();
  setRealVH();

  // Skip intro on revisits — go straight to slideshow
  let introSeen = false;
  try { introSeen = sessionStorage.getItem('cst-intro-seen') === 'true'; } catch (e) {}
  if (introSeen) {
    const m = document.querySelector('.moon');
    if (m) m.style.display = 'none';
    const h = document.getElementById('revealHole');
    if (h) h.style.display = 'none';
    const r = document.getElementById('holeRim');
    if (r) r.style.display = 'none';
    const hero = document.getElementById('cstHero');
    if (hero) hero.style.backgroundColor = 'transparent';
    if (window.innerWidth <= 767) {
      const sub = document.getElementById('subText');
      if (sub) {
        sub.style.visibility = 'visible';
        sub.style.opacity = '1';
        sub.style.transform = 'translateX(0)';
      }
    }
    startSlideshow();
    return;
  }

  const moon = document.querySelector('.moon');
  if (!moon) return;

  syncHoleToMoon(5200);

  const overhangRatio = (window.innerWidth <= 767) ? 0.45 : 0.10;
  const r0 = moon.getBoundingClientRect();
  const overhangPx = r0.width * overhangRatio;
  moon.style.transform = `translateY(-50%) translateX(${-(r0.width - overhangPx)}px)`;

  moon.addEventListener('transitionend', function onMoonSlideEnd(e) {
    if (e.propertyName !== 'transform') return;
    moon.removeEventListener('transitionend', onMoonSlideEnd);

    moon.style.transition = 'transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1), opacity 1s ease-in';
    moon.style.transform = 'translateY(-50%) translateX(-72vw) scale(2.3)';

    moon.addEventListener('transitionend', function onExpandEnd(ev) {
      if (ev.propertyName !== 'transform') return;
      moon.removeEventListener('transitionend', onExpandEnd);

      const hole = document.getElementById('revealHole');
      const rim = document.getElementById('holeRim');
      if (hole) hole.style.opacity = '0';
      if (rim) rim.style.opacity = '0';
      const hero = document.getElementById('cstHero');
      if (hero) hero.style.backgroundColor = 'transparent';

      setTimeout(() => startSlideshow(), 200);
      try { sessionStorage.setItem('cst-intro-seen', 'true'); } catch (e) {}
    }, { once: true });
  });

  // Mobile subText slide-in (parallel to moon)
  setTimeout(() => {
    if (window.innerWidth <= 767) {
      const sub = document.getElementById('subText');
      if (sub) {
        sub.style.visibility = 'visible';
        sub.style.transform = 'translateX(140vw)';
        sub.style.opacity = '0';
        sub.offsetHeight;
        sub.style.transition = 'transform 900ms cubic-bezier(0.22,1,0.36,1), opacity 900ms ease-out';
        sub.style.transform = 'translate3d(0,0,0)';
        sub.style.opacity = '1';
      }
    }
  }, 2500);

}, 100);
// ════════════════════════════════════════════════════════════
// PROJECTS — tab switching + expandable rows
// ════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  // Tab switching
  const pTabs = document.querySelectorAll('.projects-tab');
  const pPanels = document.querySelectorAll('.projects-panel');
  pTabs.forEach((tab) => {
    tab.onclick = () => {
      const target = tab.getAttribute('data-target');
      pTabs.forEach((t) => t.classList.toggle('active', t === tab));
      pPanels.forEach((p) => {
        p.classList.remove('active');
        void p.offsetWidth;
        if (p.getAttribute('data-tab') === target) p.classList.add('active');
      });
    };
  });

  // Row expand / collapse on click of the summary button
  document.querySelectorAll('.project-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.project-row');
      if (!row) return;
      const isOpen = row.classList.contains('expanded');
      // Close any other open rows in the same panel
      row.parentElement?.querySelectorAll('.project-row.expanded').forEach((r) => {
        if (r !== row) r.classList.remove('expanded');
      });
      row.classList.toggle('expanded', !isOpen);
    });
  });
});

function initProjectImageAutoScroll() {
  document.querySelectorAll('.project-row').forEach(row => {
    const strip = row.querySelector('.project-images');
    if (!strip) return;

    let direction = 1;
    const speed = window.innerWidth <= 767 ? 0.4 : 0.6;
    let isPaused = false;
    let resumeTimer;

    function tick() {
      if (row.classList.contains('expanded') && !isPaused) {
        const max = strip.scrollWidth - strip.clientWidth;
        if (max > 0) {
          let next = strip.scrollLeft + (direction * speed);
          if (next >= max) { direction = -1; next = max; }
          if (next <= 0) { direction = 1; next = 0; }
          strip.scrollLeft = next;
        }
      }
      requestAnimationFrame(tick);
    }

    function pauseTemp(delay = 1500) {
      isPaused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { isPaused = false; }, delay);
    }

    strip.addEventListener('mouseenter', () => { isPaused = true; });
    strip.addEventListener('mouseleave', () => pauseTemp(800));

    const scrubber = strip.nextElementSibling;
    if (scrubber && scrubber.classList.contains('scrubber')) {
      scrubber.addEventListener('mouseenter', () => { isPaused = true; });
      scrubber.addEventListener('mouseleave', () => pauseTemp(800));
    }

    strip.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
    strip.addEventListener('touchend', () => pauseTemp(2000), { passive: true });
    strip.addEventListener('wheel', () => pauseTemp(1500), { passive: true });

    tick();
  });
}

if (document.readyState === 'complete' || document.readyState === 'interactive') {
  initProjectImageAutoScroll();
} else {
  document.addEventListener('DOMContentLoaded', initProjectImageAutoScroll);
}
