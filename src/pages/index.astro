function initProjectImageAutoScroll() {
  // Constant pixel-per-second speed — same on web and mobile, independent
  // of refresh rate and image count.
  const SPEED_PX_PER_SEC = 90;

  document.querySelectorAll('.project-row').forEach(row => {
    const strip = row.querySelector('.project-images');
    if (!strip) return;

    let direction = 1;
    let isPaused = false;
    let resumeTimer;
    let lastTs = 0;

    // Pause at each end before reversing — gives the eye a moment to land
    // on the last/first image before the strip starts scrubbing back.
    const END_PAUSE_MS = 1000;
    let endPauseUntil = 0;

    function tick(ts) {
      // Reset the timestamp baseline whenever the row isn't actively
      // scrolling (collapsed or paused). Otherwise lastTs lingers from a
      // previous expansion and the first frame after re-opening has a huge
      // dt — the strip leaps to one boundary and "stops".
      const expanded = row.classList.contains('expanded');
      if (!expanded || isPaused) {
        lastTs = 0;
        requestAnimationFrame(tick);
        return;
      }
      // Holding at an end — wait, don't accumulate dt.
      if (ts < endPauseUntil) {
        lastTs = ts;
        requestAnimationFrame(tick);
        return;
      }
      const dt = lastTs ? (ts - lastTs) / 1000 : 0;
      lastTs = ts;

      const max = strip.scrollWidth - strip.clientWidth;
      if (max > 0) {
        const current = strip.scrollLeft;
        let next = current + (direction * SPEED_PX_PER_SEC * dt);
        // Only trigger the end-pause when we actually CROSS the boundary
        // this frame (current < max → next >= max). Without the `current`
        // check, frame 1 has dt = 0 → next = current = 0, which fires the
        // left-end pause immediately and the strip never starts moving.
        if (next >= max && current < max) {
          direction = -1; next = max; endPauseUntil = ts + END_PAUSE_MS;
        } else if (next <= 0 && current > 0) {
          direction = 1; next = 0; endPauseUntil = ts + END_PAUSE_MS;
        } else {
          next = Math.max(0, Math.min(max, next));
        }
        strip.scrollLeft = next;
      }
      requestAnimationFrame(tick);
    }

    function pauseTemp(delay = 1500) {
      isPaused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { isPaused = false; }, delay);
    }

    // Only attach hover-pause on devices that actually have a hover-capable
    // pointer (desktop mice / trackpads). iOS Safari synthesises mouseenter
    // on tap and on stray pointer movements during panel scroll — both
    // would stick `isPaused = true` indefinitely (mouseleave never fires
    // on touch), so the autoscroll silently froze on mobile.
    const hasHover = window.matchMedia('(hover: hover)').matches;
    if (hasHover) {
      strip.addEventListener('mouseenter', () => { isPaused = true; });
      strip.addEventListener('mouseleave', () => pauseTemp(800));
      const scrubber = strip.nextElementSibling;
      if (scrubber && scrubber.classList.contains('scrubber')) {
        scrubber.addEventListener('mouseenter', () => { isPaused = true; });
        scrubber.addEventListener('mouseleave', () => pauseTemp(800));
      }
    }

    // Only pause on touch if the user is ACTUALLY dragging the strip
    // (moves > 6px). Mobile Safari fires synthetic mouseenter on tap +
    // touchstart fires every time the user scrolls the project panel
    // vertically — both used to stick `isPaused = true` even though the
    // user never interacted with the strip itself.
    let touchStartedX = 0, touchStartedY = 0, touchActive = false;
    strip.addEventListener('touchstart', (e) => {
      touchStartedX = e.touches[0].clientX;
      touchStartedY = e.touches[0].clientY;
      touchActive = false;
    }, { passive: true });
    strip.addEventListener('touchmove', (e) => {
      if (touchActive) return;
      const dx = Math.abs(e.touches[0].clientX - touchStartedX);
      const dy = Math.abs(e.touches[0].clientY - touchStartedY);
      // Treat horizontal drag as a real scrub; vertical drag is the panel
      // scrolling — leave the autoscroll alone.
      if (dx > 6 && dx > dy) { touchActive = true; isPaused = true; }
    }, { passive: true });
    strip.addEventListener('touchend', () => {
      if (touchActive) pauseTemp(2000);
      touchActive = false;
    }, { passive: true });
    strip.addEventListener('wheel', () => pauseTemp(1500), { passive: true });

    // Failsafe: whenever the row is collapsed, clear any sticky pause
    // state so re-opening always restarts cleanly.
    const obs = new MutationObserver(() => {
      if (!row.classList.contains('expanded')) {
        isPaused = false;
        endPauseUntil = 0;
        clearTimeout(resumeTimer);
      }
    });
    obs.observe(row, { attributes: true, attributeFilter: ['class'] });

    requestAnimationFrame(tick);
  });
}

