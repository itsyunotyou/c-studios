/* INFO — Venn layout                                            */
/* ════════════════════════════════════════════════════════════ */
/* ════════════════════════════════════════════════════════════ */
/* INFO — Venn diagram with split-from-one animation             */
/* ════════════════════════════════════════════════════════════ */
.info-section {
  height: 100vh;
  width: 100%;
  background: white;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  box-sizing: border-box;
  overflow: hidden;
}

.info-wrap {
  width: 100%;
  max-width: 1700px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

.info-venn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16px;
  width: 100%;
}

.venn-text {
  flex: 0 1 180px;
  min-width: 0;
  font-size: 0.5rem;
  line-height: 1.7;
  color: #0a0a0a;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0;
}
.venn-text-left  { text-align: right; }
.venn-text-right { text-align: left;  }

.venn-stage {
  position: relative;
  flex: 0 1 540px;
  width: 100%;
  max-width: min(540px, calc((100vh - 360px) * 1.357));
  aspect-ratio: 456 / 336;
}

.venn-svg {
  width: 100%;
  height: 100%;
  display: block;
}

.venn-circle {
  fill: none;
  stroke: rgba(10, 10, 10, 0.55);
  stroke-width: 1;
}

.venn-label {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #0a0a0a;
  font-weight: 400;
  white-space: nowrap;
  pointer-events: none;
}
.venn-label-left  { left: 3.5%;  }
.venn-label-right { right: 3.5%; }

.venn-c-logo {
  /* SVG <image> respects PNG transparency; no fill needed */
}

.info-body {
  max-width: 700px;
  margin: 0 auto;
  text-align: left;
  position: relative;          /* anchor for the dots overlay */
}

/* Each character is wrapped in <span class="letter"> at run-time; the
   dot animation reveals them one-by-one (typewriter). */
.info-section .letter {
  opacity: 0;
  transition: opacity 0.18s ease;
}
.info-section .letter.reveal { opacity: 1; }

.info-dots-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.info-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 3px;
  height: 3px;
  background: #0a0a0a;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.12s ease, transform 0.18s ease;
}

.info-paragraph {
  font-size: 0.7rem;
  line-height: 1.8;
  color: #0a0a0a;
  font-weight: 400;
  margin: 0 0 1.5em;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-align: left;
}
.info-paragraph:last-child { margin-bottom: 0; }


/* ─── INITIAL STATES (before scroll-in) ─── */

/* Both circles start at the center — overlapping perfectly so they read as ONE circle */
.venn-circle-left  { transform: translateX(60px);  }   /* shifts cx 340 → visual 400 */
.venn-circle-right { transform: translateX(-60px); }   /* shifts cx 460 → visual 400 */
.venn-circle {
  transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1) 0.3s;
}

/* Labels start hidden — fade in at their final position inside the circles after the split */
.venn-label-left,
.venn-label-right { opacity: 0; }
.venn-label-left  { transition: opacity 0.6s ease 1.5s; }
.venn-label-right { transition: opacity 0.6s ease 1.7s; }

/* C logo waits for the split to settle, then materializes in discrete steps (no bounce) */
.venn-c-logo {
  opacity: 0;
  transition: opacity 0.6s steps(8, end) 2.2s;
  /* base transform set in .venn-c-logo above; not animated here */
}

/* Side captions still fade in; paragraphs are revealed by the dot-to-letter
   animation, so the container itself stays visible. */
.venn-text {
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity 1s ease,
    transform 1s cubic-bezier(0.22, 1, 0.36, 1);
}


/* ─── IN-VIEW STATES (animated) ─── */

.info-section.in-view .venn-circle-left,
.info-section.in-view .venn-circle-right {
  transform: translateX(0);
}

.info-section.in-view .venn-label-left,
.info-section.in-view .venn-label-right {
  opacity: 1;
}

.info-section.in-view .venn-c-logo {
  opacity: 1;
}

.info-section.in-view .venn-text {
  opacity: 1;
  transform: translateY(0);
}
.info-section.in-view .venn-text-left  { transition-delay: 2.4s; }
.info-section.in-view .venn-text-right { transition-delay: 2.6s; }

/* paragraph-level reveal is handled by per-letter dot animation now */


/* ─── Mobile ─── */
@media (max-width: 768px) {
  .info-section {
    height: 100dvh;
    padding: 48px 20px;
    justify-content: center;
  }
  .info-wrap { gap: 32px; max-width: 480px; }
  .info-venn {
    flex-direction: column;
    gap: 0;
  }
  .venn-text { display: none; }
  .venn-stage {
    flex: 0 0 auto;
    width: 100%;
    max-width: 100%;
    align-self: center;
  }
  .venn-label {
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }
  .venn-label-left  { left: 6%;  }
  .venn-label-right { right: 6%; }
  .info-paragraph {
    font-size: 0.62rem;
    line-height: 1.7;
    margin-bottom: 1.2em;
  }
}
