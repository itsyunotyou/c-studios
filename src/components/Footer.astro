---
// Footer — logo bottom-left, text bottom-right.
// Colors switch based on body.bg-dark (set by Header script).
---

<footer class="cst-footer">
  <a href="/" class="cst-footer-logo" aria-label="C-STUDIOS home">
    <img src="/images/brand/c-studios-logo.png" alt="C-STUDIOS" />
  </a>
  <div class="cst-footer-links">
    <a href="mailto:info@c-studios.co.uk">INFO@C-STUDIOS.CO.UK</a>
    <span class="cst-footer-copy">©C-STUDIOS, 2026.</span>
  </div>
</footer>

<style is:global>
  .cst-footer {
    position: fixed;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 9998;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    pointer-events: none;
  }

  .cst-footer-logo {
    pointer-events: auto;
    display: block;
    line-height: 0;
    transition: filter 0.25s ease;
  }
  .cst-footer-logo img {
    height: 20px;
    width: auto;
    display: block;
  }
  /* Invert the black logo on dark backgrounds so it stays visible */
  body.bg-dark .cst-footer-logo { filter: invert(1); }

  .cst-footer-links {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: lightgrey;
    transition: color 0.25s ease;
  }
  .cst-footer-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .cst-footer-links a:hover { color: grey; }
  .cst-footer-copy { white-space: nowrap; }

  /* mix-blend removed — keep explicit colours. (mix-blend was contributing
     to the iOS Safari fixed-positioning bug on the nav; removing it here
     too for consistency and to avoid surprise interactions.) */
  body.bg-dark .cst-footer-links { color: lightgrey; }
  body.bg-dark .cst-footer-links a:hover { color: grey; }
  /* Logo's invert filter stays so a black PNG remains visible on dark bg. */

  /* Non-home pages (library): solid white strip across the bottom so footer
     text stays legible over the cylinder photos. Home stays transparent /
     mix-blend so the full-bleed hero image isn't interrupted. The padding
     keeps the footer content at the same y as the floating home footer
     (bottom: 20px → padding-bottom: 20px) so the y position doesn't visibly
     shift when switching between pages. */
  body[data-is-home="false"] .cst-footer {
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: white;
    mix-blend-mode: normal;
  }
  body[data-is-home="false"].bg-dark .cst-footer-logo { filter: none; }
  body[data-is-home="false"].bg-dark .cst-footer-links { color: lightgrey; }

  @media (max-width: 768px) {
    .cst-footer {
      bottom: 12px;
      left: 12px;
      right: 12px;
    }
    /* On home, give the footer a white fill when scrolled OFF the hero
       (any section that isn't bg-dark). The hero itself stays transparent
       with mix-blend so the full-bleed image isn't broken up. */
    body[data-is-home="true"]:not(.bg-dark) .cst-footer {
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px 12px calc(env(safe-area-inset-bottom, 0px) + 12px);
      background: white;
      mix-blend-mode: normal;
    }
    /* padding-bottom matches the home footer's bottom: 12px so content
       sits at the same y; safe-area inset is added on notched devices. */
    body[data-is-home="false"] .cst-footer {
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px 12px calc(env(safe-area-inset-bottom, 0px) + 12px);
    }
    .cst-footer-logo img { height: 10px; }
    .cst-footer-links {
      flex-direction: row;
      align-items: center;
      gap: 10px;
      font-size: 0.55rem;
    }
  }
</style>