// ═══ CYNTHIA: info-bar + ref-strip + click-expand grid ═══════════════════
(function cynInit() {
  const titleEl = document.getElementById('cyn-title');
  const catEl   = document.getElementById('cyn-category');
  const yearEl  = document.getElementById('cyn-year');
  const descEl  = document.getElementById('cyn-desc');
  const stripEl = document.getElementById('cyn-ref-strip');
  const expEl   = document.getElementById('cyn-expand');
  const expImg  = document.getElementById('cyn-expand-img');
  const expGrid = document.getElementById('cyn-expand-grid');
  const expClose= document.getElementById('cyn-expand-close');

  // Stable hash so the placeholder ref strip is deterministic per project.
  function hash(s) {
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = (h * 16777619) >>> 0; }
    return h;
  }

  function refsForProject(slug) {
    // Use curated references from cynthia-references.json when present.
    // Falls back to deterministic placeholder samples for projects that
    // don't have curated references yet so the strip doesn't render empty.
    const curated = CYN_CURATED_REFS[slug];
    if (curated && curated.length) return curated;
    const seed = hash(slug);
    const out = [];
    for (let i = 0; i < 12 && i < CYN_PLACEHOLDER_REFS.length; i++) {
      out.push(CYN_PLACEHOLDER_REFS[(seed + i * 7919) % CYN_PLACEHOLDER_REFS.length]);
    }
    return out;
  }

  let lastSlug = null;
  function renderInfo(slug) {
    if (slug === lastSlug) return;
    lastSlug = slug;
    const proj = CYN_PROJECTS[slug];
    if (!proj) return;
    titleEl.textContent = proj.title;
    catEl.textContent   = proj.category || '';
    yearEl.textContent  = proj.year || '';
    descEl.textContent  = proj.description || '';
    stripEl.scrollLeft = 0;
    stripEl.innerHTML = '';
    for (const ref of refsForProject(slug)) {
      const tile = document.createElement('div');
      tile.className = 'cyn-ref';
      const img = document.createElement('img');
      img.loading = 'lazy';
      img.src = ref.img;
      img.alt = ref.title || '';
      img.addEventListener('load', () => img.classList.add('loaded'));
      tile.appendChild(img);
      stripEl.appendChild(tile);
    }
  }

  // Patch updateMeta so every cylinder hover/scrub update also refreshes
  // the top info bar + bottom reference strip — but freeze updates while
  // the expand view is open so the user's selection stays pinned in the
  // info bar / ref strip regardless of where the cursor is.
  const origUpdateMeta = updateMeta;
  updateMeta = function patchedUpdateMeta(ref) {
    if (!expEl.hidden) return;        // expand open → ignore cylinder hovers
    origUpdateMeta(ref);
    if (ref && ref.projectSlug) renderInfo(ref.projectSlug);
  };

  // Override the cylinder click handler: open the cynthia expand view with
  // the big image + masonry grid of the project's other images, instead of
  // letting the library coverflow transition fire.
  cvs.addEventListener('click', (e) => {
    if (state !== 'grid') return;
    const ui = ['BUTTON','INPUT','SELECT','A'];
    if (ui.includes(e.target.tagName)) return;
    if (e.target.closest('#grid-sizer,#threads,#back-btn,#scrubber-wrap,#pile-overlay,#header,#cyn-info-bar,#cyn-ref-strip,#cyn-expand')) return;
    for (const d of [...drawnCylTiles].reverse()) {
      if (e.clientX >= d.sx && e.clientX <= d.sx + d.sw && e.clientY >= d.sy && e.clientY <= d.sy + d.sh) {
        const ref = REFS[d.i];
        if (!ref || !ref.projectSlug) return;
        e.stopImmediatePropagation();
        openExpand(ref);
        break;
      }
    }
  }, true);

  function openExpand(ref) {
    const proj = CYN_PROJECTS[ref.projectSlug];
    if (!proj) return;
    expImg.src = ref.imgLarge || ref.imgFull;
    expImg.alt = proj.title;
    // Masonry grid = every OTHER image in the project (exclude the one
    // already shown big). Clicking one promotes it to the big slot and
    // demotes the previous big back into the grid.
    expGrid.innerHTML = '';
    const activeBig = ref.imgLarge;
    proj.images.forEach((srcUrl) => {
      const stem = srcUrl.replace(/\.[^.]+$/, '');
      const bigUrl = `${stem}-1280w.webp`;
      if (bigUrl === activeBig) return;
      const cell = document.createElement('div');
      cell.className = 'cyn-extra';
      const img = document.createElement('img');
      img.loading = 'lazy';
      img.src = `${stem}-640w.webp`;
      img.alt = proj.title;
      img.addEventListener('load', () => img.classList.add('loaded'));
      cell.appendChild(img);
      cell.addEventListener('click', () => {
        openExpand({ ...ref, imgLarge: bigUrl, imgFull: bigUrl.replace('-1280w.webp', '-2560w.webp') });
      });
      expGrid.appendChild(cell);
    });
    renderInfo(ref.projectSlug);
    expEl.hidden = false;
    expClose.hidden = false;
  }

  function closeExpand() {
    expEl.hidden = true;
    expClose.hidden = true;
    expImg.src = '';
    expGrid.innerHTML = '';
  }

  expClose.addEventListener('click', closeExpand);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !expEl.hidden) closeExpand();
  });
})();
</script>
