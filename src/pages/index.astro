---
import Layout from '../layouts/Layout.astro';
import services from '../data/services.json';
import clients from '../data/clients.json';
import projectsData from '../data/projects.json';
import '../styles/home.css';
---

<Layout title="C-STUDIOS">
  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- C-STUDIOS / Hero with moon animation                          -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="cstudios">
    <div class="cst-hero" id="cstHero">
      <!-- Slideshow (inside #cstHero so mix-blend works on .container) -->
  <!-- Slideshow -->
      <div id="flashSequence" class="cst-stage">
        <img
          src="/images/hero/intro01-1280w.webp"
          srcset="/images/hero/intro01-640w.webp 640w, /images/hero/intro01-828w.webp 828w, /images/hero/intro01-1280w.webp 1280w, /images/hero/intro01-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="eager" fetchpriority="high" decoding="sync" />
        <img
          src="/images/hero/intro02-1280w.webp"
          srcset="/images/hero/intro02-640w.webp 640w, /images/hero/intro02-828w.webp 828w, /images/hero/intro02-1280w.webp 1280w, /images/hero/intro02-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro03-1280w.webp"
          srcset="/images/hero/intro03-640w.webp 640w, /images/hero/intro03-828w.webp 828w, /images/hero/intro03-1280w.webp 1280w, /images/hero/intro03-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro04-1280w.webp"
          srcset="/images/hero/intro04-640w.webp 640w, /images/hero/intro04-828w.webp 828w, /images/hero/intro04-1280w.webp 1280w, /images/hero/intro04-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro05-1280w.webp"
          srcset="/images/hero/intro05-640w.webp 640w, /images/hero/intro05-828w.webp 828w, /images/hero/intro05-1280w.webp 1280w, /images/hero/intro05-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro06-1280w.webp"
          srcset="/images/hero/intro06-640w.webp 640w, /images/hero/intro06-828w.webp 828w, /images/hero/intro06-1280w.webp 1280w, /images/hero/intro06-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro07-1280w.webp"
          srcset="/images/hero/intro07-640w.webp 640w, /images/hero/intro07-828w.webp 828w, /images/hero/intro07-1280w.webp 1280w, /images/hero/intro07-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro08-1280w.webp"
          srcset="/images/hero/intro08-640w.webp 640w, /images/hero/intro08-828w.webp 828w, /images/hero/intro08-1280w.webp 1280w, /images/hero/intro08-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro09-1280w.webp"
          srcset="/images/hero/intro09-640w.webp 640w, /images/hero/intro09-828w.webp 828w, /images/hero/intro09-1280w.webp 1280w, /images/hero/intro09-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro10-1280w.webp"
          srcset="/images/hero/intro10-640w.webp 640w, /images/hero/intro10-828w.webp 828w, /images/hero/intro10-1280w.webp 1280w, /images/hero/intro10-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro11-1280w.webp"
          srcset="/images/hero/intro11-640w.webp 640w, /images/hero/intro11-828w.webp 828w, /images/hero/intro11-1280w.webp 1280w, /images/hero/intro11-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro12-1280w.webp"
          srcset="/images/hero/intro12-640w.webp 640w, /images/hero/intro12-828w.webp 828w, /images/hero/intro12-1280w.webp 1280w, /images/hero/intro12-2560w.webp 2560w"
          sizes="100vw"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro13-1280w.webp"
          srcset="/images/hero/intro13-640w.webp 640w, /images/hero/intro13-828w.webp 828w, /images/hero/intro13-1280w.webp 1280w, /images/hero/intro13-2560w.webp 2560w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
        <img
          src="/images/hero/intro14-1280w.webp"
          srcset="/images/hero/intro14-640w.webp 640w, /images/hero/intro14-828w.webp 828w, /images/hero/intro14-1280w.webp 1280w"
          sizes="100vw"
          data-align="center"
          class="flash-img" loading="lazy" decoding="async" />
      </div>

      <!-- Moon (tracker) -->
      <div class="moon"></div>

      <!-- Text -->
      <div class="container" id="textContainer">
        <p class="home-text">C-STUDIOS</p>
        <p class="sub-text" id="subText"><span class="line">IS A CREATIVE STRATEGY </span><span class="line">AND A CURATORIAL STUDIO.</span></p>
      </div>

      <!-- Inverted mask (SVG <mask> + animated <circle>). With moon scale
           3.0 the hole edge is off-screen by the time the slideshow is
           revealed, so we don't need the Gaussian blur softening (that
           filter was the main per-frame cost on mobile GPUs). -->
      <svg id="revealHole" class="reveal-hole" aria-hidden="true">
        <defs>
          <mask id="moonHoleMask" maskUnits="userSpaceOnUse">
            <rect width="100%" height="100%" fill="white"></rect>
            <circle id="moonHoleCircle" cx="0" cy="0" r="0" fill="black"></circle>
          </mask>
        </defs>
        <rect width="100%" height="100%" fill="white" mask="url(#moonHoleMask)"></rect>
      </svg>
      <div id="holeRim" class="hole-rim" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- SERVICES                                                      -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="services" class="services-section">
    <div class="services-tabs">
      {services.map((tab, i) => (
        <button
          class:list={["services-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {services.map((tab, i) => (
      <div class:list={["services-panel", { active: i === 0 }]} data-tab={tab.slug}>
        <div class="services-images" style={`grid-template-columns: repeat(${tab.columns.length}, 1fr)`}>
          {tab.columns.map(col => (
            <img
              src={`/images/services/${col.image}-1280w.webp`}
              srcset={`/images/services/${col.image}-640w.webp 640w, /images/services/${col.image}-828w.webp 828w, /images/services/${col.image}-1280w.webp 1280w, /images/services/${col.image}-2560w.webp 2560w`}
              sizes="25vw"
              alt={col.alt}
              data-align={col.align}
              loading="lazy" />
          ))}
        </div>
        {(() => {
          const textCols = tab.columns.filter(c => c.category || c.services.length > 0);
          return (
            <div class="services-texts" style={`grid-template-columns: repeat(${textCols.length}, 1fr)`}>
              {textCols.map(col => (
                <div class="services-column">
                  {col.category && <div class="services-category">[ {col.category} ]</div>}
                  {col.services.length > 0 && (
                    <ul class="services-list">
                      {col.services.map(s => <li>{s}</li>)}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          );
        })()}
      </div>
    ))}
  </section>



  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- CLIENTS — two-row marquee, opposite directions                -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="clients" class="clients-section">
    <!-- Top row — scrolls left → right. 4x duplication keeps the track
         wider than 2x viewport so no blank slot appears during translate.
         eager loading prevents off-screen logos from popping in mid-scroll. -->
    <div class="marquee">
      <div
        class="marquee-track marquee-right"
        style={`animation-duration: ${clients.row1.length * 5.5 * 2}s`}>
        {[...clients.row1, ...clients.row1, ...clients.row1, ...clients.row1].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="eager" />
        ))}
      </div>
    </div>
    <!-- Bottom row — scrolls right → left -->
    <div class="marquee">
      <div
        class="marquee-track marquee-left"
        style={`animation-duration: ${clients.row2.length * 5.5 * 2}s`}>
        {[...clients.row2, ...clients.row2, ...clients.row2, ...clients.row2].map((slug) => (
          <img src={`/images/clients/${slug}.webp`} alt={slug} loading="eager" />
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- PROJECTS — tabs + expandable rows with image strip            -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section id="projects" class="projects-section">
    <div class="projects-tabs">
      {projectsData.map((tab, i) => (
        <button
          class:list={["projects-tab", { active: i === 0 }]}
          data-target={tab.slug}>
          {tab.name}
        </button>
      ))}
    </div>

    {projectsData.map((tab, i) => (
      <div class:list={["projects-panel", { active: i === 0 }]} data-tab={tab.slug}>
        {tab.projects.length === 0 ? (
          <div class="projects-empty">No projects to show in this category yet.</div>
        ) : (
          <div class="projects-list">
            {tab.projects.map((project) => (
              <div class="project-row">
                <button class="project-summary" type="button">
                  <span class="project-title">{project.title.toUpperCase()}</span>
                  <span class="project-year">{project.year}</span>
                  <span class="project-description">{project.description}</span>
                </button>
                {project.images.length > 0 && (
                  <div class="project-images" data-scrubber>
                    {project.images.map((img) => {
                      const stem = img.replace(/\.[^.]+$/, '');
                      return (
                        <img
                          src={`${stem}-1280w.webp`}
                          srcset={`${stem}-640w.webp 640w, ${stem}-828w.webp 828w, ${stem}-1280w.webp 1280w, ${stem}-2560w.webp 2560w`}
                          sizes="(max-width: 768px) 90vw, 60vw"
                          alt={project.title}
                          loading="lazy" />
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    ))}
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- INFO (placeholder)                                            -->
  <!-- ════════════════════════════════════════════════════════════ -->
<section id="info" class="info-section">
  <div class="info-wrap">
    <div class="info-body">
      <p class="info-paragraph">
        C-STUDIOS is a collective of cross-disciplinary translators — from strategists, researchers, and artists to academics, designers, and creative practitioners — operating across diverse industry sectors and artistic disciplines.
      </p>
      <p class="info-paragraph">
        Together, we move fluidly between strategy, curation, research to develop effective solutions, narratives, and experiences for brands, labels, artists, institutions, and beyond.
      </p>
    </div>
    <div class="info-venn">
      <div class="venn-stage">
        <svg class="venn-svg" viewBox="172 32 456 336" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          <circle class="venn-circle venn-circle-left"  cx="340" cy="200" r="160" />
          <circle class="venn-circle venn-circle-right" cx="460" cy="200" r="160" />
          <image class="venn-c-logo" href="/images/brand/c-studios-logo.png"
                 x="376" y="184.3" width="48" height="34.4"
                 preserveAspectRatio="xMidYMid meet" />
        </svg>
        <span class="venn-label venn-label-left">Strategy</span>
        <span class="venn-label venn-label-right">Curation</span>
      </div>
    </div>
    <div class="venn-captions">
      <p class="venn-text venn-text-left">
        How we translate interdisciplinary research and insight into effective creative industry solutions.
      </p>
      <p class="venn-text venn-text-right">
        How we test and expand ideas by connecting people through cultural production and collective care.
      </p>
    </div>
  </div>
</section>

</Layout>

<!-- ════════════════════════════════════════════════════════════ -->
<!-- HERO SCRIPT (moon, slideshow, text animation)                 -->
<!-- ════════════════════════════════════════════════════════════ -->
<script is:inline>
function prepareMobileSubtextEarly() {
  const isPhone = window.matchMedia('(max-width: 767px)').matches;
  if (!isPhone) return;
  const sub = document.getElementById('subText');
  if (!sub) return;
  sub.innerHTML =
    '<span class="line">IS A CREATIVE STRATEGY </span>' +
    '<span class="line">AND A CURATORIAL STUDIO.</span>';
  // On revisits the intro is skipped, so leave the sub-text in its
  // resting visible state instead of hiding it for the slide-in.
  if (__cstWasIntroSeen) {
    sub.style.opacity = '1';
    sub.style.transform = 'translateX(0)';
    sub.style.visibility = 'visible';
    return;
  }
  sub.style.opacity = '0';
  sub.style.transform = 'translateX(140vw)';
  sub.style.visibility = 'hidden';
}

function swapMobileImages() {
  if (!window.matchMedia('(max-width: 767px)').matches) return;
  const mobileUrls = [];
  document.querySelectorAll('#flashSequence .flash-img').forEach(img => {
    const m = img.getAttribute('data-mobile');
    if (m && img.src !== m) {
      mobileUrls.push(m);
      img.src = m;
      img.loading = 'eager';
    }
  });
  mobileUrls.slice(0, 3).forEach(url => {
    const preloadImg = new Image();
    preloadImg.src = url;
  });
}

function setRealVH() {
  const vh = window.innerHeight * 0.01;
  document.documentElement.style.setProperty('--vh', `${vh}px`);
  if (window.innerWidth <= 767) {
    document.body.style.overflow = 'hidden';
  }
}

function syncHoleToMoon(durationMs = 5000) {
  const moon = document.querySelector('.moon');
  const circle = document.getElementById('moonHoleCircle');
  const rim = document.getElementById('holeRim');
  if (!moon || !circle || !rim) return;
  let start = performance.now();
  function tick(now) {
    const r = moon.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    const cy = r.top + r.height / 2;
    const radius = r.width / 2;
    // SVG attribute updates are dramatically cheaper than recomputing a
    // CSS radial-gradient mask every frame.
    circle.setAttribute('cx', cx);
    circle.setAttribute('cy', cy);
    circle.setAttribute('r', radius);
    rim.style.width = r.width + 'px';
    rim.style.height = r.height + 'px';
    rim.style.left = (cx - radius) + 'px';
    rim.style.top = (cy - radius) + 'px';
    if (now - start < durationMs) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
window.scrollTo(0, 0);

// Capture whether this is a first-time view BEFORE we set the flag. The
// late check (`introSeen` inside the setTimeout below) uses this captured
// value so the very first page load still plays the moon + text intro.
var __cstWasIntroSeen = false;
try { __cstWasIntroSeen = sessionStorage.getItem('cst-intro-seen') === 'true'; } catch (e) {}
// Mark intro as seen immediately so a mid-intro navigation away (e.g.
// home → library before the moon finishes) still skips the intro when the
// user returns. Layout.astro reads this flag synchronously on the next
// load and adds `body.skip-intro` before any CSS animation can replay.
try { sessionStorage.setItem('cst-intro-seen', 'true'); } catch (e) {}

function startSlideshow(skipFirstFade = false) {
  const images = document.querySelectorAll('#flashSequence .flash-img');
  if (!images.length) return;
  images.forEach((img, index) => {
    const isMobile = window.innerWidth <= 767;
    const heightValue = isMobile ? 'calc(var(--vh) * 100)' : '100vh';
    // Per-slide overrides indexed into the current slideshow order (see #flashSequence).
    // After the 2026-05 reorder these indices map to: 3 = old intro01, 4 = old intro06, 11 = old intro10.
    let objectPosition;
if (isMobile && (index === 3 || index === 4)) {
  objectPosition = 'left center';
} else if (!isMobile && (index === 3 || index === 4 || index === 11)) {
  objectPosition = 'center top';
} else {
  objectPosition = 'center center';
}
    // On revisits the first image should appear instantly (no 1.2s fade)
    // so reload doesn't flash a white screen before the slideshow shows.
    const instantThis = skipFirstFade && index === 0;
    img.style.cssText += `
      opacity: ${instantThis ? '1' : '0'} !important;
      transition: ${instantThis ? 'none' : 'opacity 1.2s ease-in-out'} !important;
      z-index: ${instantThis ? '1' : '0'} !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100vw !important;
      height: ${heightValue} !important;
      object-fit: cover !important;
      object-position: ${objectPosition} !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100vw !important;
      min-height: ${heightValue} !important;
      transform: scale(1) !important;
    `;
  });

  let current = 0;
  if (skipFirstFade) {
    images[current].classList.add('active');
    // Restore the crossfade transition after one paint so the next slide
    // still transitions normally.
    requestAnimationFrame(() => requestAnimationFrame(() => {
      images[current].style.cssText += 'transition: opacity 1.2s ease-in-out !important;';
    }));
  } else {
    images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
    images[current].classList.add('active');
  }

  setInterval(() => {
    const prev = current;
    current = (current + 1) % images.length;
    images[current].style.cssText += 'opacity: 1 !important; z-index: 1 !important;';
    images[current].classList.add('active');
    setTimeout(() => {
      images[prev].style.cssText += 'opacity: 0 !important; z-index: 0 !important;';
      images[prev].classList.remove('active');
    }, 600);
  }, 1200);
}

// Skip-intro path runs synchronously (no 100ms setTimeout) so reloads on
// mobile don't flash white before the slideshow appears. The intro path
// keeps the 100ms delay because it needs layout to settle before measuring
// the moon's starting position.
if (__cstWasIntroSeen) {
  prepareMobileSubtextEarly();
  swapMobileImages();
  setRealVH();
  const _m = document.querySelector('.moon');
  if (_m) _m.style.display = 'none';
  const _h = document.getElementById('revealHole');
  if (_h) _h.style.display = 'none';
  const _r = document.getElementById('holeRim');
  if (_r) _r.style.display = 'none';
  const _hero = document.getElementById('cstHero');
  if (_hero) _hero.style.backgroundColor = 'transparent';
  // Snap the desktop text container + its children straight to the centred
  // resting state with no transitions or animations. Inline-style overrides
  // win over any cached/specificity edge cases.
  const _tc = document.getElementById('textContainer');
  if (_tc && window.innerWidth >= 768) {
    _tc.style.transition = 'none';
    _tc.style.left = '50%';
    _tc.style.transform = 'translate(-50%, -50%)';
    _tc.classList.add('text-centered');
    const _ht = _tc.querySelector('.home-text');
    if (_ht) {
      _ht.style.animation = 'none';
      _ht.style.transition = 'none';
      _ht.style.transform = 'translateX(0)';
      _ht.style.opacity = '1';
    }
    const _st = _tc.querySelector('.sub-text');
    if (_st) {
      _st.style.animation = 'none';
      _st.style.transition = 'none';
      _st.style.transform = 'translateX(0)';
      _st.style.opacity = '1';
    }
  }
  if (window.innerWidth <= 767) {
    const _sub = document.getElementById('subText');
    if (_sub) {
      _sub.style.visibility = 'visible';
      _sub.style.opacity = '1';
      _sub.style.transform = 'translateX(0)';
    }
  }
  startSlideshow(true);
}

// Main intro animation — only on first visit (skip-intro path above already returned)
setTimeout(() => {
  if (__cstWasIntroSeen) return;
  prepareMobileSubtextEarly();
  swapMobileImages();
  setRealVH();

  const moon = document.querySelector('.moon');
  if (!moon) return;

  syncHoleToMoon(2800);

  const overhangRatio = (window.innerWidth <= 767) ? 0.45 : 0.10;
  const r0 = moon.getBoundingClientRect();
  const overhangPx = r0.width * overhangRatio;
  moon.style.transform = `translateY(-50%) translateX(${-(r0.width - overhangPx)}px)`;

  moon.addEventListener('transitionend', function onMoonSlideEnd(e) {
    if (e.propertyName !== 'transform') return;
    moon.removeEventListener('transitionend', onMoonSlideEnd);

    // Moon arrives at slide-end together with the texts; the centre-move
    // and expand fire on the same frame, no setTimeout pause.
    moon.style.transition = 'transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease-in';
    // Mobile uses a smaller final scale: the composited layer is dramatically
    // smaller (2.5² vs 3.0² = ~30% less area), which reduces GPU work on
    // mid-range phones. Scale 2.5 still puts the hole's edge off every
    // viewport corner on typical phone aspect ratios.
    const _finalScale = window.innerWidth <= 767 ? 2.5 : 3.0;
    moon.style.transform = `translateY(-50%) translateX(-72vw) scale(${_finalScale})`;

    if (window.innerWidth >= 768) {
      const container = document.getElementById('textContainer');
      if (container) container.classList.add('text-centered');
    }
    // Start the slideshow + fade the mask out partway through the expand.
    // With scale 3.0 the moon hole is past every viewport corner well
    // before the transition completes, so 700ms in we can reveal the
    // slideshow with the boundary already off-screen.
    setTimeout(() => {
      startSlideshow();
      const hole = document.getElementById('revealHole');
      const rim = document.getElementById('holeRim');
      if (hole) hole.style.opacity = '0';
      if (rim) rim.style.opacity = '0';
      const hero = document.getElementById('cstHero');
      if (hero) hero.style.backgroundColor = 'transparent';
    }, 700);
  });

  // Mobile subText slide-in — runs parallel to the moon, kicks off
  // partway through so it lands at the same time as the moon's expand.
  setTimeout(() => {
    if (window.innerWidth <= 767) {
      const sub = document.getElementById('subText');
      if (sub) {
        sub.style.visibility = 'visible';
        sub.style.transform = 'translateX(140vw)';
        sub.style.opacity = '0';
        sub.offsetHeight;
        sub.style.transition = 'transform 800ms cubic-bezier(0.22,1,0.36,1), opacity 800ms ease-out';
        sub.style.transform = 'translate3d(0,0,0)';
        sub.style.opacity = '1';
      }
    }
  }, 1500);

}, 100);

document.addEventListener('DOMContentLoaded', () => {
  if (window.innerWidth < 768) return;
  if (!__cstWasIntroSeen) return;
  // Revisit: apply the centred state immediately so the container doesn't
  // get stranded at its off-screen start position. On a fresh intro the
  // moon's slide-end transitionend handler adds the class instead, in sync
  // with the moon expanding.
  const container = document.getElementById('textContainer');
  if (container) container.classList.add('text-centered');
});

// ════════════════════════════════════════════════════════════
// PROJECTS — tab switching + expandable rows
// ════════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  // Tab switching
  const pTabs = document.querySelectorAll('.projects-tab');
  const pPanels = document.querySelectorAll('.projects-panel');
  pTabs.forEach((tab) => {
    tab.onclick = () => {
      const tabsEl = tab.parentElement;
      // Mobile dropdown: first tap on the active (visible) tab opens the
      // menu without switching; any subsequent tap closes the menu and
      // proceeds with the normal switch.
      if (window.innerWidth <= 768) {
        if (!tabsEl.classList.contains('open')) {
          tabsEl.classList.add('open');
          return;
        }
        tabsEl.classList.remove('open');
      }
      const target = tab.getAttribute('data-target');
      pTabs.forEach((t) => t.classList.toggle('active', t === tab));
      refreshTabIndices(tabsEl);
      // Collapse any expanded rows across all panels before switching, so a
      // new tab always starts with everything closed.
      document.querySelectorAll('.project-row.expanded').forEach((r) => r.classList.remove('expanded'));
      pPanels.forEach((p) => {
        p.classList.remove('active');
        void p.offsetWidth;
        if (p.getAttribute('data-tab') === target) {
          p.classList.add('active');
          // Reset internal scroll so the new tab opens at the top
          // regardless of where the previous tab was scrolled to.
          p.scrollTop = 0;
        }
      });
    };
  });

  // Row expand / collapse on click of the summary button
  document.querySelectorAll('.project-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.project-row');
      if (!row) return;
      const willOpen = !row.classList.contains('expanded');
      // Close any other open rows in the same panel
      row.parentElement?.querySelectorAll('.project-row.expanded').forEach((r) => {
        if (r !== row) r.classList.remove('expanded');
      });
      row.classList.toggle('expanded', willOpen);
      // After the row expands, scroll the panel so the row's top edge
      // sits at the panel's content top. Aligning to the tabs' bottom
      // would over-scroll past the panel's visible bounds (panel.top
      // is below the tabs by the section padding + tab margin).
      if (willOpen) {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const panel = row.closest('.projects-panel');
          if (!panel) return;
          // Leave headroom so the row's top border is clearly visible
          // inside the panel — landing exactly at panel.top makes the 1px
          // line read as clipped. Web wants a wider peek (~20px) for the
          // divider; mobile already aligns cleanly with a small buffer.
          const isMobile = window.innerWidth < 769;
          const HEADROOM = isMobile ? 0 : 20;
          const offset = row.getBoundingClientRect().top - panel.getBoundingClientRect().top - HEADROOM;
          if (Math.abs(offset) < 2) return;
          const maxScroll = Math.max(0, panel.scrollHeight - panel.clientHeight);
          const target = Math.max(0, Math.min(maxScroll, panel.scrollTop + offset));
          if (isMobile) {
            // iOS Safari is unreliable with scrollTo({behavior:'smooth'}) on
            // -webkit-overflow-scrolling: touch containers — sometimes it
            // does nothing. Animate manually so the row always lands at
            // the panel's content top.
            const startTop = panel.scrollTop;
            const duration = 400;
            const t0 = performance.now();
            function step(now) {
              const p = Math.min(1, (now - t0) / duration);
              const ease = 1 - Math.pow(1 - p, 3);    // ease-out cubic
              panel.scrollTop = startTop + (target - startTop) * ease;
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          } else {
            panel.scrollTo({ top: target, behavior: 'smooth' });
          }
        }));
      }
    });
  });
});

function initProjectImageAutoScroll() {
  // Constant pixel-per-second speed — same on web and mobile, independent
  // of refresh rate and image count.
  const SPEED_PX_PER_SEC = 90;

  document.querySelectorAll('.project-row').forEach(row => {
    const strip = row.querySelector('.project-images');
    if (!strip) return;

    let direction = 1;
    let isPaused = false;
    let resumeTimer;
    let lastTs = 0;

    // Pause at each end before reversing — gives the eye a moment to land
    // on the last/first image before the strip starts scrubbing back.
    const END_PAUSE_MS = 1000;
    let endPauseUntil = 0;

    function tick(ts) {
      // Reset the timestamp baseline whenever the row isn't actively
      // scrolling (collapsed or paused). Otherwise lastTs lingers from a
      // previous expansion and the first frame after re-opening has a huge
      // dt — the strip leaps to one boundary and "stops".
      const expanded = row.classList.contains('expanded');
      if (!expanded || isPaused) {
        lastTs = 0;
        requestAnimationFrame(tick);
        return;
      }
      // Holding at an end — wait, don't accumulate dt.
      if (ts < endPauseUntil) {
        lastTs = ts;
        requestAnimationFrame(tick);
        return;
      }
      const dt = lastTs ? (ts - lastTs) / 1000 : 0;
      lastTs = ts;

      const max = strip.scrollWidth - strip.clientWidth;
      if (max > 0) {
        const current = strip.scrollLeft;
        let next = current + (direction * SPEED_PX_PER_SEC * dt);
        // Only trigger the end-pause when we actually CROSS the boundary
        // this frame (current < max → next >= max). Without the `current`
        // check, frame 1 has dt = 0 → next = current = 0, which fires the
        // left-end pause immediately and the strip never starts moving.
        if (next >= max && current < max) {
          direction = -1; next = max; endPauseUntil = ts + END_PAUSE_MS;
        } else if (next <= 0 && current > 0) {
          direction = 1; next = 0; endPauseUntil = ts + END_PAUSE_MS;
        } else {
          next = Math.max(0, Math.min(max, next));
        }
        strip.scrollLeft = next;
      }
      requestAnimationFrame(tick);
    }

    function pauseTemp(delay = 1500) {
      isPaused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { isPaused = false; }, delay);
    }

    // Only attach hover-pause on devices that actually have a hover-capable
    // pointer (desktop mice / trackpads). iOS Safari synthesises mouseenter
    // on tap and on stray pointer movements during panel scroll — both
    // would stick `isPaused = true` indefinitely (mouseleave never fires
    // on touch), so the autoscroll silently froze on mobile.
    const hasHover = window.matchMedia('(hover: hover)').matches;
    if (hasHover) {
      strip.addEventListener('mouseenter', () => { isPaused = true; });
      strip.addEventListener('mouseleave', () => pauseTemp(800));
      const scrubber = strip.nextElementSibling;
      if (scrubber && scrubber.classList.contains('scrubber')) {
        scrubber.addEventListener('mouseenter', () => { isPaused = true; });
        scrubber.addEventListener('mouseleave', () => pauseTemp(800));
      }
    }

    // Only pause on touch if the user is ACTUALLY dragging the strip
    // (moves > 6px). Mobile Safari fires synthetic mouseenter on tap +
    // touchstart fires every time the user scrolls the project panel
    // vertically — both used to stick `isPaused = true` even though the
    // user never interacted with the strip itself.
    let touchStartedX = 0, touchStartedY = 0, touchActive = false;
    strip.addEventListener('touchstart', (e) => {
      touchStartedX = e.touches[0].clientX;
      touchStartedY = e.touches[0].clientY;
      touchActive = false;
    }, { passive: true });
    strip.addEventListener('touchmove', (e) => {
      if (touchActive) return;
      const dx = Math.abs(e.touches[0].clientX - touchStartedX);
      const dy = Math.abs(e.touches[0].clientY - touchStartedY);
      // Treat horizontal drag as a real scrub; vertical drag is the panel
      // scrolling — leave the autoscroll alone.
      if (dx > 6 && dx > dy) { touchActive = true; isPaused = true; }
    }, { passive: true });
    strip.addEventListener('touchend', () => {
      if (touchActive) pauseTemp(2000);
      touchActive = false;
    }, { passive: true });
    strip.addEventListener('wheel', () => pauseTemp(1500), { passive: true });

    // Failsafe: whenever the row is collapsed, clear any sticky pause
    // state so re-opening always restarts cleanly.
    const obs = new MutationObserver(() => {
      if (!row.classList.contains('expanded')) {
        isPaused = false;
        endPauseUntil = 0;
        clearTimeout(resumeTimer);
      }
    });
    obs.observe(row, { attributes: true, attributeFilter: ['class'] });

    requestAnimationFrame(tick);
  });
}

if (document.readyState === 'complete' || document.readyState === 'interactive') {
  initProjectImageAutoScroll();
} else {
  document.addEventListener('DOMContentLoaded', initProjectImageAutoScroll);
}
